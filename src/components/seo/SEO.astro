---
/**
 * Komponen SEO — MA Margajaya
 * Mengatur semua tag <head> penting untuk SEO, Open Graph, Twitter Card,
 * dan data terstruktur (JSON-LD) sesuai standar Google.
 *
 * Props:
 *   title         — Judul halaman (wajib diisi unik per halaman)
 *   description   — Deskripsi halaman (140-160 karakter)
 *   image         — URL absolut gambar OG (opsional, fallback ke logo sekolah)
 *   type          — Jenis halaman: 'website' (default) atau 'article' (berita)
 *   publishedTime — Tanggal terbit ISO 8601 (khusus type='article')
 *   author        — Nama penulis (khusus type='article')
 */
import { schoolConfig } from '../../config/school.config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  author?: string;
  breadcrumbs?: { label: string; href: string }[];
}

const {
  title = schoolConfig.name,
  description = schoolConfig.description,
  image,
  type = 'website',
  publishedTime,
  author = 'Humas MA Margajaya',
  breadcrumbs,
} = Astro.props;

// Canonical URL menggunakan Astro.site (diset di astro.config.mjs)
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.mamargajaya.sch.id';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);

// Format judul: jika judul sudah memuat nama madrasah (seperti di Beranda), jangan duplikat
const fullTitle =
  title === schoolConfig.name || title.includes(schoolConfig.name) || title.startsWith('MA Margajaya')
    ? title
    : `${title} | ${schoolConfig.name}`;

// Gambar OG: gunakan gambar yang diberikan, atau fallback ke og-default.png (1200x630 banner)
const ogImage = image
  ? (image.startsWith('http') ? image : `${siteUrl}${image}`)
  : `${siteUrl}/og-default.png`;

// Data JSON-LD EducationalOrganization (dipakai di semua halaman)
const jsonLdOrganization = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: 'Madrasah Aliyah Margajaya',
  alternateName: ['MA Margajaya', 'MA Margajaya Sukadana'],
  url: siteUrl,
  logo: `${siteUrl}${schoolConfig.logo}`,
  image: `${siteUrl}/images/opt/gedung-ma-margajaya.webp`,
  description: schoolConfig.description,
  identifier: {
    '@type': 'PropertyValue',
    name: 'NPSN',
    value: '69955696',
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Jln. Ciilat - Gardu Margajaya, Dusun Jontor RT 01/RW 04, Desa Margajaya',
    addressLocality: 'Sukadana',
    addressRegion: 'Jawa Barat',
    postalCode: '46272',
    addressCountry: 'ID',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: schoolConfig.phone,
    email: schoolConfig.email,
    contactType: 'customer service',
    availableLanguage: 'Indonesian',
  },
  sameAs: [
    schoolConfig.social.instagram,
    schoolConfig.social.facebook,
  ].filter(Boolean),
  foundingOrganization: {
    '@type': 'Organization',
    name: 'Majelis Pendidikan dan Pengajaran PUI Kabupaten Ciamis',
  },
};

// Data JSON-LD NewsArticle (hanya untuk halaman berita / type='article')
const jsonLdArticle = type === 'article' ? {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: title,
  description: description,
  image: ogImage,
  datePublished: publishedTime ?? new Date().toISOString(),
  dateModified: publishedTime ?? new Date().toISOString(),
  author: {
    '@type': 'Person',
    name: author,
  },
  publisher: {
    '@type': 'EducationalOrganization',
    name: 'Madrasah Aliyah Margajaya',
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}${schoolConfig.logo}`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL.toString(),
  },
  isAccessibleForFree: true,
  inLanguage: 'id',
} : null;

// Data JSON-LD BreadcrumbList (jika halaman memiliki remah roti / breadcrumbs)
const jsonLdBreadcrumb = breadcrumbs && breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Beranda',
      item: siteUrl,
    },
    ...breadcrumbs.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 2,
      name: item.label,
      item: item.href.startsWith('http') ? item.href : `${siteUrl}${item.href}`,
    })),
  ],
} : null;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="canonical" href={canonicalURL} />

<!-- Preconnect font (non-blocking) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<!--
  Font: Fraunces (serif headline) — sumbu ital+wght saja (tanpa opsz), subset latin
        Plus Jakarta Sans (sans-serif body) — bobot 300–800, subset latin
        Pinyon Script — editorial accent
-->
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Pinyon+Script&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600&display=swap"
/>
<!-- Preload LCP hero image di beranda -->
{canonicalURL.pathname === '/' && (
  <link rel="preload" as="image" href="/images/opt/hero-bg-2.webp" type="image/webp" fetchpriority="high" />
)}

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="author" content={author} />
<meta name="robots" content="index, follow" />
<meta name="language" content="Indonesian" />

<!-- Open Graph / Facebook -->
<meta property="og:site_name" content={schoolConfig.name} />
<meta property="og:locale" content="id_ID" />
<meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={fullTitle} />
{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{type === 'article' && (
  <meta property="article:author" content={author} />
)}
{type === 'article' && (
  <meta property="article:section" content="Warta Madrasah" />
)}

<!-- Twitter Card -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />

<!-- JSON-LD: EducationalOrganization (semua halaman) -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLdOrganization)} />

<!-- JSON-LD: NewsArticle (hanya halaman berita) -->
{jsonLdArticle && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdArticle)} />
)}

<!-- JSON-LD: BreadcrumbList (navigasi remah roti untuk cuplikan Google) -->
{jsonLdBreadcrumb && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} />
)}

