---
import Container from '../ui/Container.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import { gallery } from '../../data/gallery';
---

<section id="galeri-section" class="bg-paper py-24 border-b border-hair relative overflow-hidden" data-motion-section>
  <Container>
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6" data-motion-title>
      <SectionTitle 
        kicker="Galeri Singkat" 
        title="Jepretan"
        titleHighlight="kegiatan." 
        className="mb-0"
      />
      <a href="/galeri" class="glow-button text-xs font-bold tracking-[0.18em] uppercase text-blue hover:text-blue-deep transition-colors inline-flex items-center gap-1.5 py-1.5 px-3 rounded hover:bg-emerald-50">
        Buka galeri penuh &rarr;
      </a>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-5">
      {gallery.slice(0, 6).map((item) => (
        <a 
          href="/galeri" 
          class="block aspect-square overflow-hidden rounded-xl border border-hair glow-card glow-card-gold glow-hover-lift group relative"
          data-motion-item
        >
          <img 
            src={item.image} 
            alt={item.alt} 
            loading="lazy"
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
            <span class="text-xs font-semibold text-white tracking-wide truncate drop-shadow">{item.alt}</span>
          </div>
        </a>
      ))}
    </div>
  </Container>
</section>
