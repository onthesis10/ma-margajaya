---
import Container from '../ui/Container.astro';
import { fetchNewsArticles, formatIndonesianDate } from '../../lib/news';

const articles = await fetchNewsArticles();
const hero = articles.length > 0 ? articles[0] : null;
const recent = articles.length > 1 ? articles.slice(1, 3) : [];
---

<section id="berita-section" class="bg-white py-14 border-b border-hair relative overflow-hidden" data-motion-section>
  <Container>
    
    <!-- 1. HEADER BAR -->
    <div class="flex flex-wrap items-center justify-between border-b-2 border-ink pb-4 mb-10 gap-4" data-motion-title>
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span style="background:#b91c1c;color:#fff;" class="px-2.5 py-0.5 text-[10px] font-black uppercase tracking-widest pulse-glow rounded-full inline-block">
            HOT
          </span>
          <span class="text-xs font-bold uppercase tracking-widest text-emerald-800">
            Warta Resmi MA Margajaya
          </span>
        </div>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-blue-ink">
          Kabar &amp; Berita Madrasah
        </h2>
      </div>

      <a href="/berita" class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-emerald-800 hover:text-emerald-950 border-b border-emerald-800 pb-0.5 transition-colors">
        Lihat Semua Warta &rarr;
      </a>
    </div>

    {hero ? (
      <div class="space-y-16">
        
        <!-- 1. HEADLINE HERO (Berita Paling Baru / Terkini) -->
        <a 
          href={`/berita/${hero.slug}`}
          class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center cursor-pointer group pb-12 border-b-2 border-hair glow-card glow-card-emerald p-4 lg:p-6 rounded-2xl glow-hover-lift block"
        >
          <!-- Foto Besar dengan Frosted Badge -->
          <div class="lg:col-span-7 relative overflow-hidden border border-hair aspect-[16/10] bg-paper rounded-xl">
            {hero.url_foto ? (
              <img 
                src={hero.url_foto} 
                alt={hero.judul} 
                referrerpolicy="no-referrer" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
              />
            ) : (
              <div class="w-full h-full bg-gradient-to-br from-emerald-950 to-slate-900 flex items-center justify-center p-8 text-center text-white">
                <span class="font-serif text-3xl font-bold">MA Margajaya</span>
              </div>
            )}

            <!-- Frosted Glassmorphism Badge Humas -->
            <div 
              class="absolute bottom-4 left-4 p-4 sm:p-5 rounded-xl transition-all duration-300 group-hover:-translate-y-1"
              style="background: linear-gradient(135deg, rgba(255, 255, 255, 0.32) 0%, rgba(255, 255, 255, 0.08) 100%); backdrop-filter: blur(24px) saturate(180%); -webkit-backdrop-filter: blur(24px) saturate(180%); border: 1px solid rgba(255, 255, 255, 0.65); box-shadow: 0 12px 36px 0 rgba(0, 0, 0, 0.2), inset 0 1px 1px 0 rgba(255, 255, 255, 0.7);"
            >
              <div>
                <span class="text-xs sm:text-sm font-bold text-white tracking-tight drop-shadow-[0_1px_3px_rgba(0,0,0,0.6)]">
                  {hero.penulis || 'Warta Resmi Madrasah'}
                </span>
              </div>
              <div class="text-[10px] text-white/90 uppercase font-extrabold tracking-widest mt-1 drop-shadow-[0_1px_2px_rgba(0,0,0,0.5)]">
                HEADLINE UTAMA
              </div>
              <div class="text-xs font-bold text-cyan-200 mt-1.5 flex items-center gap-1.5 drop-shadow-[0_1px_2px_rgba(0,0,0,0.5)]">
                <svg class="w-3.5 h-3.5 text-cyan-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>{formatIndonesianDate(hero.tanggal)}</span>
              </div>
            </div>
          </div>

          <!-- Teks Headline Utama -->
          <div class="lg:col-span-5 space-y-4">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest border border-emerald-800 text-emerald-900 bg-emerald-50 rounded">
                Headline Terkini
              </span>
            </div>

            <h3 class="font-serif text-3xl sm:text-4xl lg:text-[38px] font-bold text-blue-ink leading-[1.18] group-hover:text-emerald-800 transition-colors">
              {hero.judul}
            </h3>

            <div class="space-y-3">
              <p class="text-sm text-ink-soft leading-relaxed line-clamp-3">
                {hero.isi}
              </p>
            </div>

            <div class="pt-2">
              <span class="glow-button inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-emerald-800 group-hover:text-emerald-950 border-b border-emerald-800 pb-0.5">
                Baca Artikel Lengkap &rarr;
              </span>
            </div>
          </div>
        </a>

        {recent.length > 0 && (
          <!-- 2. RECENT NEWS (Kartu Kabar Terhangat Selanjutnya) -->
          <div class="space-y-6">
            <div class="flex items-center justify-between pb-3 border-b-2 border-hair">
              <h3 class="text-xl sm:text-2xl font-bold text-blue-ink uppercase tracking-tight flex items-center gap-2">
                <span class="w-2 h-5 bg-emerald-800"></span>
                Kabar Terbaru &amp; Terhangat
              </h3>
              <span class="text-xs font-semibold text-ink-muted">Berita Terbaru</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {recent.map(item => (
                <a 
                  href={`/berita/${item.slug}`}
                  class="border border-hair bg-paper/50 hover:bg-white hover:border-emerald-800 transition-all cursor-pointer group flex flex-col justify-between overflow-hidden shadow-sm glow-card glow-card-emerald glow-hover-lift rounded-xl p-3 sm:p-4 block"
                >
                  {item.url_foto ? (
                    <div class="aspect-[16/10] overflow-hidden bg-paper rounded-lg border border-hair">
                      <img 
                        src={item.url_foto} 
                        alt={item.judul} 
                        referrerpolicy="no-referrer" 
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                      />
                    </div>
                  ) : (
                    <div class="aspect-[16/10] bg-gradient-to-br from-emerald-950 to-slate-900 flex items-center justify-center text-white font-bold text-sm rounded-lg">
                      MA Margajaya
                    </div>
                  )}

                  <div class="pt-4 flex-1 flex flex-col justify-between space-y-3">
                    <div class="space-y-2">
                      <div class="flex items-center gap-2 text-[10px] text-ink-muted">
                        <span class="font-bold text-emerald-800 uppercase px-1.5 py-0.5 bg-emerald-50 rounded">Warta</span>
                        <span>•</span>
                        <span>{formatIndonesianDate(item.tanggal)}</span>
                      </div>
                      <h4 class="font-serif text-lg font-bold text-blue-ink leading-snug group-hover:text-emerald-800 transition-colors line-clamp-2">
                        {item.judul}
                      </h4>
                      <p class="text-xs text-ink-soft leading-relaxed line-clamp-3">
                        {item.isi}
                      </p>
                    </div>
                    <div class="pt-3 border-t border-hair">
                      <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-800 group-hover:text-emerald-950 flex items-center gap-1">
                        Baca Berita &rarr;
                      </span>
                    </div>
                  </div>
                </a>
              ))}
            </div>

            <!-- Link ke halaman warta lengkap -->
            <div class="pt-6 flex justify-end">
              <a href="/berita" class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-emerald-800 hover:text-emerald-950 border-b border-emerald-800 pb-0.5 transition-colors">
                Buka Semua Warta &rarr;
              </a>
            </div>
          </div>
        )}

      </div>
    ) : (
      <div class="py-16 text-center text-ink-muted font-serif text-base">
        Belum ada warta yang diterbitkan.
      </div>
    )}

  </Container>
</section>
