---
import Container from '../ui/Container.astro';
import { schoolConfig } from '../../config/school.config';

// Koordinat MA Margajaya Sukadana, Ciamis
// Google Maps embed via search — no API key required
const searchEmbedUrl = `https://maps.google.com/maps?q=MA+Margajaya+Sukadana+Ciamis&output=embed&z=16&hl=id`;
---

<section id="kontak-section" class="bg-white border-t border-hair relative overflow-hidden" data-motion-section>
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 sm:gap-12 lg:gap-16 items-center py-14 sm:py-24">

      <!-- ══ SISI KIRI: GOOGLE MAPS EMBED PREMIUM ══ -->
      <div class="order-2 lg:order-1" data-motion-visual>

        <!-- Map Container with Lightweight Facade (loads interactive iframe on user interaction) -->
        <div id="map-facade-container" class="relative group rounded-2xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-500 border border-hair-strong bg-slate-900" style="aspect-ratio: 3/2;" data-map-url={searchEmbedUrl}>

          <!-- Static Map Preview Background -->
          <div id="map-static-bg" class="absolute inset-0 bg-[#e8ece9] flex flex-col items-center justify-center p-6 text-center cursor-pointer select-none">
            <!-- Stylized Map Pattern Grid -->
            <div class="absolute inset-0 opacity-25 pointer-events-none" style="background-image: radial-gradient(#087A35 1px, transparent 1px), radial-gradient(#087A35 1px, #e8ece9 1px); background-size: 24px 24px; background-position: 0 0, 12px 12px;"></div>
            
            <!-- Center Pin & CTA Badge -->
            <div class="relative z-10 flex flex-col items-center gap-3">
              <div class="w-14 h-14 rounded-full bg-emerald-800 text-white flex items-center justify-center shadow-xl transform group-hover:scale-110 transition-transform duration-300">
                <svg class="w-7 h-7 text-gold" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"/>
                </svg>
              </div>
              <div class="space-y-1">
                <div class="font-serif text-lg font-bold text-emerald-950">
                  Kampus MA Margajaya
                </div>
                <div class="text-xs text-slate-600 max-w-xs">
                  Sukadana · Kabupaten Ciamis, Jawa Barat
                </div>
              </div>
              <button
                type="button"
                id="btn-load-interactive-map"
                class="mt-2 inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider text-white bg-emerald-800 hover:bg-emerald-900 shadow-md transition-all group-hover:shadow-lg"
              >
                <span>Buka Peta Interaktif</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </button>
            </div>
          </div>

          <!-- Top-right floating badge — "Buka di Google Maps" -->
          <div class="absolute top-3 right-3 z-10 pointer-events-none">
            <a
              href={schoolConfig.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="pointer-events-auto inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-[11px] font-bold uppercase tracking-wider text-white shadow-lg transition-all duration-300 hover:scale-105 hover:shadow-[0_8px_24px_rgba(8,122,53,0.5)]"
              style="background: linear-gradient(135deg, #087A35 0%, #065c28 100%); backdrop-filter: blur(12px);"
            >
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"/>
              </svg>
              Buka Google Maps
              <svg class="w-3 h-3 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
          </div>

          <!-- Bottom left — coordinate/address pin chip -->
          <div class="absolute bottom-3 left-3 z-10 pointer-events-none">
            <div
              class="inline-flex items-center gap-2 px-3 py-2 rounded-xl text-[11px] font-semibold text-white/95 shadow-lg max-w-[240px]"
              style="background: rgba(4, 30, 20, 0.82); backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.18);"
            >
              <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"/>
              </svg>
              <span class="truncate">Sukadana, Kab. Ciamis · 46272</span>
            </div>
          </div>

          <!-- Subtle green corner accent glow -->
          <div class="absolute -bottom-6 -right-6 w-32 h-32 bg-emerald-500/20 rounded-full blur-2xl pointer-events-none group-hover:bg-emerald-500/35 transition-colors duration-500"></div>

        </div>

        <!-- Caption row -->
        <div class="text-[11px] text-ink-muted uppercase tracking-[0.18em] font-semibold mt-3 flex items-center justify-between px-1">
          <span class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
            </svg>
            Petunjuk Arah &amp; Navigasi
          </span>
          <a href={schoolConfig.mapsUrl} target="_blank" rel="noopener noreferrer" class="text-blue hover:text-emerald-700 font-bold transition-colors">
            Buka di Maps &rarr;
          </a>
        </div>

      </div>

      <!-- ══ SISI KANAN: INFO KONTAK ══ -->
      <div class="order-1 lg:order-2" data-motion-title>
        <div class="text-[11px] font-bold tracking-[0.22em] uppercase text-ink-muted mb-4">Lokasi &amp; Kontak</div>
        <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-[56px] leading-[1.05] tracking-[-0.02em] text-blue-ink mb-5 sm:mb-6">
          Kunjungi Kampus <br/>
          <em class="italic text-blue">MA Margajaya.</em>
        </h2>
        <p class="text-ink-soft text-[14.5px] leading-relaxed max-w-[480px] mb-10">
          Kunjungan silaturahmi, calon siswa santri, dan konsultasi pendaftaran dilayani setiap hari kerja. Anda dapat langsung mengunjungi lokasi melalui peta interaktif di samping.
        </p>

        <div class="flex flex-col space-y-1">
          <div class="grid grid-cols-[110px_1fr] gap-5 py-4 border-b border-hair glow-card glow-card-emerald px-3 rounded-lg hover:bg-emerald-50/50 transition-colors" data-motion-item>
            <div class="text-[11px] font-bold tracking-[0.22em] uppercase text-blue">Alamat</div>
            <div class="text-[14.5px] text-ink-soft leading-relaxed">
              <a href={schoolConfig.mapsUrl} target="_blank" rel="noopener noreferrer" class="hover:text-blue transition-colors group inline-flex items-start gap-1 font-medium">
                <span>{schoolConfig.address}, {schoolConfig.city} {schoolConfig.postalCode}</span>
                <span class="text-blue text-xs font-bold shrink-0 mt-0.5">&nearr;</span>
              </a>
            </div>
          </div>
          <div class="grid grid-cols-[110px_1fr] gap-5 py-4 border-b border-hair glow-card glow-card-emerald px-3 rounded-lg hover:bg-emerald-50/50 transition-colors" data-motion-item>
            <div class="text-[11px] font-bold tracking-[0.22em] uppercase text-blue">Telepon/WA</div>
            <div class="text-[14.5px] text-ink-soft leading-relaxed">
              <a href={`https://wa.me/${schoolConfig.whatsapp}`} target="_blank" rel="noopener noreferrer" class="hover:text-blue font-semibold">
                {schoolConfig.phone}
              </a>
            </div>
          </div>
          <div class="grid grid-cols-[110px_1fr] gap-5 py-4 border-b border-hair glow-card glow-card-emerald px-3 rounded-lg hover:bg-emerald-50/50 transition-colors" data-motion-item>
            <div class="text-[11px] font-bold tracking-[0.22em] uppercase text-blue">Surel</div>
            <div class="text-[14.5px] text-ink-soft leading-relaxed">
              <a href={`mailto:${schoolConfig.email}`} class="hover:text-blue font-semibold">
                {schoolConfig.email}
              </a>
            </div>
          </div>
          <div class="grid grid-cols-[110px_1fr] gap-5 py-4 border-b border-hair glow-card glow-card-emerald px-3 rounded-lg hover:bg-emerald-50/50 transition-colors" data-motion-item>
            <div class="text-[11px] font-bold tracking-[0.22em] uppercase text-blue">Media Sosial</div>
            <div class="flex flex-wrap items-center gap-2.5 text-xs font-semibold">
              <a href={schoolConfig.social.instagram} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-pink-50 text-pink-700 hover:bg-pink-100 border border-pink-200 transition-colors">
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" /></svg>
                <span>Instagram</span>
              </a>
              <a href={schoolConfig.social.facebook} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-100 border border-blue-200 transition-colors">
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                <span>Facebook</span>
              </a>
              <a href={schoolConfig.social.tiktok} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 text-slate-900 hover:bg-slate-200 border border-slate-300 transition-colors">
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
                <span>TikTok</span>
              </a>
            </div>
          </div>

          <!-- Quick action buttons -->
          <div class="flex flex-wrap gap-3 pt-6" data-motion-item>
            <a
              href={schoolConfig.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-3 bg-blue text-white text-xs font-bold uppercase tracking-wider rounded-xl hover:bg-emerald-800 shadow-md shadow-blue/20 hover:shadow-lg hover:shadow-blue/30 transition-all hover:scale-[1.02]"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"/>
              </svg>
              Petunjuk Arah
            </a>
            <a
              href={`https://wa.me/${schoolConfig.whatsapp}?text=Assalamu'alaikum, saya ingin bertanya tentang MA Margajaya.`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-3 text-xs font-bold uppercase tracking-wider rounded-xl border border-hair hover:bg-paper hover:border-emerald-700 hover:text-emerald-800 transition-all text-ink"
            >
              <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                <path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.555 4.116 1.528 5.845L.057 23.428c-.083.332.246.629.57.494l5.793-2.28A11.938 11.938 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.806 9.806 0 01-5.007-1.372l-.356-.212-3.694 1.453 1.481-3.602-.233-.371A9.818 9.818 0 012.182 12C2.182 6.567 6.567 2.182 12 2.182S21.818 6.567 21.818 12 17.433 21.818 12 21.818z"/>
              </svg>
              Chat WhatsApp
            </a>
          </div>
        </div>
      </div>

    </div>
  </Container>
</section>

<script>
  // Map Facade: muat iframe Google Maps hanya saat pengguna mengklik tombol
  const container = document.getElementById('map-facade-container');
  const staticBg = document.getElementById('map-static-bg');
  const btn = document.getElementById('btn-load-interactive-map');

  function loadInteractiveMap() {
    if (!container || !staticBg) return;
    const mapUrl = container.getAttribute('data-map-url');
    if (!mapUrl) return;

    // Buat iframe
    const iframe = document.createElement('iframe');
    iframe.src = mapUrl;
    iframe.title = 'Lokasi MA Margajaya di Google Maps';
    iframe.width = '100%';
    iframe.height = '100%';
    iframe.loading = 'lazy';
    iframe.referrerPolicy = 'no-referrer-when-downgrade';
    iframe.setAttribute('allowfullscreen', '');
    iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;z-index:2;';

    // Hapus facade, tampilkan iframe
    staticBg.style.opacity = '0';
    staticBg.style.transition = 'opacity 0.4s ease';
    setTimeout(() => staticBg.remove(), 400);
    container.appendChild(iframe);

    // Lepas listener setelah sekali klik
    if (btn) btn.removeEventListener('click', loadInteractiveMap);
    if (staticBg) staticBg.removeEventListener('click', loadInteractiveMap);
  }

  if (btn) btn.addEventListener('click', loadInteractiveMap);
  if (staticBg) staticBg.addEventListener('click', loadInteractiveMap);
</script>
