---
import { schoolConfig } from '../../config/school.config';
import { navigation } from '../../config/navigation.config';
import Button from '../ui/Button.astro';

const currentPath = Astro.url.pathname;
---

<header id="main-header" class="fixed top-0 left-0 w-full z-50 text-white transition-all duration-500 bg-transparent border-b border-transparent">
  <!-- Topbar -->
  <div id="top-bar" class="hidden lg:flex justify-between items-center max-w-7xl mx-auto px-6 py-2 text-[11px] font-medium tracking-widest border-b border-white/15 text-white/80 transition-all duration-300">
    <div class="flex gap-4 items-center">
      <span class="inline-flex items-center gap-1.5 text-gold font-semibold">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z"></path></svg>
        Kemenag Kab. Ciamis
      </span>
      <span class="text-white/20">|</span>
      <span>Yayasan MPP PUI Ciamis</span>
      <span class="text-white/20">|</span>
      <span>Kompleks Ponpes Darul Muawanah</span>
    </div>
    <div class="flex gap-5 items-center uppercase">
      <span id="live-clock" class="text-gold font-bold tracking-wider">Jakarta (GMT+7) --:--:--</span>
      <span class="text-white/20">|</span>
      
      <!-- Social & Contact Icons -->
      <div class="flex items-center gap-4">
        <a href={schoolConfig.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-white/80 hover:text-gold transition-colors">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
          </svg>
        </a>
        <a href={`mailto:${schoolConfig.email}`} aria-label="Email" class="text-white/80 hover:text-gold transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </a>
        <a href={`https://wa.me/${schoolConfig.whatsapp}`} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="text-white/80 hover:text-gold transition-colors">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
        </a>
      </div>
      
      <span class="text-white/20">|</span>
      <div id="lang-switcher" class="flex gap-1 items-center font-bold text-xs">
        <button 
          id="lang-btn-id" 
          type="button" 
          aria-label="Bahasa Indonesia" 
          class="px-1.5 py-0.5 rounded transition-all text-gold font-bold hover:text-white"
        >
          ID
        </button>
        <span class="text-white/30">/</span>
        <button 
          id="lang-btn-en" 
          type="button" 
          aria-label="English Language" 
          class="px-1.5 py-0.5 rounded transition-all text-white/50 hover:text-white"
        >
          EN
        </button>
      </div>
    </div>
  </div>

  <!-- Main Navbar -->
  <div id="nav-container" class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between transition-all duration-300">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3.5 group shrink-0">
      <img src={schoolConfig.logo} alt={`Logo ${schoolConfig.name}`} class="h-12 w-auto object-contain drop-shadow transition-transform duration-300 group-hover:scale-105" />
      <div>
        <div class="font-bold text-[16px] tracking-wider text-white group-hover:text-gold transition-colors uppercase font-sans leading-tight">
          {schoolConfig.shortName}
        </div>
        <div class="text-[10px] text-white/70 uppercase tracking-[0.15em] font-medium mt-0.5">
          Sukadana — Ciamis
        </div>
      </div>
    </a>
    
    <!-- Tab Bar Links (Minimalist Floating Glass Dropdown, No Chevron, Clean & Subtle) -->
    <nav class="hidden lg:flex items-center gap-6 xl:gap-8 h-full">
      {navigation.map((item) => {
        const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
        const hasSub = item.subItems && item.subItems.length > 0;
        return (
          <div class="relative group/nav h-full flex items-center">
            
            <!-- Parent Link (Clean text glow, no background border pill) -->
            <a 
              href={item.href} 
              class={`py-1.5 px-2 text-[13.5px] tracking-wide transition-all duration-150 ${
                isActive 
                  ? 'text-gold font-bold drop-shadow-[0_0_12px_rgba(232,185,35,0.45)]' 
                  : 'text-white/85 hover:text-gold group-hover/nav:text-gold font-medium'
              }`}
            >
              {item.label}
            </a>

            <!-- Apple Dynamic Frosted Glass Dropdown (Translucent + 100% Legible on White) -->
            {hasSub && (
              <div class="dropdown-menu absolute top-[calc(100%-8px)] left-1/2 -translate-x-1/2 min-w-[205px] opacity-0 invisible -translate-y-1.5 pointer-events-none group-hover/nav:opacity-100 group-hover/nav:visible group-hover/nav:translate-y-0 group-hover/nav:pointer-events-auto transition-[opacity,transform] duration-150 ease-out z-50 pt-2 will-change-transform">
                <div 
                  class="rounded-2xl p-1.5 text-left"
                  style="background: rgba(6, 38, 25, 0.55); backdrop-filter: blur(32px) saturate(200%) brightness(0.85); -webkit-backdrop-filter: blur(32px) saturate(200%) brightness(0.85); border: 1px solid rgba(255, 255, 255, 0.25); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), inset 0 1px 1px 0 rgba(255, 255, 255, 0.4);"
                >
                  <div class="space-y-0.5">
                    {item.subItems?.map((sub) => (
                      <a 
                        href={sub.href}
                        class="flex items-center justify-between px-3 py-2 rounded-xl text-[12.5px] font-medium text-white drop-shadow-[0_1px_2px_rgba(0,0,0,0.8)] hover:bg-white/20 active:bg-white/30 transition-colors duration-100 group/sub"
                      >
                        <span class="group-hover/sub:translate-x-0.5 transition-transform duration-100">{sub.title}</span>
                        <span class="text-white/60 group-hover/sub:text-gold text-[11px] transition-colors duration-100 drop-shadow-none">&rsaquo;</span>
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            )}

          </div>
        );
      })}
    </nav>
    
    <!-- CTA Button -->
    <div class="hidden lg:block shrink-0">
      <Button href="/ppdb" variant="primary" size="sm" className="shadow-lg shadow-gold/20 font-semibold tracking-wider hover:shadow-[0_0_20px_rgba(232,185,35,0.4)]">
        DAFTAR PPDB &rarr;
      </Button>
    </div>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-btn" aria-label="Menu" class="lg:hidden p-2.5 rounded-lg bg-white/10 border border-white/15 text-white hover:bg-white/20 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
    </button>
  </div>

  <!-- Mobile Menu Panel -->
  <div id="mobile-menu-panel" class="hidden lg:hidden bg-[#062c1d]/95 backdrop-blur-2xl border-t border-white/15 absolute w-full left-0 top-full shadow-2xl transition-all max-h-[85vh] overflow-y-auto">
    <nav class="flex flex-col py-5 px-5 gap-1">
      {navigation.map((item) => {
        const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
        const hasSub = item.subItems && item.subItems.length > 0;
        return (
          <div class="py-1">
            <a 
              href={item.href} 
              class={`block text-[14px] font-medium py-1.5 px-3 rounded-md transition-colors ${
                isActive 
                  ? 'text-gold font-semibold' 
                  : 'text-white/90 hover:text-white'
              }`}
            >
              {item.label}
            </a>

            {hasSub && (
              <div class="pl-5 pr-2 py-1 space-y-0.5 border-l border-white/10 ml-3 mt-0.5">
                {item.subItems?.map((sub) => (
                  <a 
                    href={sub.href}
                    class="block py-1 px-2 text-[12px] text-white/70 hover:text-gold transition-colors"
                  >
                    {sub.title}
                  </a>
                ))}
              </div>
            )}
          </div>
        );
      })}

      <!-- Mobile Language Switcher -->
      <div class="flex items-center justify-between py-3 px-3 border-t border-white/10 mt-3">
        <span class="text-xs text-white/70">Pilih Bahasa / Language</span>
        <div class="flex gap-2">
          <button id="mobile-lang-id" class="px-2.5 py-1 text-xs rounded-lg bg-white/10 text-gold font-bold">ID</button>
          <button id="mobile-lang-en" class="px-2.5 py-1 text-xs rounded-lg bg-white/5 text-white/70 hover:text-white">EN</button>
        </div>
      </div>

      <div class="pt-3 border-t border-white/10 mt-1">
        <Button href="/ppdb" variant="primary" size="lg" className="w-full text-center justify-center shadow-lg">
          DAFTAR PPDB 2026/2027 &rarr;
        </Button>
      </div>
    </nav>
  </div>
</header>

<style is:global>
  .navbar-ios-glass {
    background: rgba(5, 34, 22, 0.60) !important;
    backdrop-filter: blur(28px) saturate(190%) brightness(1.05) !important;
    -webkit-backdrop-filter: blur(28px) saturate(190%) brightness(1.05) !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12) !important;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.35), inset 0 -0.5px 0 0 rgba(255, 255, 255, 0.1) !important;
  }
</style>

<div id="google_translate_element" style="display:none"></div>

<script>
  // Dynamic Navbar Scroll: Transparent at Top, Frosted Glass on Scroll
  const header = document.getElementById('main-header');
  const topBar = document.getElementById('top-bar');
  const navContainer = document.getElementById('nav-container');

  function handleScroll() {
    if (!header) return;
    if (window.scrollY > 20) {
      header.classList.add('navbar-ios-glass');
      header.classList.remove('bg-transparent', 'border-transparent');
      if (topBar) topBar.classList.add('opacity-0', 'h-0', 'overflow-hidden', 'py-0', 'border-b-0');
      if (navContainer) {
        navContainer.classList.add('h-[68px]');
        navContainer.classList.remove('h-20');
      }
    } else {
      header.classList.remove('navbar-ios-glass');
      header.classList.add('bg-transparent', 'border-transparent');
      if (topBar) topBar.classList.remove('opacity-0', 'h-0', 'overflow-hidden', 'py-0', 'border-b-0');
      if (navContainer) {
        navContainer.classList.add('h-20');
        navContainer.classList.remove('h-[68px]');
      }
    }
  }

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();

  // Mobile Menu Toggle
  const btn = document.getElementById('mobile-menu-btn');
  const panel = document.getElementById('mobile-menu-panel');
  
  if(btn && panel) {
    btn.addEventListener('click', () => {
      panel.classList.toggle('hidden');
    });
  }

  // Live Clock Logic
  function updateClock() {
    const clockElement = document.getElementById('live-clock');
    if (!clockElement) return;
    const now = new Date();
    try {
      const options: Intl.DateTimeFormatOptions = { 
        timeZone: 'Asia/Jakarta', 
        hour: '2-digit', 
        minute: '2-digit', 
        second: '2-digit', 
        hour12: false 
      };
      const timeString = new Intl.DateTimeFormat('id-ID', options).format(now);
      clockElement.textContent = `Jakarta (GMT+7) ${timeString.replace(/\./g, ':')}`;
    } catch(e) {
      clockElement.textContent = `Jakarta (GMT+7)`;
    }
  }
  setInterval(updateClock, 1000);
  updateClock();

  // ID / EN Language Toggle & Translator Integration
  function setLanguage(lang: 'id' | 'en') {
    localStorage.setItem('ma_lang', lang);
    updateLangUI(lang);

    document.cookie = `googtrans=/id/${lang}; path=/; domain=${window.location.hostname}`;
    document.cookie = `googtrans=/id/${lang}; path=/;`;

    const gElem = document.getElementById('google_translate_element');
    if (gElem) {
      const select = document.querySelector('.goog-te-combo') as HTMLSelectElement | null;
      if (select) {
        select.value = lang;
        select.dispatchEvent(new Event('change'));
      } else {
        window.location.reload();
      }
    }
  }

  function updateLangUI(lang: 'id' | 'en') {
    const btnId = document.getElementById('lang-btn-id');
    const btnEn = document.getElementById('lang-btn-en');
    const mBtnId = document.getElementById('mobile-lang-id');
    const mBtnEn = document.getElementById('mobile-lang-en');

    if (lang === 'en') {
      if (btnId) btnId.className = "px-1.5 py-0.5 rounded transition-all text-white/50 hover:text-white";
      if (btnEn) btnEn.className = "px-1.5 py-0.5 rounded transition-all text-gold font-bold hover:text-white";
      if (mBtnId) mBtnId.className = "px-2.5 py-1 text-xs rounded bg-white/5 text-white/70 hover:text-white";
      if (mBtnEn) mBtnEn.className = "px-2.5 py-1 text-xs rounded bg-white/10 text-gold font-bold";
    } else {
      if (btnId) btnId.className = "px-1.5 py-0.5 rounded transition-all text-gold font-bold hover:text-white";
      if (btnEn) btnEn.className = "px-1.5 py-0.5 rounded transition-all text-white/50 hover:text-white";
      if (mBtnId) mBtnId.className = "px-2.5 py-1 text-xs rounded bg-white/10 text-gold font-bold";
      if (mBtnEn) mBtnEn.className = "px-2.5 py-1 text-xs rounded bg-white/5 text-white/70 hover:text-white";
    }
  }

  document.getElementById('lang-btn-id')?.addEventListener('click', () => setLanguage('id'));
  document.getElementById('lang-btn-en')?.addEventListener('click', () => setLanguage('en'));
  document.getElementById('mobile-lang-id')?.addEventListener('click', () => setLanguage('id'));
  document.getElementById('mobile-lang-en')?.addEventListener('click', () => setLanguage('en'));

  const savedLang = (localStorage.getItem('ma_lang') as 'id' | 'en') || 'id';
  updateLangUI(savedLang);

  if (!document.getElementById('google-translate-script')) {
    const s = document.createElement('script');
    s.id = 'google-translate-script';
    s.src = '//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
    document.body.appendChild(s);

    (window as any).googleTranslateElementInit = function() {
      new (window as any).google.translate.TranslateElement({
        pageLanguage: 'id',
        includedLanguages: 'id,en',
        autoDisplay: false
      }, 'google_translate_element');
    };
  }
</script>
