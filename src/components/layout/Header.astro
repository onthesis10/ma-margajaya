<style is:global>
  /* ═══════════════════════════════════════════════════════════
     HEADER TWO-MODE SYSTEM: TOP (MODE 1) & FLOATING GLASS (MODE 2)
     ═══════════════════════════════════════════════════════════ */

  /* ── Mode 1: Top Bar ── */
  #top-bar {
    max-height: 48px;
    opacity: 1;
    overflow: visible;
    transition: max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1), 
                opacity 0.25s ease, 
                padding 0.35s ease, 
                margin 0.35s ease, 
                border-color 0.25s ease;
  }

  /* Mode 2: Top Bar collapses completely and seamlessly */
  #main-header[data-floating="true"] #top-bar {
    max-height: 0;
    opacity: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-top: 0;
    margin-bottom: 0;
    border-bottom-color: transparent;
    overflow: hidden;
    pointer-events: none;
  }

  /* ── Nav Container Base (Mode 1: Transparent full-width) ── */
  #nav-container {
    background-color: transparent;
    border: 1px solid transparent;
    box-shadow: 0 0 0 0 transparent;
    border-radius: 0;
    margin-top: 0;
    transition: max-width 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                height 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                margin 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                padding 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                border-radius 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                background-color 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ── Mode 2: Nav Container morphs into Floating Glass Pill ── */
  #main-header[data-floating="true"] #nav-container {
    width: calc(100% - 2.5rem);
    max-width: 1160px;
    height: 56px;
    margin-top: 12px;
    margin-left: auto;
    margin-right: auto;
    border-radius: 9999px;
    padding-left: 1.25rem;
    padding-right: 0.625rem;
    background-color: rgba(6, 40, 29, 0.65);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 16px 36px -10px rgba(0, 0, 0, 0.45), inset 0 1px 1px 0 rgba(255, 255, 255, 0.20);
  }

  .nav-ppdb-btn {
    border-radius: 9999px !important;
  }

  /* Brand logos slightly scale down when floating */
  #main-header[data-floating="true"] .brand-logo {
    height: 32px;
  }
  @media (min-width: 1280px) {
    #main-header[data-floating="true"] .brand-logo {
      height: 34px;
    }
  }

  /* Brand divider scales down slightly */
  #main-header[data-floating="true"] .brand-divider {
    height: 1.25rem;
  }

  /* Subtitle hiding in compact floating screens (<1440px) */
  #main-header[data-floating="true"] .brand-subtitle {
    display: none;
  }
  @media (min-width: 1440px) {
    #main-header[data-floating="true"] .brand-subtitle {
      display: inline;
    }
  }

  /* ── Mobile Mode 2 Floating Pill (below 1024px) ── */
  @media (max-width: 1023px) {
    #main-header[data-floating="true"] #nav-container {
      height: 52px;
      margin-top: 10px;
      border-radius: 1rem; /* rounded-2xl */
      width: calc(100% - 1.5rem);
      margin-left: auto;
      margin-right: auto;
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }

  /* ── Mobile Floating Glass Panel ── */
  .mobile-menu-glass {
    background-color: rgba(6, 40, 29, 0.82);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.5), inset 0 1px 1px 0 rgba(255, 255, 255, 0.20);
  }

  /* ── Fallback for browsers without backdrop-filter ── */
  @supports not (backdrop-filter: blur(1px)) {
    #main-header[data-floating="true"] #nav-container {
      background-color: rgba(6, 38, 26, 0.94);
    }
    .mobile-menu-glass {
      background-color: rgba(6, 38, 26, 0.96);
    }
  }

  /* ── Accessibility: Prefers Reduced Motion ── */
  @media (prefers-reduced-motion: reduce) {
    #top-bar,
    #nav-container,
    #mobile-menu-panel,
    #mobile-menu-backdrop,
    #ham-bar-top,
    #ham-bar-mid,
    #ham-bar-bot,
    .brand-logo,
    .brand-divider,
    .dropdown-menu {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  // ── Two-Mode Header System with IntersectionObserver Sentinel ──
  const header = document.getElementById('main-header');
  const sentinel = document.getElementById('header-sentinel');
  const btn = document.getElementById('mobile-menu-btn');
  const panel = document.getElementById('mobile-menu-panel') as HTMLElement | null;
  const backdrop = document.getElementById('mobile-menu-backdrop');
  const barTop = document.getElementById('ham-bar-top');
  const barMid = document.getElementById('ham-bar-mid');
  const barBot = document.getElementById('ham-bar-bot');

  let menuOpen = false;

  function setFloatingState(isFloating: boolean) {
    if (!header) return;
    if (isFloating || menuOpen) {
      header.setAttribute('data-floating', 'true');
    } else {
      header.setAttribute('data-floating', 'false');
    }
  }

  // Setup IntersectionObserver on top sentinel (~24px)
  if (sentinel && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(([entry]) => {
      setFloatingState(!entry.isIntersecting);
    }, { root: null, threshold: 0 });

    observer.observe(sentinel);
  } else {
    // Fallback if IntersectionObserver not supported
    const onScrollFallback = () => {
      setFloatingState(window.scrollY > 24);
    };
    window.addEventListener('scroll', onScrollFallback, { passive: true });
    onScrollFallback();
  }

  // ── Mobile Menu Toggle Logic ──
  function openMenu() {
    if (!panel) return;
    menuOpen = true;
    setFloatingState(true);

    panel.classList.remove('pointer-events-none');
    panel.classList.add('pointer-events-auto');
    panel.style.opacity = '1';
    panel.style.transform = 'translateY(0) scale(1)';
    panel.setAttribute('aria-hidden', 'false');

    if (backdrop) {
      backdrop.classList.remove('pointer-events-none', 'opacity-0');
      backdrop.classList.add('pointer-events-auto', 'opacity-100');
    }

    btn?.setAttribute('aria-expanded', 'true');
    btn?.setAttribute('aria-label', 'Tutup Menu');

    // Morph hamburger lines to X
    if (barTop) {
      barTop.style.transform = 'translateY(5px) rotate(45deg)';
    }
    if (barMid) {
      barMid.style.opacity = '0';
      barMid.style.transform = 'translateX(6px)';
    }
    if (barBot) {
      barBot.style.transform = 'translateY(-5px) rotate(-45deg)';
    }

    // Lock body scroll
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    if (!panel) return;
    menuOpen = false;

    panel.classList.remove('pointer-events-auto');
    panel.classList.add('pointer-events-none');
    panel.style.opacity = '0';
    panel.style.transform = 'translateY(-8px) scale(0.98)';
    panel.setAttribute('aria-hidden', 'true');

    if (backdrop) {
      backdrop.classList.remove('pointer-events-auto', 'opacity-100');
      backdrop.classList.add('pointer-events-none', 'opacity-0');
    }

    btn?.setAttribute('aria-expanded', 'false');
    btn?.setAttribute('aria-label', 'Buka Menu');

    // Morph X back to hamburger lines
    if (barTop) {
      barTop.style.transform = 'none';
    }
    if (barMid) {
      barMid.style.opacity = '1';
      barMid.style.transform = 'none';
    }
    if (barBot) {
      barBot.style.transform = 'none';
    }

    // Unlock body scroll
    document.body.style.overflow = '';

    // Collapse open submenus
    document.querySelectorAll('.mobile-submenu').forEach((sm: Element) => {
      (sm as HTMLElement).style.maxHeight = '0';
    });
    document.querySelectorAll('.mobile-submenu-toggle').forEach((t: Element) => {
      t.setAttribute('aria-expanded', 'false');
      const chevron = t.querySelector('svg');
      if (chevron) chevron.style.transform = 'rotate(0deg)';
    });

    // Re-sync floating state with actual scroll position
    setFloatingState(window.scrollY > 24);
  }

  if (btn && panel) {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      menuOpen ? closeMenu() : openMenu();
    });
  }

  // Close on backdrop click
  backdrop?.addEventListener('click', closeMenu);

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menuOpen) {
      closeMenu();
    }
  });

  // Close menu on resize above lg
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024 && menuOpen) {
      closeMenu();
    }
  });

  // Close menu on outside click
  document.addEventListener('click', (e) => {
    if (menuOpen && panel && !panel.contains(e.target as Node) && !btn?.contains(e.target as Node)) {
      closeMenu();
    }
  });

  // Close menu on nav link click
  panel?.querySelectorAll('a[href]').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // Mobile Submenu Accordion Toggle
  document.querySelectorAll('.mobile-submenu-toggle').forEach((toggle) => {
    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const parentItem = toggle.closest('.mobile-nav-item');
      const submenu = parentItem?.querySelector('.mobile-submenu') as HTMLElement | null;
      const chevron = toggle.querySelector('svg') as SVGElement | null;
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';

      // Collapse other submenus
      document.querySelectorAll('.mobile-submenu-toggle[aria-expanded="true"]').forEach((other) => {
        if (other !== toggle) {
          other.setAttribute('aria-expanded', 'false');
          const otherSub = other.closest('.mobile-nav-item')?.querySelector('.mobile-submenu') as HTMLElement | null;
          const otherChev = other.querySelector('svg') as SVGElement | null;
          if (otherSub) otherSub.style.maxHeight = '0';
          if (otherChev) otherChev.style.transform = 'rotate(0deg)';
        }
      });

      if (isOpen) {
        toggle.setAttribute('aria-expanded', 'false');
        if (submenu) submenu.style.maxHeight = '0';
        if (chevron) chevron.style.transform = 'rotate(0deg)';
      } else {
        toggle.setAttribute('aria-expanded', 'true');
        if (submenu) submenu.style.maxHeight = submenu.scrollHeight + 'px';
        if (chevron) chevron.style.transform = 'rotate(180deg)';
      }
    });
  });

  // ── Live Jakarta Clock (GMT+7) ──
  function updateClock() {
    if (document.hidden) return;
    const clockElement = document.getElementById('live-clock');
    if (!clockElement) return;
    try {
      const options: Intl.DateTimeFormatOptions = { 
        timeZone: 'Asia/Jakarta', 
        hour: '2-digit', 
        minute: '2-digit', 
        second: '2-digit', 
        hour12: false 
      };
      const timeString = new Intl.DateTimeFormat('id-ID', options).format(new Date());
      clockElement.textContent = `Jakarta (GMT+7) ${timeString.replace(/\./g, ':')}`;
    } catch(e) {
      clockElement.textContent = `Jakarta (GMT+7)`;
    }
  }
  setInterval(updateClock, 1000);
  updateClock();
</script>
