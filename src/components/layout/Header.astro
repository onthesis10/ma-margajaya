---
import { schoolConfig } from '../../config/school.config';
import { navigation } from '../../config/navigation.config';
import Button from '../ui/Button.astro';

const currentPath = Astro.url.pathname;
---

<!-- Scroll Sentinel for IntersectionObserver (Mode 1 -> Mode 2 Trigger) -->
<div id="header-sentinel" class="absolute top-0 left-0 w-full h-6 pointer-events-none -z-50" aria-hidden="true"></div>

<!-- Mobile Menu Backdrop -->
<div 
  id="mobile-menu-backdrop" 
  class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40 transition-opacity duration-300 opacity-0 pointer-events-none lg:hidden" 
  aria-hidden="true"
></div>

<header 
  id="main-header" 
  data-floating="false" 
  class="fixed top-0 left-0 w-full z-50 text-white pointer-events-none"
>
  <!-- Topbar: Mode 1 Only (Fades & collapses smoothly on scroll) -->
  <div 
    id="top-bar" 
    class="pointer-events-auto hidden lg:flex justify-between items-center max-w-7xl mx-auto px-6 py-2 text-[11px] font-medium tracking-widest border-b border-white/15 text-white/80"
  >
    <div class="flex gap-4 items-center">
      <span class="inline-flex items-center gap-1.5 text-gold font-semibold">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z"></path>
        </svg>
        Kemenag Kab. Ciamis
      </span>
      <span class="text-white/20">|</span>
      <span>Yayasan Suhulul A'la</span>
      <span class="text-white/20">|</span>
      <span>Kompleks Ponpes Darul Muawanah</span>
    </div>

    <div class="flex gap-5 items-center uppercase">
      <span id="live-clock" class="text-gold font-bold tracking-wider">Jakarta (GMT+7) --:--:--</span>
      <span class="text-white/20">|</span>
      
      <!-- Social & Contact Icons -->
      <div class="flex items-center gap-4">
        <a href={schoolConfig.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram MA Margajaya" class="text-white/80 hover:text-gold transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-gold rounded" title="Instagram">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
          </svg>
        </a>
        <a href={schoolConfig.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook MA Margajaya" class="text-white/80 hover:text-gold transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-gold rounded" title="Facebook">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
        <a href={schoolConfig.social.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok MA Margajaya" class="text-white/80 hover:text-gold transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-gold rounded" title="TikTok">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
          </svg>
        </a>
        <a href={`mailto:${schoolConfig.email}`} aria-label="Email" class="text-white/80 hover:text-gold transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-gold rounded">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </a>
        <a href={`https://wa.me/${schoolConfig.whatsapp}`} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="text-white/80 hover:text-gold transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-gold rounded">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navbar Container (Morphs into Floating Glass Pill on scroll) -->
  <div 
    id="nav-container" 
    class="pointer-events-auto max-w-7xl mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between"
  >
    <!-- Brand Logo: MA Margajaya + Ponpes Darul Muawanah -->
    <a href="/" class="flex items-center gap-1 group shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold rounded-lg p-0.5" aria-label="Beranda MA Margajaya Sukadana">
      <!-- Logo MA Margajaya (Utama) -->
      <img
        src="/logo/logo-ma-margajaya-sm.png"
        alt={`Logo ${schoolConfig.name}`}
        width="40"
        height="36"
        loading="eager"
        decoding="async"
        class="brand-logo h-9 lg:h-9 xl:h-10 w-auto object-contain drop-shadow-md transition-all duration-300 group-hover:scale-105 shrink-0"
      />

      <!-- Logo Ponpes Darul Muawanah -->
      <img
        src="/logo/logo-ponpes-darul-muawanah-sm.png"
        alt={`Logo ${schoolConfig.ponpesName}`}
        width="47"
        height="36"
        loading="eager"
        decoding="async"
        class="brand-logo h-9 lg:h-9 xl:h-10 w-auto object-contain drop-shadow transition-all duration-300 group-hover:scale-105 shrink-0 opacity-90 group-hover:opacity-100"
      />

      <!-- Separator Vertikal -->
      <div class="brand-divider w-px h-6 sm:h-7 bg-white/20 shrink-0 mx-1.5 sm:mx-2 transition-all duration-300"></div>

      <!-- Teks Identitas -->
      <div class="flex flex-col justify-center shrink-0">
        <div
          class="font-bold text-[11px] sm:text-[12px] xl:text-[13px] tracking-wide text-white group-hover:text-gold transition-colors uppercase leading-none"
          style="font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;"
        >
          {schoolConfig.shortName}
        </div>
        <div
          class="brand-subtitle text-[8.5px] sm:text-[9.5px] text-white/90 uppercase tracking-[0.05em] font-medium leading-none mt-1 transition-all duration-300"
          style="font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;"
        >
          <span class="sm:hidden">Ponpes Darul Muawanah</span>
          <span class="hidden sm:inline">{schoolConfig.ponpesName}</span>
        </div>
      </div>
    </a>
    
    <!-- Tab Bar Links (Desktop) -->
    <nav class="hidden lg:flex items-center gap-1 xl:gap-3 h-full">
      {navigation.map((item) => {
        const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
        const hasSub = item.subItems && item.subItems.length > 0;
        return (
          <div class="relative group/nav h-full flex items-center">
            <!-- Parent Link -->
            <a 
              href={item.href} 
              class={`py-1.5 px-2 xl:px-2.5 rounded-full text-[13px] xl:text-[13.5px] tracking-wide transition-all duration-150 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-gold whitespace-nowrap ${
                isActive 
                  ? 'text-gold font-bold drop-shadow-[0_0_12px_rgba(232,185,35,0.45)]' 
                  : 'text-white/85 hover:text-gold hover:bg-white/10 group-hover/nav:text-gold font-medium'
              }`}
            >
              {item.label}
            </a>

            <!-- Submenu Dropdown -->
            {hasSub && (
              <div class="dropdown-menu absolute top-[calc(100%-4px)] left-1/2 -translate-x-1/2 min-w-[210px] opacity-0 invisible -translate-y-1.5 pointer-events-none group-hover/nav:opacity-100 group-hover/nav:visible group-hover/nav:translate-y-0 group-hover/nav:pointer-events-auto transition-[opacity,transform] duration-150 ease-out z-50 pt-2 will-change-transform">
                <div 
                  class="rounded-2xl p-1.5 text-left"
                  style="background: rgba(6, 40, 29, 0.88); backdrop-filter: blur(24px) saturate(180%); -webkit-backdrop-filter: blur(24px) saturate(180%); border: 1px solid rgba(255, 255, 255, 0.18); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), inset 0 1px 1px 0 rgba(255, 255, 255, 0.25);"
                >
                  <div class="space-y-0.5">
                    {item.subItems?.map((sub) => (
                      <a 
                        href={sub.href}
                        class="flex items-center justify-between px-3 py-2 rounded-xl text-[12.5px] font-medium text-white drop-shadow-[0_1px_2px_rgba(0,0,0,0.8)] hover:bg-white/20 active:bg-white/30 transition-colors duration-100 group/sub focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-gold"
                      >
                        <span class="group-hover/sub:translate-x-0.5 transition-transform duration-100">{sub.title}</span>
                        <span class="text-white/60 group-hover/sub:text-gold text-[11px] transition-colors duration-100 drop-shadow-none">&rsaquo;</span>
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            )}
          </div>
        );
      })}
    </nav>
    
    <!-- CTA Button (Clean & prominent without ID/EN, pill rounded to match floating bar) -->
    <div class="hidden lg:flex items-center shrink-0">
      <Button href="/ppdb" variant="primary" size="sm" className="nav-ppdb-btn !rounded-full shadow-lg shadow-gold/20 font-semibold tracking-wider hover:shadow-[0_0_20px_rgba(232,185,35,0.4)] whitespace-nowrap text-xs px-4.5 py-2">
        DAFTAR PPDB &rarr;
      </Button>
    </div>

    <!-- Mobile Menu Button (Hamburger - Borderless & Refined) -->
    <button 
      id="mobile-menu-btn" 
      aria-label="Buka Menu" 
      aria-expanded="false" 
      aria-controls="mobile-menu-panel" 
      class="lg:hidden w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 active:bg-white/25 text-white transition-all duration-200 relative flex items-center justify-center shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold"
    >
      <span class="sr-only">Buka Menu</span>
      <div class="w-5 h-3.5 relative flex flex-col justify-between pointer-events-none">
        <span id="ham-bar-top" class="w-5 h-[2px] bg-white rounded-full transition-all duration-300 origin-center"></span>
        <span id="ham-bar-mid" class="w-3.5 h-[2px] bg-white/90 rounded-full transition-all duration-300 self-end"></span>
        <span id="ham-bar-bot" class="w-5 h-[2px] bg-white rounded-full transition-all duration-300 origin-center"></span>
      </div>
    </button>
  </div>

  <!-- Mobile Floating Glass Menu Panel -->
  <div 
    id="mobile-menu-panel" 
    class="pointer-events-auto lg:hidden mobile-menu-glass mx-3 sm:mx-4 mt-2 rounded-2xl shadow-2xl overflow-y-auto max-h-[calc(100vh-80px)] pointer-events-none"
    style="opacity: 0; transform: translateY(-8px) scale(0.98); transition: opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1), transform 0.28s cubic-bezier(0.16, 1, 0.3, 1); -webkit-overflow-scrolling: touch;"
    aria-hidden="true"
  >
    <nav class="flex flex-col p-4 gap-1">
      <!-- 8 Menu Items -->
      {navigation.map((item) => {
        const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
        const hasSub = item.subItems && item.subItems.length > 0;
        return (
          <div class="mobile-nav-item">
            <div class="flex items-center justify-between">
              <a 
                href={item.href} 
                class={`flex-1 text-[15px] font-semibold py-2.5 px-3 rounded-xl transition-colors min-h-[44px] flex items-center focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-gold ${
                  isActive 
                    ? 'text-gold font-bold bg-white/10' 
                    : 'text-white/90 hover:text-white hover:bg-white/5'
                }`}
              >
                {item.label}
              </a>
              {hasSub && (
                <button 
                  class="mobile-submenu-toggle p-3 text-white/60 hover:text-gold transition-all duration-200 min-w-[44px] min-h-[44px] flex items-center justify-center focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-gold rounded-lg"
                  aria-expanded="false"
                  aria-label={`Buka submenu ${item.label}`}
                >
                  <svg class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <polyline points="6 9 12 15 18 9"/>
                  </svg>
                </button>
              )}
            </div>

            {hasSub && (
              <div 
                class="mobile-submenu overflow-hidden"
                style="max-height: 0; transition: max-height 0.28s cubic-bezier(0.16, 1, 0.3, 1);"
              >
                <div class="pl-4 pr-2 pb-2 space-y-0.5 border-l-2 border-gold/40 ml-4 my-1">
                  {item.subItems?.map((sub) => (
                    <a 
                      href={sub.href}
                      class="flex items-center gap-2 py-2 px-3 text-[13px] text-white/80 hover:text-gold transition-colors rounded-lg hover:bg-white/5 min-h-[44px] focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-gold"
                    >
                      <span class="w-1.5 h-1.5 rounded-full bg-gold/60 shrink-0"></span>
                      {sub.title}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        );
      })}

      <!-- Primary CTA: DAFTAR PPDB -->
      <div class="pt-3 pb-1 mt-1">
        <Button href="/ppdb" variant="primary" size="lg" className="w-full text-center justify-center shadow-lg shadow-gold/20 font-bold tracking-wider">
          DAFTAR PPDB 2026/2027 &rarr;
        </Button>
      </div>

      <!-- Divider -->
      <div class="h-px bg-white/15 my-2"></div>

      <!-- Social & Contact Icons from Topbar (Borderless glass squares) -->
      <div class="flex items-center justify-center gap-2.5 pt-1">
        <a href={schoolConfig.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram MA Margajaya" class="p-2.5 rounded-xl bg-white/10 text-white/80 hover:text-gold hover:bg-white/20 transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-gold" title="Instagram">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
          </svg>
