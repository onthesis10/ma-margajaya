---
import Container from './Container.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---
<div class="bg-[#06281D] text-white pt-44 pb-20 relative overflow-hidden">
  <!-- ═══════════════════════════════════════════════════════════
       ELEGANT ABSTRACT CORPORATE BACKGROUND (Page Header)
       Flowing curved shapes, layered green waves, halftone dots, gold lines
       ═══════════════════════════════════════════════════════════ -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <svg
      class="absolute inset-0 w-full h-full"
      viewBox="0 0 1440 400"
      preserveAspectRatio="xMidYMid slice"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <!-- Gold shimmer gradient -->
        <linearGradient id="headerGoldShimmer" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%"   stop-color="#E8B923" stop-opacity="0" />
          <stop offset="35%"  stop-color="#E8B923" stop-opacity="0.6" />
          <stop offset="50%"  stop-color="#FDE047" stop-opacity="0.9" />
          <stop offset="65%"  stop-color="#E8B923" stop-opacity="0.6" />
          <stop offset="100%" stop-color="#E8B923" stop-opacity="0" />
          <animateTransform attributeName="gradientTransform" type="translate" from="-1440 0" to="1440 0" dur="5s" repeatCount="indefinite" />
        </linearGradient>

        <!-- Radial glow for 3D depth -->
        <radialGradient id="headerOrb1" cx="30%" cy="20%" r="70%">
          <stop offset="0%"   stop-color="#10B981" stop-opacity="0.25" />
          <stop offset="50%"  stop-color="#059669" stop-opacity="0.1" />
          <stop offset="100%" stop-color="#06281D" stop-opacity="0" />
        </radialGradient>
        <radialGradient id="headerOrb2" cx="80%" cy="80%" r="60%">
          <stop offset="0%"   stop-color="#34D399" stop-opacity="0.2" />
          <stop offset="100%" stop-color="#06281D" stop-opacity="0" />
        </radialGradient>

        <!-- Wave gradients with 3D depth & soft light -->
        <linearGradient id="headerWave1" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%"   stop-color="#0E4E35" stop-opacity="0.95" />
          <stop offset="50%"  stop-color="#075B2A" stop-opacity="0.8" />
          <stop offset="100%" stop-color="#042F1A" stop-opacity="0.6" />
        </linearGradient>
        <linearGradient id="headerWave2" x1="0%" y1="100%" x2="100%" y2="0%">
          <stop offset="0%"   stop-color="#059669" stop-opacity="0.5" />
          <stop offset="60%"  stop-color="#10B981" stop-opacity="0.25" />
          <stop offset="100%" stop-color="#06281D" stop-opacity="0.1" />
        </linearGradient>
        <linearGradient id="headerWave3" x1="100%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%"   stop-color="#15803D" stop-opacity="0.6" />
          <stop offset="100%" stop-color="#064E3B" stop-opacity="0.2" />
        </linearGradient>

        <!-- Soft 3D White light sheen gradient -->
        <linearGradient id="headerWhiteSheen" x1="0%" y1="0%" x2="70%" y2="100%">
          <stop offset="0%"   stop-color="#FFFFFF" stop-opacity="0.12" />
          <stop offset="30%"  stop-color="#FFFFFF" stop-opacity="0.04" />
          <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0" />
        </linearGradient>

        <!-- Blur filters for depth -->
        <filter id="headerBlurSoft">
          <feGaussianBlur stdDeviation="5" />
        </filter>
        <filter id="headerBlurGlow">
          <feGaussianBlur stdDeviation="25" />
        </filter>
      </defs>

      <!-- Deep background base -->
      <rect width="1440" height="400" fill="#06281D" />

      <!-- Glowing orbs for atmospheric 3D lighting -->
      <circle class="hero-orb1" cx="250" cy="80" r="300" fill="url(#headerOrb1)" filter="url(#headerBlurGlow)" />
      <circle class="hero-orb2" cx="1200" cy="300" r="280" fill="url(#headerOrb2)" filter="url(#headerBlurGlow)" />

      <!-- Layered Flowing Wave Curves -->
      <!-- Wave 1: Deep base flow -->
      <path class="hero-wave1"
        d="M-100,240 C150,140 380,320 680,210 C980,100 1200,280 1550,170 L1550,450 L-100,450 Z"
        fill="url(#headerWave1)"
      />

      <!-- Wave 2: Sweeping 3D mid wave with soft sheen -->
      <path class="hero-wave2"
        d="M-50,300 C200,180 450,360 800,240 C1150,120 1350,310 1550,220 L1550,450 L-50,450 Z"
        fill="url(#headerWave2)"
      />

      <!-- Wave 3: Top graceful arch -->
      <path class="hero-wave4"
        d="M-100,100 C220,10 480,160 820,60 C1160,-40 1380,110 1600,30 L1600,-50 L-100,-50 Z"
        fill="url(#headerWave3)"
      />

      <!-- Soft white light gradient overlay wave for 3D gloss finish -->
      <path class="hero-wave3"
        d="M-100,180 C250,70 520,240 850,130 C1180,20 1380,190 1600,100 L1600,-50 L-100,-50 Z"
        fill="url(#headerWhiteSheen)"
      />

      <!-- Thin Gold Accent Lines & Waves -->
      <g opacity="0.75">
        <!-- Flowing curved gold accent 1 -->
        <path
          d="M-50,260 C220,150 460,340 800,220 C1140,100 1360,290 1550,190"
          fill="none"
          stroke="url(#headerGoldShimmer)"
          stroke-width="1.2"
        />
        <!-- Flowing curved gold accent 2 -->
        <path
          d="M-50,140 C260,30 540,200 870,90 C1200,-20 1400,150 1600,60"
          fill="none"
          stroke="url(#headerGoldShimmer)"
          stroke-width="0.8"
          opacity="0.6"
        />
        <!-- Diagonal accent lines -->
        <line x1="0" y1="120" x2="1440" y2="40" stroke="url(#headerGoldShimmer)" stroke-width="0.5" opacity="0.4" />
        <line x1="0" y1="360" x2="1440" y2="280" stroke="url(#headerGoldShimmer)" stroke-width="0.6" opacity="0.3" />
      </g>
    </svg>
  </div>

  <!-- Subtle bottom vignette gradient to blend with content seamlessly -->
  <div class="absolute inset-0 bg-gradient-to-b from-[#06281D]/30 via-transparent to-[#06281D]/80 pointer-events-none"></div>


  <Container className="relative z-10">
    <div class="flex items-center gap-2.5 mb-4">
      <span class="w-6 h-[1.5px] bg-gold-soft"></span>
      <span class="text-xs font-bold tracking-[0.25em] uppercase text-gold-soft">
        MA Margajaya Sukadana · Ciamis
      </span>
    </div>
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-serif tracking-[-0.02em] leading-tight">{title}</h1>
    {description && <p class="text-white/80 mt-4 max-w-2xl text-base sm:text-lg leading-relaxed">{description}</p>}
  </Container>
</div>
