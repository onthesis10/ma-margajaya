---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "Admin Portal — MA Margajaya" } = Astro.props;
---

<!DOCTYPE html>
<html lang="id" class="h-full bg-[#0d4a2f] text-slate-100">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>

  <!-- Strict Search Engine Shield -->
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
  <meta name="googlebot" content="noindex, nofollow" />
  <link rel="icon" href="/logo/logo-ma-margajaya.png" type="image/png" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..800;1,9..144,300..800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

  <style is:global>
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: #0a3d28;
      color: #f1f5f9;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    h1, h2, h3, h4, .font-serif {
      font-family: 'Fraunces', Georgia, serif;
    }

    /* iOS / macOS Glassmorphic Containers */
    .ios-glass-card {
      background: rgba(14, 68, 44, 0.65);
      backdrop-filter: blur(40px) saturate(200%);
      -webkit-backdrop-filter: blur(40px) saturate(200%);
      border: 1px solid rgba(255, 255, 255, 0.14);
      box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.05);
    }

    .ios-glass-panel {
      background: rgba(10, 55, 35, 0.82);
      backdrop-filter: blur(36px) saturate(190%);
      -webkit-backdrop-filter: blur(36px) saturate(190%);
      border: 1px solid rgba(255, 255, 255, 0.14);
    }

    .ios-glass-nav {
      background: rgba(8, 42, 27, 0.92);
      backdrop-filter: blur(32px) saturate(200%);
      -webkit-backdrop-filter: blur(32px) saturate(200%);
      border-bottom: 2px solid rgba(255, 255, 255, 0.16);
      box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.4);
    }

    .ios-glass-input {
      background: rgba(255, 255, 255, 0.07);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: #ffffff;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .ios-glass-input:focus {
      background: rgba(255, 255, 255, 0.12);
      border-color: #e8b923;
      box-shadow: 0 0 0 4px rgba(232, 185, 35, 0.22);
      outline: none;
    }

    /* =========================================================================
       MACOS + BRUTALISM HYBRID DESIGN SYSTEM (HIG + NEOBRUTALISM)
       ========================================================================= */
    .brutal-mac-card {
      background: rgba(8, 42, 28, 0.82);
      backdrop-filter: blur(30px) saturate(190%);
      -webkit-backdrop-filter: blur(30px) saturate(190%);
      border: 2px solid rgba(255, 255, 255, 0.18);
      border-top-color: rgba(255, 255, 255, 0.28);
      box-shadow: 6px 6px 0px 0px #022016, 0 20px 45px -12px rgba(0, 0, 0, 0.65);
      border-radius: 1.5rem;
      position: relative;
    }

    .brutal-mac-subcard {
      background: rgba(4, 25, 17, 0.75);
      border: 2px solid rgba(255, 255, 255, 0.14);
      box-shadow: 3px 3px 0px 0px #022016;
      border-radius: 1rem;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .brutal-mac-subcard:hover {
      border-color: rgba(52, 211, 153, 0.35);
    }

    .brutal-mac-btn {
      border: 2px solid rgba(255, 255, 255, 0.2);
      box-shadow: 3px 3px 0px 0px #022016;
      transition: all 0.15s cubic-bezier(0.16, 1, 0.3, 1);
      cursor: pointer;
    }

    .brutal-mac-btn:hover {
      transform: translate(-1px, -1px);
      box-shadow: 4px 4px 0px 0px #022016;
    }

    .brutal-mac-btn:active {
      transform: translate(2px, 2px);
      box-shadow: 1px 1px 0px 0px #022016;
    }

    .brutal-mac-btn-primary {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: #ffffff;
      border: 2px solid #34d399;
      box-shadow: 4px 4px 0px 0px #022016;
      transition: all 0.15s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .brutal-mac-btn-primary:hover {
      background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
      transform: translate(-1px, -1px);
      box-shadow: 5px 5px 0px 0px #022016;
    }

    .brutal-mac-btn-primary:active {
      transform: translate(2px, 2px);
      box-shadow: 1px 1px 0px 0px #022016;
    }

    .brutal-mac-btn-gold {
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
      color: #042517;
      border: 2px solid #fbbf24;
      box-shadow: 3px 3px 0px 0px #022016;
      font-weight: 800;
      transition: all 0.15s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .brutal-mac-btn-gold:hover {
      background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
      transform: translate(-1px, -1px);
      box-shadow: 4px 4px 0px 0px #022016;
    }

    .brutal-mac-btn-gold:active {
      transform: translate(2px, 2px);
      box-shadow: 1px 1px 0px 0px #022016;
    }

    .brutal-mac-input {
      background: rgba(3, 24, 16, 0.7);
      border: 2px solid rgba(255, 255, 255, 0.18);
      box-shadow: inset 2px 2px 0px 0px rgba(0, 0, 0, 0.4);
      color: #ffffff;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .brutal-mac-input:focus {
      background: rgba(2, 28, 19, 0.9);
      border-color: #e8b923;
      box-shadow: 0 0 0 3px rgba(232, 185, 35, 0.28), inset 2px 2px 0px 0px rgba(0, 0, 0, 0.4);
      outline: none;
    }

    /* macOS Window Header Bar */
    .mac-window-bar {
      background: rgba(2, 24, 16, 0.75);
      border-bottom: 2px solid rgba(255, 255, 255, 0.14);
    }

    /* macOS Traffic Light Buttons */
    .traffic-dot {
      width: 12px;
      height: 12px;
      border-radius: 9999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: relative;
      border: 1px solid rgba(0, 0, 0, 0.35);
      transition: transform 0.15s ease, filter 0.15s ease;
      cursor: pointer;
    }

    .traffic-dot:hover {
      filter: brightness(1.15);
      transform: scale(1.1);
    }

    .traffic-dot-red {
      background-color: #ff5f56;
      border-color: #e0443e;
    }

    .traffic-dot-yellow {
      background-color: #ffbd2e;
      border-color: #dea123;
    }

    .traffic-dot-green {
      background-color: #27c93f;
      border-color: #1aab29;
    }

    .traffic-group:hover .traffic-dot-red::after {
      content: "×";
      font-size: 10px;
      color: #4d0000;
      font-weight: 900;
      line-height: 1;
      position: absolute;
      top: 0px;
      left: 2.5px;
    }

    .traffic-group:hover .traffic-dot-yellow::after {
      content: "–";
      font-size: 10px;
      color: #4a2800;
      font-weight: 900;
      line-height: 1;
      position: absolute;
      top: -1px;
      left: 3px;
    }

    .traffic-group:hover .traffic-dot-green::after {
      content: "+";
      font-size: 10px;
      color: #003e0e;
      font-weight: 900;
      line-height: 1;
      position: absolute;
      top: -0.5px;
      left: 2.5px;
    }

    /* Apple-style Keyboard Shortcut Badge */
    .kbd-tag {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.15rem 0.4rem;
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", sans-serif;
      font-size: 0.65rem;
      font-weight: 700;
      color: rgba(255, 255, 255, 0.9);
      background: rgba(0, 0, 0, 0.4);
      border: 1px solid rgba(255, 255, 255, 0.22);
      border-bottom: 2px solid rgba(255, 255, 255, 0.35);
      border-radius: 0.375rem;
      box-shadow: 1px 1px 0px 0px rgba(0,0,0,0.4);
      line-height: 1;
      letter-spacing: 0.04em;
    }

    /* Animated Motion Waves */
    @keyframes admin-wave-1 {
      0% { transform: translateY(0px) translateX(0px) rotate(0deg); }
      50% { transform: translateY(-24px) translateX(20px) rotate(1deg); }
      100% { transform: translateY(0px) translateX(0px) rotate(0deg); }
    }
    @keyframes admin-wave-2 {
      0% { transform: translateY(0px) translateX(0px) rotate(0deg); }
      50% { transform: translateY(20px) translateX(-25px) rotate(-1deg); }
      100% { transform: translateY(0px) translateX(0px) rotate(0deg); }
    }
    @keyframes admin-glow-pulse {
      0%, 100% { opacity: 0.35; transform: scale(1); }
      50% { opacity: 0.65; transform: scale(1.1); }
    }

    .wave-motion-1 {
      animation: admin-wave-1 16s ease-in-out infinite;
    }
    .wave-motion-2 {
      animation: admin-wave-2 20s ease-in-out infinite;
    }
    .glow-pulse {
      animation: admin-glow-pulse 8s ease-in-out infinite;
    }

    /* Ultra-thin Transparent Apple Scrollbar */
    ::-webkit-scrollbar {
      width: 4px;
      height: 4px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.12);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(232, 185, 35, 0.45);
    }

    .transparent-thin-scrollbar {
      scrollbar-width: thin;
      scrollbar-color: rgba(255, 255, 255, 0.15) transparent;
    }
    .transparent-thin-scrollbar::-webkit-scrollbar {
      width: 4px;
      height: 4px;
    }
    .transparent-thin-scrollbar::-webkit-scrollbar-track {
      background: transparent;
    }
    .transparent-thin-scrollbar::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.15);
      border-radius: 9999px;
    }
    .transparent-thin-scrollbar::-webkit-scrollbar-thumb:hover {
      background: rgba(232, 185, 35, 0.5);
    }

    /* Completely hidden scrollbar — scroll still works */
    .preview-scrollbar {
      scrollbar-width: none; /* Firefox */
    }
    .preview-scrollbar::-webkit-scrollbar {
      display: none; /* Chrome, Safari, Edge */
    }

    /* =========================================================================
       WYSIWYG RICH TEXT EDITOR — contenteditable styles
       ========================================================================= */

    /* Placeholder text when editor is empty */
    .wysiwyg-editor:empty::before {
      content: attr(data-placeholder);
      color: rgba(148, 163, 184, 0.45);
      pointer-events: none;
      display: block;
    }

    /* Keep focus ring consistent with glass inputs */
    .wysiwyg-editor:focus {
      border-color: rgba(232, 185, 35, 0.6);
      box-shadow: 0 0 0 4px rgba(232, 185, 35, 0.18);
      outline: none;
    }

    /* Rich text content styling inside the editor */
    .wysiwyg-editor b,
    .wysiwyg-editor strong {
      font-weight: 700;
      color: #ffffff;
    }

    .wysiwyg-editor i,
    .wysiwyg-editor em {
      font-style: italic;
      color: rgba(203, 213, 225, 0.92);
    }

    .wysiwyg-editor u {
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .wysiwyg-editor s,
    .wysiwyg-editor strike {
      text-decoration: line-through;
      opacity: 0.65;
    }

    .wysiwyg-editor h2 {
      font-family: 'Fraunces', Georgia, serif;
      font-size: 1.2rem;
      font-weight: 700;
      color: #ffffff;
      margin: 1.2em 0 0.4em;
      padding-bottom: 0.2em;
      border-bottom: 1px solid rgba(255,255,255,0.1);
      line-height: 1.3;
    }

    .wysiwyg-editor blockquote {
      margin: 0.8em 0;
      padding: 0.8em 1em 0.8em 1.1em;
      border-left: 3px solid #e8b923;
      background: rgba(232, 185, 35, 0.07);
      border-radius: 0 12px 12px 0;
      color: rgba(248, 228, 170, 0.9);
      font-style: italic;
    }

    .wysiwyg-editor ul {
      list-style: disc;
      padding-left: 1.4em;
      margin: 0.6em 0;
    }

    .wysiwyg-editor ol {
      list-style: decimal;
      padding-left: 1.4em;
      margin: 0.6em 0;
    }

    .wysiwyg-editor li {
      margin-bottom: 0.25em;
      line-height: 1.75;
    }

    .wysiwyg-editor p {
      margin: 0.4em 0;
      min-height: 1.5em;
    }

    .wysiwyg-editor a {
      color: #6ee7b7;
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    /* Toolbar button active (when format is applied) */
    .toolbar-btn.is-active {
      background: rgba(5, 150, 105, 0.25);
      color: #6ee7b7;
      border: 1px solid rgba(5, 150, 105, 0.35);
    }

    /* Skeleton shimmer animation */
    @keyframes shimmer {
      0% { background-position: -800px 0; }
      100% { background-position: 800px 0; }
    }
    .skeleton-shimmer {
      background: linear-gradient(90deg, rgba(255,255,255,0.03) 25%, rgba(255,255,255,0.07) 50%, rgba(255,255,255,0.03) 75%);
      background-size: 800px 100%;
      animation: shimmer 1.8s ease-in-out infinite;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col relative overflow-x-hidden selection:bg-emerald-400 selection:text-white bg-[#0a3d28]">
  
  <!-- =========================================================================
       DYNAMIC GREEN BACKGROUND WITH ANIMATED WAVES & GLOWING ATMOSPHERES
       ========================================================================= -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-0 bg-[#0a3d28]">
    
    <!-- Base Green Gradients -->
    <div class="absolute inset-0 bg-gradient-to-br from-[#125c38] via-[#0a3d28] to-[#073122]"></div>
    
    <!-- Glowing Soft Orbs -->
    <div class="absolute -top-32 -left-32 w-[600px] h-[600px] bg-emerald-400/30 rounded-full blur-[110px] glow-pulse"></div>
    <div class="absolute top-1/3 -right-40 w-[700px] h-[700px] bg-gold/20 rounded-full blur-[130px] glow-pulse" style="animation-delay: -3s;"></div>
    <div class="absolute -bottom-40 left-1/4 w-[650px] h-[650px] bg-emerald-400/25 rounded-full blur-[120px] glow-pulse" style="animation-delay: -5s;"></div>

    <!-- Animated Flowing Wave Vector 1 (Emerald Deep) -->
    <svg 
      class="absolute -bottom-10 left-0 right-0 w-[140%] -ml-[20%] h-[450px] text-emerald-900/30 wave-motion-1 fill-current opacity-60" 
      viewBox="0 0 1440 320" 
      preserveAspectRatio="none"
    >
      <path d="M0,192L48,197.3C96,203,192,213,288,192C384,171,480,117,576,117.3C672,117,768,171,864,186.7C960,203,1056,181,1152,154.7C1248,128,1344,96,1392,80L1440,64L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path>
    </svg>

    <!-- Animated Flowing Wave Vector 2 (Emerald Mid & Gold Tint) -->
    <svg 
      class="absolute -bottom-5 left-0 right-0 w-[150%] -ml-[25%] h-[380px] text-[#075B2A]/25 wave-motion-2 fill-current opacity-70" 
      viewBox="0 0 1440 320" 
      preserveAspectRatio="none"
    >
      <path d="M0,96L60,117.3C120,139,240,181,360,170.7C480,160,600,96,720,85.3C840,75,960,117,1080,133.3C1200,149,1320,139,1380,133.3L1440,128L1440,320L1380,320C1320,320,1200,320,1080,320C960,320,840,320,720,320C600,320,480,320,360,320C240,320,120,320,60,320L0,320Z"></path>
    </svg>

    <!-- Subtle Radial Grid Pattern -->
    <div class="absolute inset-0 bg-[radial-gradient(#10b981_1px,transparent_1px)] [background-size:32px_32px] opacity-[0.06]"></div>

  </div>

  <main class="relative z-10 flex-1 flex flex-col">
    <slot />
  </main>
</body>
</html>
