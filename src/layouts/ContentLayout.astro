---
import Container from '../components/ui/Container.astro';

interface Props {
  className?: string;
}
const { className = '' } = Astro.props;
---
<section class={`py-20 lg:py-24 bg-white ${className}`}>
  <Container>
    <div class="max-w-4xl mx-auto prose prose-lg prose-blue">
      <slot />
    </div>
  </Container>
</section>
