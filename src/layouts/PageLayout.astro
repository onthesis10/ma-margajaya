---
import MainLayout from '../components/layout/MainLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import PPDBCTASection from '../components/sections/PPDBCTASection.astro';

interface Props {
  title: string;
  description?: string;
  breadcrumbs: { label: string; href: string }[];
  showContact?: boolean;
  showPPDBCTA?: boolean;
  /** URL gambar OG (opsional, fallback ke logo sekolah) */
  image?: string;
  /** Tipe halaman untuk og:type dan JSON-LD ('website' atau 'article') */
  type?: 'website' | 'article';
  /** Tanggal terbit ISO 8601 — khusus halaman berita */
  publishedTime?: string;
  /** Nama penulis — khusus halaman berita */
  author?: string;
}

const { 
  title, 
  description, 
  breadcrumbs, 
  showContact = true, 
  showPPDBCTA = true,
  image,
  type,
  publishedTime,
  author,
} = Astro.props;
---

<MainLayout 
  title={title} 
  description={description}
  image={image}
  type={type}
  publishedTime={publishedTime}
  author={author}
  breadcrumbs={breadcrumbs}
>
  <PageHeader title={title} description={description} />
  <Breadcrumb items={breadcrumbs} />
  
  <slot />
  
  {showPPDBCTA && <PPDBCTASection />}
  {showContact && <ContactSection />}
</MainLayout>

