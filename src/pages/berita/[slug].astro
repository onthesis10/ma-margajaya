  }

  /* ── Reduced Motion ───────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script is:inline>
  (function () {
    // Copy to clipboard
    function copyUrl() {
      if (!navigator.clipboard) return;
      navigator.clipboard.writeText(window.location.href).then(() => {
        // Slug button tooltip
        const tip = document.getElementById('copy-tip');
        if (tip) {
          tip.classList.add('visible');
          setTimeout(() => tip.classList.remove('visible'), 2000);
        }
        // Text button
        const textBtn = document.getElementById('btn-copy-text');
        if (textBtn) {
          const orig = textBtn.textContent;
          textBtn.textContent = 'Tersalin ✓';
          setTimeout(() => { textBtn.textContent = orig; }, 2000);
        }
      });
    }

    const slugBtn = document.getElementById('btn-copy-slug');
    const textBtn = document.getElementById('btn-copy-text');
    const shareBtn = document.getElementById('top-share-btn');

    if (slugBtn) slugBtn.addEventListener('click', copyUrl);
    if (textBtn) textBtn.addEventListener('click', copyUrl);

    if (shareBtn) {
      shareBtn.addEventListener('click', () => {
        if (navigator.share) {
          navigator.share({ title: document.title, url: window.location.href }).catch(() => {});
        } else {
          copyUrl();
        }
      });
    }
  })();
</script>

