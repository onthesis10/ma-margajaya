---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import { fetchNewsArticles, formatIndonesianDate, estimateReadingTime, type NewsArticle } from '../../lib/news';

export async function getStaticPaths() {
  const articles = await fetchNewsArticles();
  return articles.map(article => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: NewsArticle;
}

const { article } = Astro.props;

const breadcrumbs = [
  { label: "Berita", href: "/berita" },
  { label: article.judul, href: `/berita/${article.slug}` }
];

const articleUrl = `https://mamargajaya.sch.id/berita/${article.slug}`;
const formattedDate = formatIndonesianDate(article.tanggal);
const readingTime = estimateReadingTime(article.isi);
// Detect whether content is stored as HTML (from WYSIWYG) or plain text (legacy)
const isiContent = article.isi || '';
const isHtmlContent = isiContent.trimStart().startsWith('<');
const paragraphs = !isHtmlContent ? isiContent.split(/\n\s*\n/).filter(p => p.trim()) : [];
---

<PageLayout 
  title={article.judul} 
  description={article.isi ? article.isi.substring(0, 160) + '...' : 'Warta resmi MA Margajaya'}
  breadcrumbs={breadcrumbs}
>
  <section class="py-12 md:py-20 bg-slate-50/50 min-h-screen relative overflow-hidden" data-motion-section>
    
    <!-- Ambient Background -->
    <div class="glow-blob w-[500px] h-[500px] bg-emerald-500/10 -top-32 -left-32"></div>
    <div class="glow-blob w-[600px] h-[600px] bg-gold/10 top-1/3 -right-40"></div>

    <Container>
      
      <!-- Official Print Letterhead (ONLY VISIBLE WHEN PRINTING) -->
      <div class="print-only mb-6 border-b-2 border-black pb-4 text-center font-serif">
        <div class="text-xs uppercase font-bold tracking-widest text-slate-600">KEMENTERIAN AGAMA REPUBLIK INDONESIA</div>
        <div class="text-xl font-bold uppercase tracking-wide text-black mt-1">MADRASAH ALIYAH MARGAJAYA SUKADANA</div>
        <div class="text-[11px] text-slate-600 mt-0.5">Kompleks Pondok Pesantren Darul Muawanah · Dusun Jontor RT 01/04 Margajaya, Sukadana, Ciamis</div>
        <div class="text-[10px] uppercase tracking-widest text-slate-500 mt-2 border-t border-slate-300 pt-1">DOKUMEN WARTA RESMI CIVITAS AKADEMIKA</div>
      </div>

      <article id="article-main" class="max-w-3xl mx-auto space-y-10">
        
        <!-- Navigation Back -->
        <div class="no-print">
          <a 
            href="/berita" 
            class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-600 hover:text-emerald-800 transition-colors py-2 px-4 rounded-full bg-white border border-slate-200 shadow-sm"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Kembali ke Daftar Warta
          </a>
        </div>

        <!-- Header Info -->
        <div class="space-y-6 border-b border-slate-200/80 pb-8">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <span class="px-3.5 py-1.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-bold uppercase tracking-wider">
              Warta Resmi
            </span>
            <span class="text-xs font-medium text-slate-400 flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><path stroke-linecap="round" d="M12 7v5l3 3"></path></svg>
              <span>{readingTime}</span>
            </span>
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-slate-900 leading-[1.18] tracking-tight">
            {article.judul}
          </h1>

          <!-- Author & Date Strip -->
          <div class="flex flex-wrap items-center justify-between gap-4 pt-2 text-xs text-slate-500">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-900 flex items-center justify-center font-bold font-serif text-sm">
                MA
              </div>
              <div>
                <div class="font-bold text-slate-800 text-sm">{article.penulis || 'Humas MA Margajaya'}</div>
                <div class="text-slate-400">Rilis Resmi Madrasah</div>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <div class="text-right">
                <div class="font-bold text-emerald-800">{formattedDate}</div>
                <div class="text-emerald-600 font-medium">Terverifikasi &bull; Publik</div>
              </div>
            </div>
          </div>

          <!-- Social Share Bar & Print Action -->
          <div class="pt-4 border-t border-slate-100 no-print flex flex-wrap items-center justify-between gap-4">
            <div class="space-y-1.5">
              <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">
                Bagikan Warta:
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <!-- WhatsApp -->
                <a 
                  href={`https://api.whatsapp.com/send?text=${encodeURIComponent(article.judul + ' ' + articleUrl)}`} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-600 text-white text-xs font-semibold hover:bg-emerald-700 shadow-sm transition-all"
                >
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                  WhatsApp
                </a>

                <!-- Facebook -->
                <a 
                  href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(articleUrl)}`} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#1877F2] text-white text-xs font-semibold hover:bg-blue-700 shadow-sm transition-all"
                >
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                  Facebook
                </a>

                <!-- X / Twitter -->
                <a 
                  href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(article.judul)}&url=${encodeURIComponent(articleUrl)}`} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-900 text-white text-xs font-semibold hover:bg-black shadow-sm transition-all"
                >
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                  X
                </a>

                <!-- Copy Link -->
                <button 
                  id="btn-copy-slug" 
                  type="button" 
                  class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-white hover:bg-slate-100 text-slate-700 text-xs font-semibold border border-slate-300 transition-all shadow-sm"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                  <span id="label-copy-slug">Salin Tautan</span>
                </button>
              </div>
            </div>

            <!-- Print Button -->
            <button 
              type="button" 
              onclick="window.print()"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white hover:bg-emerald-50 text-slate-700 hover:text-emerald-800 border border-slate-300 shadow-sm text-xs font-bold uppercase tracking-wider transition-all self-end"
            >
              <svg class="w-4 h-4 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
              </svg>
              Cetak Dokumen
            </button>
          </div>
        </div>
        
        <!-- Cover Photo -->
        {article.url_foto && (
          <div class="rounded-3xl overflow-hidden shadow-lg border border-slate-200/80 bg-slate-900">
            <img 
              src={article.url_foto} 
              alt={article.judul} 
              referrerpolicy="no-referrer" 
              class="w-full max-h-[580px] object-cover" 
            />
            <div class="p-3.5 bg-slate-900/90 text-center text-xs text-white/70 italic backdrop-blur-md">
              Dokumentasi Resmi Civitas Akademika MA Margajaya Sukadana - Ciamis
            </div>
          </div>
        )}

        <!-- Formatted Body -->
        <div class="prose-article max-w-none">
          {isHtmlContent ? (
            <div set:html={isiContent} />
          ) : (
            // Legacy plain text: split by double newline into paragraphs
            paragraphs.map(p => (
              <p class="mb-6 whitespace-pre-line text-justify leading-relaxed">{p}</p>
            ))
          )}
        </div>

        <!-- Academic Footer Sign-off -->
        <div class="mt-16 pt-8 border-t border-slate-200 space-y-6">
          <div class="p-6 sm:p-8 rounded-2xl bg-white border border-slate-200/80 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
            <div>
              <div class="font-serif font-bold text-lg text-blue-ink">Madrasah Aliyah Margajaya</div>
              <div class="text-xs text-slate-500 mt-0.5">Kompleks Ponpes Darul Muawanah, Sukadana - Ciamis, Jawa Barat</div>
            </div>
            <a 
              href="/berita" 
              class="px-5 py-2.5 rounded-full bg-emerald-800 text-white text-xs font-bold uppercase tracking-wider hover:bg-emerald-900 transition-colors shadow-sm no-print"
            >
              Lihat Warta Lainnya &rarr;
            </a>
          </div>
        </div>

      </article>
    </Container>
  </section>
</PageLayout>

<style is:global>
  @media print {
    body {
      background: white !important;
      color: black !important;
    }
    .no-print, header, footer, #main-header, nav {
      display: none !important;
    }
    .print-only {
      display: block !important;
    }
    article#article-main {
      max-width: 100% !important;
      padding: 0 !important;
      margin: 0 !important;
    }
  }

  .print-only {
    display: none;
  }
</style>

<script is:inline>
  const copyBtn = document.getElementById('btn-copy-slug');
  const copyLabel = document.getElementById('label-copy-slug');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(window.location.href);
      if (copyLabel) {
        copyLabel.textContent = 'Tautan Tersalin! ✨';
        setTimeout(() => { copyLabel.textContent = 'Salin Tautan'; }, 2500);
      }
    });
  }
</script>
