---
import MainLayout from '../../components/layout/MainLayout.astro';
import ContactSection from '../../components/sections/ContactSection.astro';
import '../../styles/global.css';
import {
  fetchNewsArticles,
  formatIndonesianDate,
  estimateReadingTime,
  stripHtml,
  formatDriveImageUrl,
  type NewsArticle,
} from '../../lib/news';

export async function getStaticPaths() {
  const articles = await fetchNewsArticles();
  return articles.map(article => ({
    params: { slug: article.slug },
    props: { article, allArticles: articles },
  }));
}

interface Props {
  article: NewsArticle;
  allArticles: NewsArticle[];
}

const { article, allArticles = [] } = Astro.props;

// Canonical URL
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.mamargajaya.sch.id';
const articleUrl = `${siteUrl}/berita/${article.slug}`;

// Breadcrumbs
const breadcrumbs = [
  { label: 'Beranda', href: '/' },
  { label: 'Berita', href: '/berita' },
  ...(article.kategori
    ? [{ label: article.kategori, href: `/berita/topik/${encodeURIComponent(article.kategori.toLowerCase().replace(/\s+/g, '-'))}` }]
    : []),
  { label: article.judul, href: `/berita/${article.slug}` },
];

const formattedDate = formatIndonesianDate(article.tanggal);
const readingTime = estimateReadingTime(article.isi);

// SEO description
const rawContent = article.isi || '';
const plainText = stripHtml(rawContent);
const fallbackDesc = 'Warta dan informasi resmi civitas akademika MA Margajaya Sukadana, Ciamis.';
let articleDescription = fallbackDesc;
if (plainText.length >= 140) {
  const maxLen = 155;
  const cutIndex = plainText.lastIndexOf(' ', maxLen);
  articleDescription = (cutIndex > 130 ? plainText.substring(0, cutIndex) : plainText.substring(0, maxLen)) + '…';
} else if (plainText.length > 0) {
  const combined = `${plainText} — Simak warta resmi civitas akademika MA Margajaya Sukadana, Ciamis.`;
  articleDescription = combined.length > 158 ? combined.substring(0, combined.lastIndexOf(' ', 155)) + '…' : combined;
}

// ============================================================
// HTML PARSER: Convert Google Docs / Gemini dump → clean paragraphs
// Structure: <div><div><div><div><span><b>CITY</b> – text</span>...</div><br><div>...</div>...</div></div></div></div>
// ============================================================
interface ParsedParagraph {
  html: string;        // Cleaned inline HTML (may contain <em>, <a>, <blockquote>)
  isBlockquote: boolean;
}

function parseArticleContent(raw: string): ParsedParagraph[] {
  if (!raw) return [];

  // --- Step 1: Strip Gemini / Angular bloat ---
  let text = raw
    .replace(/<source-footnote\b[^>]*>[\s\S]*?<\/source-footnote>/gi, '')
    .replace(/<sources-carousel-inline\b[^>]*>[\s\S]*?<\/sources-carousel-inline>/gi, '')
    .replace(/<source-inline-chip\b[^>]*>[\s\S]*?<\/source-inline-chip>/gi, '')
    .replace(/<!--[\s\S]*?-->/gi, '')
    .replace(/\s+style="[^"]*"/gi, '')
    .replace(/\s+(_ngcontent[^\s=>]*|_nghost[^\s=>]*|inline-copy-host|ng-[a-z0-9_-]+)(?:="[^"]*"|='[^']*'|=[^\s>]+)?/gi, '')
    .replace(/\s+data-[a-z0-9_-]+="[^"]*"/gi, '')
    .replace(/\s+aria-[a-z0-9_-]+="[^"]*"/gi, '')
    .replace(/\s+dir="[^"]*"/gi, '')
    .replace(/\s+id="[^"]*"/gi, '')
    .replace(/\s+class="[^"]*"/gi, '');

  // If plain text (no block-level tags), split by double newline
  const isHtml = /<(?:div|p|br|h[1-6]|blockquote|ul|ol|li)\b/i.test(text);
  if (!isHtml) {
    return text
      .split(/\n\s*\n/)
      .map(p => p.trim())
      .filter(p => p.length > 4)
      .map(p => ({ html: p, isBlockquote: false }));
  }

  // --- Step 2: Mark block boundaries ---
  // Replace structural tags with sentinel so we can split cleanly
  let marked = text
    .replace(/<\/(?:div|p|h[1-6]|li|section|article|blockquote)>/gi, '\n§§\n')
    .replace(/<(?:div|p|h[1-6]|section|article|blockquote)[^>]*>/gi, '\n§§\n')
    .replace(/<br\s*[\/]?>/gi, '\n§§\n');

  // --- Step 3: Extract text+inline-html per chunk ---
  const rawChunks = marked.split('\n§§\n');

  const paragraphs: ParsedParagraph[] = [];

  for (let chunk of rawChunks) {
    // Strip only wrapper span/b/strong — preserve em/i/a
    let cleaned = chunk
      // Remove empty spans completely
      .replace(/<span[^>]*>\s*<\/span>/gi, '')
      // Strip span wrappers but keep text
      .replace(/<\/?span[^>]*>/gi, '')
      // Convert <b>/<strong> to nothing (we handle dateline bold ourselves)
      .replace(/<\/?(?:b|strong)[^>]*>/gi, '')
      // Collapse whitespace
      .replace(/\s+/g, ' ')
      .trim();

    // Skip empty or only punctuation
    if (!cleaned || cleaned.replace(/[.,;:!?–—\-\s]/g, '').length < 3) continue;

    // Detect if this chunk is a blockquote / pull-quote
    // (starts with an open/smart quote and is a standalone sentence)
    const trimmed = cleaned.trimStart();
    const isBlockquote =
      (trimmed.startsWith('"') || trimmed.startsWith('"') || trimmed.startsWith('\u201C')) &&
      cleaned.length > 30;

    paragraphs.push({ html: cleaned, isBlockquote });
  }

  // --- Step 4: Merge very short fragments back into the previous paragraph ---
  const merged: ParsedParagraph[] = [];
  for (const para of paragraphs) {
    const last = merged[merged.length - 1];
    // Fragment: ends without terminal punctuation AND is short
    const isFragment = para.html.length < 20 && !/[.!?]$/.test(para.html.trim());
    if (last && isFragment && !last.isBlockquote && !para.isBlockquote) {
      last.html = (last.html + ' ' + para.html).trim();
    } else {
      merged.push({ ...para });
    }
  }

  return merged;
}

// Inject dateline + drop cap into the FIRST paragraph text
function injectDropcapDateline(para: ParsedParagraph, idx: number): ParsedParagraph {
  if (idx !== 0) return para;

  let html = para.html;

  // Dateline pattern: "CIAMIS – " or "CIAMIS — " (en-dash U+2013 or em-dash U+2014 or plain hyphen)
  // Drop cap = huruf PERTAMA dari nama kota (mis. "C" dari "CIAMIS")
  // Dateline label = sisa kota + dash (mis. "IAMIS —")
  const datelineMatch = html.match(/^([A-Z\u00C0-\u017E]{3,20})\s*[\u002D\u2013\u2014]\s*/u);
  if (datelineMatch) {
    const city = datelineMatch[1];               // "CIAMIS"
    const rest = html.slice(datelineMatch[0].length); // teks setelah "CIAMIS – "
    const dropLetter = city.charAt(0);           // "C"  ← drop cap
    const restCity   = city.slice(1);            // "IAMIS"
    return {
      html: `<span class="dc-dropcap">${dropLetter}</span><span class="dc-city">${restCity} —</span> ${rest}`,
      isBlockquote: false,
    };
  }

  // No dateline: apply drop cap to first letter
  if (para.isBlockquote) return para;
  const firstLetter = html.match(/^([A-Za-z\u00C0-\u017E])/);
  if (firstLetter) {
    return {
      html: `<span class="dc-dropcap">${firstLetter[1]}</span>${html.slice(firstLetter[1].length)}`,
      isBlockquote: false,
    };
  }

  return para;
}

const parsedParagraphs = parseArticleContent(rawContent).map((p, i) =>
  injectDropcapDateline(p, i)
);

// Sidebar data
const otherArticles = allArticles.filter(a => a.slug !== article.slug);

const terpopuler = [...otherArticles]
  .sort((a, b) => {
    const scoreA = (a.unggulan ? 2 : 0) + (a.headline ? 1 : 0);
    const scoreB = (b.unggulan ? 2 : 0) + (b.headline ? 1 : 0);
    if (scoreB !== scoreA) return scoreB - scoreA;
    return new Date(b.tanggal || 0).getTime() - new Date(a.tanggal || 0).getTime();
  })
  .slice(0, 5);

const sameCat = otherArticles.filter(
  a => a.kategori && a.kategori.toLowerCase() === (article.kategori || '').toLowerCase()
);
const beritaTerkait = [
  ...sameCat,
  ...otherArticles.filter(a => !sameCat.some(s => s.slug === a.slug)),
].slice(0, 4);

const bacaJuga = otherArticles.slice(0, 3);

// Stats view counter
const statsEndpoint =
  import.meta.env.PUBLIC_STATS_API_URL || import.meta.env.PUBLIC_NEWS_API_URL || '';
---

<MainLayout
  title={article.judul}
  description={articleDescription}
  image={article.url_foto || undefined}
  type="article"
  publishedTime={article.tanggal ? new Date(article.tanggal).toISOString() : undefined}
  author={article.penulis || 'Humas MA Margajaya'}
  breadcrumbs={breadcrumbs}
  showHeader={false}
>
  {/* Google Fonts: Newsreader (editorial serif) */}
  <link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin slot="head" />
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,300;1,6..72,400;1,6..72,600&display=swap"
    slot="head"
  />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,300;1,6..72,400;1,6..72,600&display=swap"
    slot="head"
  />
  {statsEndpoint && <meta slot="head" name="vc-endpoint" content={statsEndpoint} />}
  <meta slot="head" name="vc-slug" content={article.slug} />

  <!-- ===================================================
       TOP NAV: Minimal back bar (no global header/navbar)
       =================================================== -->
  <header class="no-print art-topbar">
    <div class="art-topbar-inner">
      <!-- Back button -->
      <a href="/berita" class="art-back-btn" aria-label="Kembali ke daftar berita">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        <span>Berita</span>
      </a>

      <!-- Wordmark: logo MA + logo Ponpes -->
      <a href="/" class="art-wordmark" tabindex="-1">
        <img src="/logo/logo-ma-margajaya-sm.png" alt="" width="22" height="20" aria-hidden="true" />
        <img src="/logo/logo-ponpes-darul-muawanah-sm.png" alt="" width="22" height="22" aria-hidden="true" class="art-logo-ponpes" />
        <span>MA Margajaya</span>
      </a>

      <!-- Share quick action -->
      <button id="top-share-btn" type="button" class="art-share-btn" title="Bagikan artikel ini" aria-label="Bagikan artikel">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
        </svg>
      </button>
    </div>
  </header>

  <!-- Print header (visible only on print) -->
  <div class="print-only art-print-header">
    <p class="art-print-school">MADRASAH ALIYAH MARGAJAYA SUKADANA · CIAMIS · JAWA BARAT</p>
    <p class="art-print-label">DOKUMEN WARTA RESMI</p>
  </div>

  <!-- ===================================================
       MAIN EDITORIAL PAGE
       =================================================== -->
  <div class="art-page">
    <div class="art-container">

      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="no-print art-breadcrumb">
        <ol>
          <li><a href="/">Beranda</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/berita">Berita</a></li>
          {article.kategori && (
            <>
              <li aria-hidden="true">/</li>
              <li>
                <a href={`/berita/topik/${encodeURIComponent(article.kategori.toLowerCase().replace(/\s+/g, '-'))}`}>
                  {article.kategori}
                </a>
              </li>
            </>
          )}
        </ol>
      </nav>

      <!-- Section Label -->
      <div class="art-section-label">
        <span>{article.kategori || 'WARTA RESMI'}</span>
      </div>

      <!-- H1: Judul -->
      <h1 class="art-title">{article.judul}</h1>

      <!-- Byline bar -->
      <div class="art-byline">
        <div class="art-byline-left">
          <span class="art-byline-author">{article.penulis || 'Humas MA Margajaya'}</span>
          <span class="art-byline-sep" aria-hidden="true">·</span>
          <time datetime={article.tanggal || undefined} class="art-byline-date">{formattedDate}</time>
          <span class="art-byline-sep" aria-hidden="true">·</span>
          <span class="art-byline-read">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 7v5l3 3"/>
            </svg>
            {readingTime}
          </span>
        </div>
        <div class="art-byline-actions no-print">
          <!-- WhatsApp -->
          <a
            href={`https://api.whatsapp.com/send?text=${encodeURIComponent(article.judul + ' ' + articleUrl)}`}
            target="_blank" rel="noopener noreferrer"
            aria-label="Bagikan ke WhatsApp" title="WhatsApp"
            class="art-action-icon"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>
          <!-- Facebook -->
          <a
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(articleUrl)}`}
            target="_blank" rel="noopener noreferrer"
            aria-label="Bagikan ke Facebook" title="Facebook"
            class="art-action-icon"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <!-- X / Twitter -->
          <a
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(article.judul)}&url=${encodeURIComponent(articleUrl)}`}
            target="_blank" rel="noopener noreferrer"
            aria-label="Bagikan ke X" title="X"
            class="art-action-icon"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <!-- Copy link -->
          <button id="btn-copy-slug" type="button" aria-label="Salin tautan" title="Salin tautan" class="art-action-icon art-copy-btn">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
            </svg>
            <span id="copy-tip" class="art-copy-tip" aria-live="polite">Tersalin ✓</span>
          </button>
          <!-- Print -->
          <button type="button" onclick="window.print()" aria-label="Cetak artikel" title="Cetak" class="art-action-icon">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/><rect x="6" y="14" width="12" height="8"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Hero Image -->
      {article.url_foto && (
        <figure class="art-hero-figure">
          <img
            src={formatDriveImageUrl(article.url_foto, 1200)}
            alt={article.judul}
            referrerpolicy="no-referrer"
            loading="eager"
            width="1200"
            height="750"
            onerror="this.onerror=null; this.src='/og-default.png';"
            class="art-hero-img"
          />
          <figcaption class="art-hero-caption">
            <span>Dokumentasi Resmi Civitas Akademika MA Margajaya Sukadana</span>
            <span class="art-hero-credit">Foto: Tim Redaksi</span>
          </figcaption>
        </figure>
      )}

      <!-- =============================================
           Article Body: 2-col on desktop
           ============================================= -->
      <div class="art-body-grid">

        <!-- Main article column -->
        <article id="article-main" class="art-main-col">
          <div class="art-prose">
            {parsedParagraphs.map((para, idx) =>
              para.isBlockquote ? (
                <blockquote class="art-pullquote">
                  <p set:html={para.html} />
                </blockquote>
              ) : (
                <p class={idx === 0 ? 'art-first-para' : undefined} set:html={para.html} />
              )
            )}
          </div>

          <!-- Article Footer: tags + share text bar -->
          <footer class="art-article-footer">
            {article.kategori && (
              <div class="art-tags">
                <span class="art-tags-label">Kategori:</span>
                <a
                  href={`/berita/topik/${encodeURIComponent(article.kategori.toLowerCase().replace(/\s+/g, '-'))}`}
                  class="art-tag"
                >
                  {article.kategori}
                </a>
              </div>
            )}
            <div class="art-share-text no-print">
              <span class="art-share-label">Bagikan:</span>
              <a href={`https://api.whatsapp.com/send?text=${encodeURIComponent(article.judul + ' ' + articleUrl)}`} target="_blank" rel="noopener noreferrer" class="art-share-link">WhatsApp</a>
              <span class="art-share-dot" aria-hidden="true">·</span>
              <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(articleUrl)}`} target="_blank" rel="noopener noreferrer" class="art-share-link">Facebook</a>
              <span class="art-share-dot" aria-hidden="true">·</span>
              <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(article.judul)}&url=${encodeURIComponent(articleUrl)}`} target="_blank" rel="noopener noreferrer" class="art-share-link">X</a>
              <span class="art-share-dot" aria-hidden="true">·</span>
              <button id="btn-copy-text" type="button" class="art-share-link art-share-copy">Salin tautan</button>
            </div>
          </footer>
        </article>

        <!-- Sidebar -->
        <aside class="art-sidebar no-print" aria-label="Artikel lainnya">
          <!-- Terpopuler -->
          {terpopuler.length > 0 && (
            <section class="art-sidebar-card">
              <div class="art-sidebar-heading">
                <h2>Terpopuler</h2>
                <span class="art-sidebar-dot" aria-hidden="true"></span>
              </div>
              <ol class="art-popular-list">
                {terpopuler.map((item, index) => (
                  <li class="art-popular-item">
                    <span class="art-popular-num">{String(index + 1).padStart(2, '0')}</span>
                    <div class="art-popular-text">
                      <a href={`/berita/${item.slug}`} class="art-popular-title">{item.judul}</a>
                      <time class="art-popular-date">{formatIndonesianDate(item.tanggal)}</time>
                    </div>
                  </li>
                ))}
              </ol>
            </section>
          )}

          <!-- Berita Terkait -->
          {beritaTerkait.length > 0 && (
            <section class="art-sidebar-card">
              <div class="art-sidebar-heading">
                <h2>Berita Terkait</h2>
                <span class="art-sidebar-dot art-sidebar-dot--gold" aria-hidden="true"></span>
              </div>
              <ul class="art-related-list">
                {beritaTerkait.map(item => (
                  <li class="art-related-item">
                    <a href={`/berita/${item.slug}`} class="art-related-title">{item.judul}</a>
                    <div class="art-related-meta">
                      {item.kategori && <span class="art-related-cat">{item.kategori}</span>}
                      <span class="art-related-date">{formatIndonesianDate(item.tanggal)}</span>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </aside>
      </div>

      <!-- Baca Juga: 3 kartu -->
      {bacaJuga.length > 0 && (
        <section class="art-read-more no-print">
          <div class="art-section-header">
            <h2 class="art-section-title">Baca Juga</h2>
            <a href="/berita" class="art-section-all">Semua berita →</a>
          </div>
          <div class="art-cards-grid">
            {bacaJuga.map((item, idx) => (
              <article class={`art-card ${idx > 0 ? 'art-card--border' : ''}`}>
                {item.url_foto ? (
                  <a href={`/berita/${item.slug}`} class="art-card-img-wrap">
                    <img
                      src={formatDriveImageUrl(item.url_foto, 600)}
                      alt={item.judul}
                      referrerpolicy="no-referrer"
                      loading="lazy"
                      width="600"
                      height="400"
                      onerror="this.onerror=null; this.src='/og-default.png';"
                      class="art-card-img"
                    />
                  </a>
                ) : (
                  <div class="art-card-img-placeholder">
                    <span>MA Margajaya</span>
                  </div>
                )}
                <div class="art-card-body">
                  <span class="art-card-cat">{item.kategori || 'Warta'}</span>
                  <h3 class="art-card-title">
                    <a href={`/berita/${item.slug}`}>{item.judul}</a>
                  </h3>
                  <time class="art-card-date">{formatIndonesianDate(item.tanggal)}</time>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

    </div><!-- /art-container -->
  </div><!-- /art-page -->

  <ContactSection />
</MainLayout>

