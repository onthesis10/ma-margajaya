      margin-top: 0.25rem;
      color: #555;
    }

    .art-page { background: white !important; padding: 0 !important; }
    .art-container { max-width: 100% !important; padding: 0 !important; }

    .art-body-grid {
      display: block !important;
    }

    article#article-main {
      max-width: 100% !important;
    }

    .art-prose {
      font-size: 11pt !important;
      color: black !important;
      line-height: 1.7 !important;
    }

    .dc-dropcap { color: black !important; }
