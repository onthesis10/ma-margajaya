<style>
  /* Sidebar tab switch */
  .sidebar-tab[aria-selected="true"] {
    @apply text-emerald-800 border-b-2 border-emerald-800 bg-emerald-50/60;
  }
  .sidebar-tab[aria-selected="false"] {
    @apply text-ink-muted border-b-2 border-transparent;
  }
</style>

<script is:inline>
  function switchTab(which) {
    var tabs   = ['terbaru', 'terpopuler'];
    tabs.forEach(function(t) {
      var btn   = document.getElementById('tab-' + t);
      var panel = document.getElementById('panel-' + t);
      var active = (t === which);
      if (btn)   btn.setAttribute('aria-selected', active ? 'true' : 'false');
      if (panel) panel.classList.toggle('hidden', !active);
    });
  }
</script>
