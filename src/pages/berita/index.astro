---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import {
  fetchNewsArticles,
  formatIndonesianDate,
  estimateReadingTime,
  getArticleExcerpt,
  stripHtml,
} from '../../lib/news';
import {
  rankArticles,
  buildTopicList,
  rankSidebarPopular,
  type StatsPayload,
} from '../../lib/trending';

// ── Ambil data ──────────────────────────────────────────────────────────────
const articles = await fetchNewsArticles();

// Ambil statistik saat build (opsional — jika gagal, fallback ke kebaruan)
const statsApiUrl =
  import.meta.env.PUBLIC_STATS_API_URL ||
  import.meta.env.PUBLIC_NEWS_API_URL ||
  '';

let buildStats: StatsPayload | null = null;
if (statsApiUrl) {
  try {
    const res = await fetch(statsApiUrl + '?action=stats', {
      signal: AbortSignal.timeout(8000),
    });
    if (res.ok) {
      const json = await res.json();
      if (json.status === 'success') buildStats = json as StatsPayload;
    }
  } catch (_) {
    // gagal ambil stats — tidak masalah, fallback terbaru
  }
}

// ── Ranking ─────────────────────────────────────────────────────────────────
const { hero, editorial, terbaru, mostWatched, popular, all } = rankArticles(
  articles,
  buildStats,
  new Date(),
);

// Sidebar
const sidebarRecent  = articles.slice(0, 6);
const sidebarPopular = rankSidebarPopular(articles, buildStats, 6);

// Topik
const topics = buildTopicList(articles);

// Helper: format jumlah dibaca
function formatViews(slug: string): string | null {
  if (!buildStats?.items) return null;
  const s = buildStats.items.find(i => i.slug === slug);
  if (!s || s.v7d < 100) return null; // hanya tampil jika ≥ 100
  return s.v7d >= 1000
    ? (s.v7d / 1000).toFixed(1).replace('.0', '') + ' rb'
    : String(s.v7d);
}

const breadcrumbs = [{ label: 'Berita', href: '/berita' }];

// URL endpoint statistik untuk news-live.ts di browser
const statsEndpoint = statsApiUrl;
---

<PageLayout
  title="Portal Berita — MA Margajaya"
  description="Portal berita dan publikasi resmi MA Margajaya Sukadana, Ciamis. Warta terkini, kegiatan madrasah, prestasi santri, dan pengumuman resmi civitas akademika."
  breadcrumbs={breadcrumbs}
>
  {/* Meta untuk news-live.ts */}
  {statsEndpoint && (
    <meta slot="head" name="stats-endpoint" content={statsEndpoint} />
  )}

  <main class="bg-paper min-h-screen">
    <Container>
      <div class="py-10 lg:py-14">

        {articles.length === 0 ? (
          /* ── KOSONG ──────────────────────────────────────────────────── */
          <div class="py-24 text-center rounded-3xl bg-white border border-hair shadow-sm">
            <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-emerald-50 text-emerald-700 flex items-center justify-center border border-emerald-100">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
              </svg>
            </div>
            <h2 class="font-serif text-2xl font-bold text-slate-800">Belum Ada Warta Diterbitkan</h2>
            <p class="text-sm text-slate-500 mt-2 max-w-md mx-auto leading-relaxed">
              Belum ada publikasi resmi yang diterbitkan. Silakan periksa kembali di kemudian hari.
            </p>
          </div>
        ) : (
          <div class="grid grid-cols-1 xl:grid-cols-[1fr_320px] gap-10 xl:gap-14">

            {/* ════════════════════════════════════════════════════════════
                AREA UTAMA (kiri)
                ════════════════════════════════════════════════════════════ */}
            <div class="space-y-14 min-w-0">

              {/* ── SOROTAN UTAMA (Hero) ──────────────────────────────── */}
              {hero && (
                <section aria-labelledby="hero-heading">
                  <div class="flex items-center gap-3 mb-5">
                    <span class="w-1 h-6 bg-emerald-800 rounded-full inline-block"></span>
                    <h2 id="hero-heading" class="font-serif text-xl font-bold text-blue-ink tracking-tight">Sorotan Utama</h2>
                  </div>
                  <a
                    href={`/berita/${hero.slug}`}
                    class="group block rounded-2xl overflow-hidden border border-hair bg-white shadow-sm hover:shadow-xl hover:border-emerald-400 transition-all duration-300"
                    data-slug={hero.slug}
                  >
                    <div class="grid grid-cols-1 lg:grid-cols-12">
                      {/* Gambar */}
                      <div class="lg:col-span-7 relative overflow-hidden bg-emerald-950">
                        {hero.url_foto ? (
                          <img
                            src={hero.url_foto}
                            alt={hero.judul}
                            referrerpolicy="no-referrer"
                            loading="eager"
                            width="900"
                            height="563"
                            class="w-full h-[280px] lg:h-[420px] object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                          />
                        ) : (
                          <div class="w-full h-[280px] lg:h-[420px] flex items-center justify-center bg-gradient-to-br from-emerald-950 to-slate-900 text-white font-serif text-2xl font-bold">
                            MA Margajaya
                          </div>
                        )}
                        {/* Gradient scrim */}
                        <div class="absolute inset-0 bg-gradient-to-t from-emerald-950/80 via-transparent to-transparent pointer-events-none lg:hidden"></div>
                        {/* Kategori badge */}
                        {hero.kategori && (
                          <span class="absolute top-4 left-4 px-2.5 py-1 bg-emerald-800 text-white text-[10px] font-bold uppercase tracking-wider rounded-full">
                            {hero.kategori}
                          </span>
                        )}
                      </div>
                      {/* Teks */}
                      <div class="lg:col-span-5 p-6 sm:p-8 flex flex-col justify-center gap-4">
                        <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500">
                          <span class="px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-[10px] font-bold uppercase tracking-wider border border-emerald-100">
                            {hero.kategori || 'Liputan Utama'}
                          </span>
                          <span class="text-slate-300" aria-hidden="true">•</span>
                          <time datetime={hero.tanggal} class="font-medium text-slate-600">
                            {formatIndonesianDate(hero.tanggal)}
                          </time>
                        </div>
                        <h3 class="font-serif text-2xl sm:text-3xl font-bold text-blue-ink leading-snug group-hover:text-emerald-800 transition-colors">
                          {hero.judul}
                        </h3>
                        <p class="text-sm text-ink-soft leading-relaxed line-clamp-4">
                          {getArticleExcerpt(hero.isi, 260)}
                        </p>
                        <div class="pt-3 flex items-center justify-between border-t border-hair text-xs">
                          <span class="font-semibold text-slate-700">{hero.penulis || 'Humas MA Margajaya'}</span>
                          <span class="inline-flex items-center gap-1.5 font-bold text-emerald-800 group-hover:text-emerald-950 uppercase tracking-wider text-[11px]">
                            Baca Selengkapnya →
                          </span>
                        </div>
                      </div>
                    </div>
                  </a>
                </section>
              )}

              {/* ── BERITA TERBARU ────────────────────────────────────── */}
              {terbaru.length > 0 && (
                <section aria-labelledby="terbaru-heading">
                  <div class="flex items-center justify-between mb-5">
                    <div class="flex items-center gap-3">
                      <span class="w-1 h-6 bg-emerald-800 rounded-full inline-block"></span>
                      <h2 id="terbaru-heading" class="font-serif text-xl font-bold text-blue-ink tracking-tight">Berita Terbaru</h2>
                    </div>
                    <a href="/berita" class="text-xs font-bold text-emerald-800 hover:text-emerald-950 uppercase tracking-wider border-b border-emerald-800 pb-0.5 transition-colors">
                      Lihat Semua →
                    </a>
                  </div>
                  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
                    {terbaru.map(item => (
                      <a
                        href={`/berita/${item.slug}`}
                        class="group flex flex-col rounded-xl overflow-hidden border border-hair bg-white hover:border-emerald-400 shadow-sm hover:shadow-lg transition-all duration-300"
                        data-slug={item.slug}
                      >
                        <div class="aspect-[16/10] overflow-hidden bg-emerald-950 relative">
                          {item.url_foto ? (
                            <img
                              src={item.url_foto}
                              alt={item.judul}
                              referrerpolicy="no-referrer"
                              loading="lazy"
                              width="480"
                              height="300"
                              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                            />
                          ) : (
                            <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-emerald-950 to-slate-900 text-white font-serif text-sm font-bold">
                              MA Margajaya
                            </div>
                          )}
                          {item.kategori && (
                            <span class="absolute top-2 left-2 px-2 py-0.5 bg-black/60 text-white text-[9px] font-bold uppercase tracking-wider rounded backdrop-blur-sm">
                              {item.kategori}
                            </span>
                          )}
                        </div>
                        <div class="p-4 flex flex-col gap-2 flex-1">
                          <time datetime={item.tanggal} class="text-[10px] font-semibold text-emerald-800 uppercase tracking-wider">
                            {formatIndonesianDate(item.tanggal)}
                          </time>
                          <h3 class="font-serif text-base font-bold text-blue-ink group-hover:text-emerald-800 transition-colors leading-snug line-clamp-2 flex-1">
                            {item.judul}
                          </h3>
                          <p class="text-xs text-ink-muted line-clamp-2 leading-relaxed">
                            {getArticleExcerpt(item.isi, 120)}
                          </p>
                          <div class="pt-2 border-t border-hair flex items-center justify-between text-[10px] font-semibold text-emerald-800">
                            <span>Oleh {item.penulis || 'Humas'}</span>
                            <span class="group-hover:translate-x-1 transition-transform inline-block">→</span>
                          </div>
                        </div>
                      </a>
                    ))}
                  </div>
                </section>
              )}

              {/* ── PILIHAN REDAKSI ───────────────────────────────────── */}
              {editorial && (
                <section aria-labelledby="editorial-heading">
                  <div class="flex items-center gap-3 mb-5">
                    <span class="w-1 h-6 bg-gold rounded-full inline-block"></span>
                    <h2 id="editorial-heading" class="font-serif text-xl font-bold text-blue-ink tracking-tight">Pilihan Redaksi</h2>
                  </div>
                  <a
                    href={`/berita/${editorial.slug}`}
                    class="group flex flex-col sm:flex-row gap-0 rounded-2xl overflow-hidden border border-hair bg-white hover:border-gold/70 shadow-sm hover:shadow-xl transition-all duration-300"
                    data-slug={editorial.slug}
                  >
                    <div class="sm:w-2/5 relative overflow-hidden bg-emerald-950 flex-shrink-0">
                      {editorial.url_foto ? (
                        <img
                          src={editorial.url_foto}
                          alt={editorial.judul}
                          referrerpolicy="no-referrer"
                          loading="lazy"
                          width="560"
                          height="420"
                          class="w-full h-[220px] sm:h-full object-cover group-hover:scale-105 transition-transform duration-700"
                        />
                      ) : (
                        <div class="w-full h-[220px] sm:h-full flex items-center justify-center bg-gradient-to-br from-emerald-950 to-slate-900 text-white font-serif text-xl font-bold">
                          MA Margajaya
                        </div>
                      )}
                    </div>
                    <div class="sm:w-3/5 p-6 sm:p-8 flex flex-col justify-center gap-4">
                      <div class="flex items-center gap-2">
                        <span class="px-2.5 py-1 bg-gold/10 text-amber-800 text-[10px] font-bold uppercase tracking-wider rounded border border-gold/30">
                          ✦ Pilihan Redaksi
                        </span>
                        {editorial.kategori && (
                          <span class="text-[10px] font-semibold text-ink-muted uppercase tracking-wider">{editorial.kategori}</span>
                        )}
                      </div>
                      <h3 class="font-serif text-2xl sm:text-3xl font-bold text-blue-ink leading-snug group-hover:text-emerald-800 transition-colors">
                        {editorial.judul}
                      </h3>
                      <p class="text-sm text-ink-soft leading-relaxed line-clamp-4">
                        {getArticleExcerpt(editorial.isi, 300)}
                      </p>
                      <div class="pt-3 flex items-center justify-between border-t border-hair text-xs">
                        <div class="flex items-center gap-2 text-slate-500">
                          <time datetime={editorial.tanggal}>{formatIndonesianDate(editorial.tanggal)}</time>
                          <span aria-hidden="true">·</span>
                          <span>{estimateReadingTime(editorial.isi)}</span>
                        </div>
                        <span class="font-bold text-emerald-800 group-hover:text-emerald-950 uppercase tracking-wider text-[11px]">
                          Baca Selengkapnya →
                        </span>
                      </div>
                    </div>
                  </a>
                </section>
              )}

              {/* ── PALING BANYAK DIBACA ──────────────────────────────── */}
              {mostWatched.length > 0 && (
                <section aria-labelledby="mostwatched-heading">
                  <div class="flex items-center gap-3 mb-5">
                    <span class="w-1 h-6 bg-red-600 rounded-full inline-block"></span>
                    <h2 id="mostwatched-heading" class="font-serif text-xl font-bold text-blue-ink tracking-tight">Paling Banyak Dibaca</h2>
                  </div>
                  <div
                    class="grid grid-cols-1 sm:grid-cols-2 gap-5"
                    data-live="mostwatched"
                  >
                    {mostWatched.map(item => {
                      const views = formatViews(item.slug);
                      return (
                        <a
                          href={`/berita/${item.slug}`}
                          class="group flex gap-4 p-4 rounded-xl border border-hair bg-white hover:border-emerald-400 shadow-sm hover:shadow-lg transition-all duration-300"
                          data-slug={item.slug}
                        >
                          <div class="w-28 h-20 flex-shrink-0 rounded-lg overflow-hidden bg-emerald-950">
                            {item.url_foto ? (
                              <img
                                src={item.url_foto}
                                alt={item.judul}
                                referrerpolicy="no-referrer"
                                loading="lazy"
                                width="112"
                                height="80"
                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                              />
                            ) : (
                              <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-emerald-950 to-slate-900 text-white font-serif text-xs font-bold">MA</div>
                            )}
                          </div>
                          <div class="flex-1 min-w-0 space-y-1.5">
                            {views && (
                              <div class="flex items-center gap-1 text-[10px] font-bold text-red-600">
                                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                                  <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
                                  <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>
                                </svg>
                                <span>{views} dibaca</span>
                              </div>
                            )}
                            <h3 class="font-serif text-sm font-bold text-blue-ink group-hover:text-emerald-800 transition-colors line-clamp-2 leading-snug">
                              {item.judul}
                            </h3>
                            <time datetime={item.tanggal} class="text-[10px] text-ink-muted block">
                              {formatIndonesianDate(item.tanggal)}
                            </time>
                          </div>
                        </a>
                      );
                    })}
                  </div>
                </section>
              )}

              {/* ── POPULER (Grid 2×2) ────────────────────────────────── */}
              {popular.length > 0 && (
                <section aria-labelledby="popular-heading">
                  <div class="flex items-center gap-3 mb-5">
                    <span class="w-1 h-6 bg-blue-600 rounded-full inline-block"></span>
                    <h2 id="popular-heading" class="font-serif text-xl font-bold text-blue-ink tracking-tight">Populer</h2>
                  </div>
                  <div
                    class="grid grid-cols-1 sm:grid-cols-2 gap-5"
                    data-live="popular"
                  >
                    {popular.map(item => {
                      const views = formatViews(item.slug);
                      return (
                        <a
                          href={`/berita/${item.slug}`}
                          class="group rounded-xl overflow-hidden border border-hair bg-white hover:border-emerald-400 shadow-sm hover:shadow-lg transition-all duration-300"
                          data-slug={item.slug}
                        >
                          <div class="aspect-[16/9] overflow-hidden bg-emerald-950 relative">
                            {item.url_foto ? (
                              <img
                                src={item.url_foto}
                                alt={item.judul}
                                referrerpolicy="no-referrer"
                                loading="lazy"
                                width="480"
                                height="270"
                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                              />
                            ) : (
                              <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-emerald-950 to-slate-900 text-white font-serif text-sm font-bold">MA Margajaya</div>
                            )}
                            {views && (
                              <div class="absolute bottom-2 right-2 flex items-center gap-1 px-2 py-0.5 rounded-full bg-black/60 text-white text-[9px] font-bold backdrop-blur-sm">
                                <svg class="w-2.5 h-2.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                                  <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
                                  <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>
                                </svg>
                                {views}
                              </div>
                            )}
                          </div>
                          <div class="p-4 space-y-1.5">
                            {item.kategori && (
                              <span class="text-[10px] font-bold text-emerald-800 uppercase tracking-wider">{item.kategori}</span>
                            )}
                            <h3 class="font-serif text-base font-bold text-blue-ink group-hover:text-emerald-800 transition-colors leading-snug line-clamp-2">
                              {item.judul}
                            </h3>
                            <time datetime={item.tanggal} class="text-[10px] text-ink-muted block">
                              {formatIndonesianDate(item.tanggal)}
                            </time>
                          </div>
                        </a>
                      );
                    })}
                  </div>
                </section>
              )}

            </div>
            {/* ════════════════════════════════════════════════════════════
                SIDEBAR (kanan)
                ════════════════════════════════════════════════════════════ */}
            <aside class="space-y-8" aria-label="Sidebar berita">

              {/* ── Tab Terbaru / Terpopuler ──────────────────────────── */}
              <div class="rounded-2xl border border-hair bg-white shadow-sm overflow-hidden">
                {/* Tab header */}
                <div class="flex border-b border-hair" role="tablist" aria-label="Pilih tampilan">
                  <button
                    id="tab-terbaru"
                    role="tab"
                    aria-selected="true"
                    aria-controls="panel-terbaru"
                    class="sidebar-tab flex-1 py-3 text-xs font-bold uppercase tracking-wider text-emerald-800 border-b-2 border-emerald-800 bg-emerald-50/60 transition-colors"
                    onclick="switchTab('terbaru')"
                  >
                    Terbaru
                  </button>
                  <button
                    id="tab-terpopuler"
                    role="tab"
                    aria-selected="false"
                    aria-controls="panel-terpopuler"
                    class="sidebar-tab flex-1 py-3 text-xs font-bold uppercase tracking-wider text-ink-muted hover:text-emerald-800 border-b-2 border-transparent hover:border-emerald-200 transition-colors"
                    onclick="switchTab('terpopuler')"
                  >
                    Terpopuler
                  </button>
                </div>
                {/* Panel Terbaru */}
                <div id="panel-terbaru" role="tabpanel" aria-labelledby="tab-terbaru" class="divide-y divide-hair">
                  {sidebarRecent.map(item => (
                    <a href={`/berita/${item.slug}`} class="flex gap-3 p-3 hover:bg-emerald-50/50 transition-colors group">
                      <div class="w-14 h-14 flex-shrink-0 rounded-lg overflow-hidden bg-emerald-950">
                        {item.url_foto ? (
                          <img
                            src={item.url_foto}
                            alt={item.judul}
                            referrerpolicy="no-referrer"
                            loading="lazy"
                            width="56"
                            height="56"
                            class="w-full h-full object-cover"
                          />
                        ) : (
                          <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-emerald-950 to-slate-900 text-white font-serif text-[10px] font-bold">MA</div>
                        )}
                      </div>
                      <div class="flex-1 min-w-0">
                        <time datetime={item.tanggal} class="text-[9px] font-semibold text-emerald-800 uppercase tracking-wider block">{formatIndonesianDate(item.tanggal)}</time>
                        <h3 class="font-serif text-xs font-bold text-blue-ink group-hover:text-emerald-800 transition-colors leading-snug line-clamp-2 mt-0.5">{item.judul}</h3>
                      </div>
                    </a>
                  ))}
                </div>
                {/* Panel Terpopuler */}
                <div id="panel-terpopuler" role="tabpanel" aria-labelledby="tab-terpopuler" class="divide-y divide-hair hidden" data-live="sidebar-popular">
                  {sidebarPopular.map(item => {
                    const views = formatViews(item.slug);
                    return (
                      <a href={`/berita/${item.slug}`} class="flex gap-3 p-3 hover:bg-emerald-50/50 transition-colors group" data-slug={item.slug}>
                        <div class="w-14 h-14 flex-shrink-0 rounded-lg overflow-hidden bg-emerald-950">
                          {item.url_foto ? (
                            <img
                              src={item.url_foto}
                              alt={item.judul}
                              referrerpolicy="no-referrer"
                              loading="lazy"
                              width="56"
                              height="56"
                              class="w-full h-full object-cover"
                            />
                          ) : (
                            <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-emerald-950 to-slate-900 text-white font-serif text-[10px] font-bold">MA</div>
                          )}
                        </div>
                        <div class="flex-1 min-w-0">
                          {views && (
                            <span class="text-[9px] font-bold text-red-600 flex items-center gap-1">
                              <svg class="w-2.5 h-2.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/><path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/></svg>
                              {views} dibaca
                            </span>
                          )}
                          <h3 class="font-serif text-xs font-bold text-blue-ink group-hover:text-emerald-800 transition-colors leading-snug line-clamp-2 mt-0.5">{item.judul}</h3>
                        </div>
                      </a>
                    );
                  })}
                  {sidebarPopular.length === 0 && (
                    <p class="p-4 text-xs text-ink-muted">Belum ada data kunjungan.</p>
                  )}
                </div>
              </div>

              {/* ── Pilih Topik ───────────────────────────────────────── */}
