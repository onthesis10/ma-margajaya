---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import {
  fetchNewsArticles,
  formatIndonesianDate,
  estimateReadingTime,
  getArticleExcerpt,
  stripHtml,
} from '../../lib/news';
import {
  rankArticles,
  buildTopicList,
  rankSidebarPopular,
  type StatsPayload,
} from '../../lib/trending';

// ── Ambil data ──────────────────────────────────────────────────────────────
const articles = await fetchNewsArticles();

// Ambil statistik saat build (opsional — jika gagal, fallback ke kebaruan)
const statsApiUrl =
  import.meta.env.PUBLIC_STATS_API_URL ||
  import.meta.env.PUBLIC_NEWS_API_URL ||
  '';

let buildStats: StatsPayload | null = null;
if (statsApiUrl) {
  try {
    const res = await fetch(statsApiUrl + '?action=stats', {
      signal: AbortSignal.timeout(8000),
    });
    if (res.ok) {
      const json = await res.json();
      if (json.status === 'success') buildStats = json as StatsPayload;
    }
  } catch (_) {
    // gagal ambil stats — tidak masalah, fallback terbaru
  }
}

// ── Ranking ─────────────────────────────────────────────────────────────────
const { hero, editorial, terbaru: rawTerbaru, mostWatched: rawMostWatched, popular: rawPopular, all } = rankArticles(
  articles,
  buildStats,
  new Date(),
);

// Fallback cerdas agar seluruh seksi portal berita terisi penuh dan memukau sesuai desain referensi
const displayHero = hero || (articles.length > 0 ? articles[0] : null);
const displayEditorial = editorial || (articles.length > 1 ? articles[1] : displayHero);
const displayTerbaru = rawTerbaru.length > 0 ? rawTerbaru : articles.slice(0, 3);
const displayMostWatched = rawMostWatched.length > 0 ? rawMostWatched : (articles.length >= 2 ? articles.slice(0, 2) : (displayHero ? [displayHero] : []));
const displayPopular = rawPopular.length > 0 ? rawPopular : (articles.length >= 4 ? articles.slice(0, 4) : articles);
const displayBottom = articles.length > 2 ? articles[2] : (articles.length > 1 ? articles[1] : displayHero);

// Sidebar
const sidebarRecent  = articles.slice(0, 6);
const sidebarPopular = rankSidebarPopular(articles, buildStats, 6);
const sidebarFeature = sidebarPopular[0] || (articles.length > 0 ? articles[0] : null);

// Topik
const topics = buildTopicList(articles);

// Helper: format jumlah dibaca
function formatViews(slug: string): string | null {
  if (!buildStats?.items) return null;
  const s = buildStats.items.find(i => i.slug === slug);
  if (!s || s.v7d < 100) return null; // hanya tampil jika ≥ 100
  return s.v7d >= 1000
    ? (s.v7d / 1000).toFixed(1).replace('.0', '') + ' rb'
    : String(s.v7d);
}

const breadcrumbs = [{ label: 'Berita', href: '/berita' }];
const statsEndpoint = statsApiUrl;
---

<PageLayout
  title="Portal Berita — MA Margajaya"
  description="Portal berita dan publikasi resmi MA Margajaya Sukadana, Ciamis. Warta terkini, kegiatan madrasah, prestasi santri, dan pengumuman resmi civitas akademika."
  breadcrumbs={breadcrumbs}
>
  {/* Meta untuk news-live.ts */}
  {statsEndpoint && (
    <meta slot="head" name="stats-endpoint" content={statsEndpoint} />
  )}

  <main class="bg-white min-h-screen">
    <Container>
      <div class="py-10 sm:py-14">

        {articles.length === 0 ? (
          /* ── KOSONG ──────────────────────────────────────────────────── */
          <div class="py-24 text-center rounded-3xl bg-white border border-slate-200 shadow-sm">
            <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-emerald-50 text-emerald-700 flex items-center justify-center border border-emerald-100">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
              </svg>
            </div>
            <h2 class="font-serif text-2xl font-bold text-slate-800">Belum Ada Warta Diterbitkan</h2>
            <p class="text-sm text-slate-500 mt-2 max-w-md mx-auto leading-relaxed">
              Belum ada publikasi resmi yang diterbitkan. Silakan periksa kembali di kemudian hari.
            </p>
          </div>
        ) : (
          <div class="space-y-14 sm:space-y-16">

            {/* ════════════════════════════════════════════════════════════
                1. SOROTAN UTAMA (HERO BESAR — FULL WIDTH SESUAI REFERENSI)
                ════════════════════════════════════════════════════════════ */}
            {displayHero && (
              <section aria-label="Sorotan Utama">
                <a
                  href={`/berita/${displayHero.slug}`}
                  class="group relative block w-full rounded-2xl sm:rounded-3xl overflow-hidden aspect-[16/9] sm:aspect-[21/9] min-h-[380px] sm:min-h-[460px] lg:min-h-[520px] bg-slate-950 shadow-md hover:shadow-2xl transition-all duration-500"
                  data-slug={displayHero.slug}
                >
                  {displayHero.url_foto ? (
                    <img
                      src={displayHero.url_foto}
                      alt={displayHero.judul}
                      referrerpolicy="no-referrer"
                      loading="eager"
                      width="1280"
                      height="640"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-emerald-950 via-slate-900 to-emerald-900 text-white font-serif text-2xl font-bold">
                      MA Margajaya
                    </div>
                  )}

                  {/* Dark gradient overlay bottom */}
                  <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/55 to-transparent flex flex-col justify-end p-6 sm:p-10 lg:p-14">
                    <div class="max-w-4xl space-y-3">
                      {displayHero.kategori && (
                        <span class="inline-block px-3 py-1 rounded-full bg-emerald-700/80 backdrop-blur-sm text-gold text-[10px] sm:text-xs font-bold uppercase tracking-wider mb-1">
                          {displayHero.kategori}
                        </span>
                      )}
                      <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-white leading-tight tracking-tight group-hover:text-gold transition-colors">
                        {displayHero.judul}
                      </h2>
                      <p class="text-xs sm:text-sm md:text-base text-white/80 line-clamp-2 sm:line-clamp-3 leading-relaxed max-w-3xl">
                        {getArticleExcerpt(displayHero.isi, 240)}
                      </p>
                      <div class="pt-2">
                        <span class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-gold hover:text-white uppercase tracking-wider transition-colors">
                          Baca Selengkapnya →
                        </span>
                      </div>
                    </div>
                  </div>
                </a>
              </section>
            )}

            {/* ════════════════════════════════════════════════════════════
                2. BERITA TERBARU (NEWS TODAY — FULL WIDTH 3 KOLOM)
                ════════════════════════════════════════════════════════════ */}
            {displayTerbaru.length > 0 && (
              <section aria-labelledby="news-today-heading">
                <div class="flex items-center justify-between pb-3 border-b border-slate-200">
                  <h2 id="news-today-heading" class="font-serif text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
                    Berita Hari Ini
                  </h2>
                  <a href="/berita" class="text-xs sm:text-sm font-semibold text-slate-500 hover:text-emerald-800 transition-colors">
                    Lihat Semua
                  </a>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 mt-6">
                  {displayTerbaru.map(item => (
                    <a href={`/berita/${item.slug}`} class="group flex flex-col" data-slug={item.slug}>
                      <div class="rounded-2xl overflow-hidden aspect-[16/10] bg-slate-100 mb-4 relative shadow-sm group-hover:shadow-md transition-shadow">
                        {item.url_foto ? (
                          <img
                            src={item.url_foto}
                            alt={item.judul}
                            referrerpolicy="no-referrer"
                            loading="lazy"
                            width="600"
                            height="375"
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                          />
                        ) : (
                          <div class="w-full h-full flex items-center justify-center bg-emerald-950 text-white font-serif text-sm font-bold">
                            MA Margajaya
                          </div>
                        )}
                        {item.kategori && (
                          <span class="absolute top-3 left-3 px-2.5 py-0.5 rounded-full bg-black/60 text-white text-[9px] font-bold uppercase tracking-wider backdrop-blur-sm">
                            {item.kategori}
                          </span>
                        )}
                      </div>
                      <h3 class="font-serif text-lg sm:text-xl font-bold text-slate-900 group-hover:text-emerald-800 transition-colors leading-snug line-clamp-2">
                        {item.judul}
                      </h3>
                      <p class="mt-2 text-xs sm:text-sm text-slate-500 line-clamp-3 leading-relaxed flex-1">
                        {getArticleExcerpt(item.isi, 140)}
                      </p>
                      <div class="mt-4 flex items-center justify-between text-xs pt-2 border-t border-slate-100">
                        <time datetime={item.tanggal} class="text-slate-400 font-medium">
                          {formatIndonesianDate(item.tanggal)}
                        </time>
                        <span class="font-bold text-emerald-800 group-hover:text-emerald-950 inline-flex items-center gap-1">
                          Baca Postingan →
                        </span>
                      </div>
                    </a>
                  ))}
                </div>
              </section>
            )}

            {/* ════════════════════════════════════════════════════════════
                3. AREA 2-KOLOM (KONTEN UTAMA KIRI + SIDEBAR KANAN)
                ════════════════════════════════════════════════════════════ */}
            <div class="grid grid-cols-1 lg:grid-cols-[1fr_340px] xl:grid-cols-[1fr_380px] gap-10 xl:gap-14 pt-8 border-t border-slate-200">

              {/* ──────────────────────────────────────────────────────────
                  KOLOM KIRI (MAIN CONTENT)
                  ────────────────────────────────────────────────────────── */}
              <div class="space-y-14 min-w-0">

                {/* ── PILIHAN REDAKSI (EDITORIAL FEATURE) ─────────────── */}
                {displayEditorial && (
                  <section aria-labelledby="editorial-heading" class="space-y-4">
                    <a href={`/berita/${displayEditorial.slug}`} class="group block">
                      <h2 id="editorial-heading" class="font-serif text-2xl sm:text-3xl font-bold text-slate-900 group-hover:text-emerald-800 transition-colors leading-tight mb-4">
                        {displayEditorial.judul}
                      </h2>
                      <div class="rounded-2xl overflow-hidden aspect-[16/9] bg-slate-100 mb-3 shadow-sm group-hover:shadow-md transition-shadow">
                        {displayEditorial.url_foto ? (
                          <img
                            src={displayEditorial.url_foto}
                            alt={displayEditorial.judul}
                            referrerpolicy="no-referrer"
                            loading="lazy"
                            width="800"
                            height="450"
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                          />
                        ) : (
                          <div class="w-full h-full flex items-center justify-center bg-emerald-950 text-white font-serif text-xl font-bold">
                            MA Margajaya
                          </div>
                        )}
                      </div>
                    </a>

                    <p class="text-xs text-slate-400 italic">
                      Dokumentasi liputan redaksi MA Margajaya Sukadana · {formatIndonesianDate(displayEditorial.tanggal)}
                    </p>

                    <p class="text-sm sm:text-base text-slate-600 leading-relaxed line-clamp-4">
                      {getArticleExcerpt(displayEditorial.isi, 320)}
                    </p>

                    <div>
                      <a
                        href={`/berita/${displayEditorial.slug}`}
                        class="inline-flex items-center justify-center px-6 py-2.5 rounded-lg bg-emerald-800 hover:bg-emerald-900 text-white text-xs sm:text-sm font-bold uppercase tracking-wider shadow-sm transition-all"
                      >
                        Baca Selengkapnya
                      </a>
                    </div>
                  </section>
                )}

                {/* ── PALING BANYAK DIBACA (MOST WATCHED) ─────────────── */}
                {displayMostWatched.length > 0 && (
                  <section aria-labelledby="mostwatched-heading">
                    <div class="flex items-center justify-between pb-3 border-b border-slate-200">
                      <h2 id="mostwatched-heading" class="font-serif text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
                        Paling Banyak Dibaca
                      </h2>
                      <a href="/berita" class="text-xs sm:text-sm font-semibold text-slate-500 hover:text-emerald-800 transition-colors">
                        Lihat Semua
                      </a>
                    </div>

                    <div
                      class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-6"
                      data-live="mostwatched"
                    >
                      {displayMostWatched.map(item => {
                        const views = formatViews(item.slug);
                        return (
                          <a href={`/berita/${item.slug}`} class="group flex flex-col" data-slug={item.slug}>
                            <div class="rounded-2xl overflow-hidden aspect-[16/10] bg-slate-100 mb-3 relative shadow-sm group-hover:shadow-md transition-shadow">
                              {item.url_foto ? (
                                <img
                                  src={item.url_foto}
                                  alt={item.judul}
                                  referrerpolicy="no-referrer"
                                  loading="lazy"
                                  width="500"
                                  height="312"
                                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                />
                              ) : (
                                <div class="w-full h-full flex items-center justify-center bg-emerald-950 text-white font-serif text-sm font-bold">
                                  MA Margajaya
                                </div>
                              )}
                              {views && (
                                <span class="absolute top-3 right-3 px-2 py-0.5 rounded-full bg-black/75 backdrop-blur-sm text-gold text-[10px] font-bold">
                                  👁 {views} dibaca
                                </span>
                              )}
                            </div>
                            <div class="flex items-center justify-between text-xs text-slate-500 mb-2">
                              <span class="font-semibold text-slate-700">— {item.penulis || 'Humas'}</span>
                              <time datetime={item.tanggal} class="text-slate-400">
                                📅 {formatIndonesianDate(item.tanggal)}
                              </time>
                            </div>
                            <h3 class="font-serif text-base sm:text-lg font-bold text-slate-900 group-hover:text-emerald-800 transition-colors leading-snug line-clamp-2">
                              {item.judul}
                            </h3>
                          </a>
                        );
                      })}
                    </div>
                  </section>
                )}

                {/* ── POPULER (GRID 2×2) ────────────────────────────────── */}
                {displayPopular.length > 0 && (
                  <section aria-labelledby="popular-heading">
                    <div class="flex items-center justify-between pb-3 border-b border-slate-200">
                      <h2 id="popular-heading" class="font-serif text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
                        Populer
                      </h2>
                      <a href="/berita" class="text-xs sm:text-sm font-semibold text-slate-500 hover:text-emerald-800 transition-colors">
                        Lihat Semua
                      </a>
                    </div>

                    <div
                      class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-6"
                      data-live="popular"
                    >
                      {displayPopular.map(item => (
                        <a href={`/berita/${item.slug}`} class="group flex flex-col" data-slug={item.slug}>
                          <div class="rounded-2xl overflow-hidden aspect-[16/10] bg-slate-100 mb-2.5 relative shadow-sm group-hover:shadow-md transition-shadow">
                            {item.url_foto ? (
                              <img
                                src={item.url_foto}
                                alt={item.judul}
                                referrerpolicy="no-referrer"
                                loading="lazy"
                                width="500"
                                height="312"
                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                              />
                            ) : (
                              <div class="w-full h-full flex items-center justify-center bg-emerald-950 text-white font-serif text-sm font-bold">
                                MA Margajaya
                              </div>
                            )}
                          </div>
                          <time datetime={item.tanggal} class="text-[11px] font-medium text-slate-400 block mb-1">
                            📅 {formatIndonesianDate(item.tanggal)}
                          </time>
                          <h3 class="font-serif text-sm sm:text-base font-bold text-slate-900 group-hover:text-emerald-800 transition-colors leading-snug line-clamp-2">
                            {item.judul}
                          </h3>
                        </a>
                      ))}
                    </div>
                  </section>
                )}

                {/* ── KARTU HORIZONTAL BAWAH (BOTTOM FEATURED) ─────────── */}
                {displayBottom && (
                  <section aria-label="Warta Pilihan">
                    <a
                      href={`/berita/${displayBottom.slug}`}
                      class="group flex flex-col sm:flex-row gap-5 p-5 rounded-2xl bg-white border border-slate-200/80 shadow-sm hover:shadow-md hover:border-emerald-300 transition-all"
                    >
                      <div class="sm:w-2/5 aspect-[16/10] rounded-xl overflow-hidden bg-slate-100 flex-shrink-0">
                        {displayBottom.url_foto ? (
                          <img
                            src={displayBottom.url_foto}
                            alt={displayBottom.judul}
                            referrerpolicy="no-referrer"
                            loading="lazy"
                            width="400"
                            height="250"
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                          />
                        ) : (
                          <div class="w-full h-full flex items-center justify-center bg-emerald-950 text-white font-serif text-sm font-bold">
                            MA Margajaya
                          </div>
                        )}
                      </div>
                      <div class="flex flex-col justify-center">
                        <time datetime={displayBottom.tanggal} class="text-[11px] font-medium text-emerald-800 mb-1 block uppercase tracking-wider">
                          {formatIndonesianDate(displayBottom.tanggal)}
                        </time>
                        <h3 class="font-serif text-lg sm:text-xl font-bold text-slate-900 group-hover:text-emerald-800 transition-colors leading-snug mb-2">
                          {displayBottom.judul}
                        </h3>
                        <p class="text-xs sm:text-sm text-slate-500 line-clamp-3 leading-relaxed mb-3">
                          {getArticleExcerpt(displayBottom.isi, 160)}
                        </p>
                        <span class="text-xs font-bold text-emerald-800 group-hover:text-emerald-950 inline-flex items-center gap-1">
                          Baca Selengkapnya →
                        </span>
                      </div>
                    </a>
                  </section>
                )}

              </div>

              {/* ──────────────────────────────────────────────────────────
                  KOLOM KANAN (SIDEBAR)
                  ────────────────────────────────────────────────────────── */}
              <aside class="space-y-8" aria-label="Sidebar berita">

                {/* ── 1. Tab [ Terbaru ] [ Terpopuler ] (Pill Switcher) ── */}
                <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm">
                  {/* Pill switcher capsule */}
                  <div class="flex items-center justify-center p-1 bg-slate-100 rounded-full border border-slate-200 mb-5" role="tablist" aria-label="Pilih tampilan berita">
                    <button
                      id="tab-terbaru"
                      type="button"
                      role="tab"
                      aria-selected="true"
                      aria-controls="panel-terbaru"
                      class="sidebar-pill-tab flex-1 py-2 px-4 rounded-full text-xs font-bold transition-all text-white bg-emerald-800 shadow-sm"
                      onclick="switchTab('terbaru')"
                    >
                      Terbaru
                    </button>
                    <button
                      id="tab-terpopuler"
                      type="button"
                      role="tab"
                      aria-selected="false"
                      aria-controls="panel-terpopuler"
                      class="sidebar-pill-tab flex-1 py-2 px-4 rounded-full text-xs font-bold transition-all text-slate-600 hover:text-emerald-800"
                      onclick="switchTab('terpopuler')"
                    >
                      Terpopuler
                    </button>
                  </div>

                  {/* Panel Terbaru */}
                  <div id="panel-terbaru" role="tabpanel" aria-labelledby="tab-terbaru" class="space-y-4">
                    {sidebarRecent.map(item => (
                      <a href={`/berita/${item.slug}`} class="flex items-center gap-3.5 group">
                        <div class="w-20 h-16 flex-shrink-0 rounded-xl overflow-hidden bg-slate-100">
                          {item.url_foto ? (
                            <img
                              src={item.url_foto}
                              alt={item.judul}
                              referrerpolicy="no-referrer"
                              loading="lazy"
                              width="80"
                              height="64"
                              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                            />
                          ) : (
                            <div class="w-full h-full flex items-center justify-center bg-emerald-950 text-white font-serif text-[10px] font-bold">MA</div>
                          )}
                        </div>
                        <div class="flex-1 min-w-0">
                          <h4 class="font-serif text-xs sm:text-sm font-bold text-slate-900 group-hover:text-emerald-800 transition-colors line-clamp-2 leading-snug">
                            {item.judul}
                          </h4>
                          <time datetime={item.tanggal} class="text-[11px] text-slate-400 flex items-center gap-1 mt-1">
                            📅 {formatIndonesianDate(item.tanggal)}
                          </time>
                        </div>
                      </a>
                    ))}
                  </div>

                  {/* Panel Terpopuler */}
                  <div id="panel-terpopuler" role="tabpanel" aria-labelledby="tab-terpopuler" class="space-y-4 hidden" data-live="sidebar-popular">
                    {sidebarPopular.map(item => {
                      const views = formatViews(item.slug);
                      return (
                        <a href={`/berita/${item.slug}`} class="flex items-center gap-3.5 group" data-slug={item.slug}>
                          <div class="w-20 h-16 flex-shrink-0 rounded-xl overflow-hidden bg-slate-100">
                            {item.url_foto ? (
                              <img
                                src={item.url_foto}
                                alt={item.judul}
                                referrerpolicy="no-referrer"
                                loading="lazy"
                                width="80"
                                height="64"
                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                              />
                            ) : (
                              <div class="w-full h-full flex items-center justify-center bg-emerald-950 text-white font-serif text-[10px] font-bold">MA</div>
                            )}
                          </div>
                          <div class="flex-1 min-w-0">
                            {views && (
                              <span class="text-[10px] font-bold text-red-600 block mb-0.5">
                                👁 {views} dibaca
                              </span>
                            )}
                            <h4 class="font-serif text-xs sm:text-sm font-bold text-slate-900 group-hover:text-emerald-800 transition-colors line-clamp-2 leading-snug">
                              {item.judul}
                            </h4>
                            <time datetime={item.tanggal} class="text-[11px] text-slate-400 block mt-0.5">
                              📅 {formatIndonesianDate(item.tanggal)}
                            </time>
                          </div>
                        </a>
                      );
                    })}
                  </div>
                </div>

                {/* ── 2. Kartu Unggulan Sidebar (Sidebar Featured Card) ── */}
                {sidebarFeature && (
                  <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm">
                    <a href={`/berita/${sidebarFeature.slug}`} class="group block">
                      <div class="rounded-xl overflow-hidden aspect-[16/10] bg-slate-100 mb-3 shadow-sm group-hover:shadow-md transition-shadow">
                        {sidebarFeature.url_foto ? (
                          <img
                            src={sidebarFeature.url_foto}
                            alt={sidebarFeature.judul}
                            referrerpolicy="no-referrer"
                            loading="lazy"
                            width="400"
