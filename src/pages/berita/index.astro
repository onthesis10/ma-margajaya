<script src="../../scripts/news-live.ts"></script>

<script is:inline>
  function switchTab(which) {
    var tabs = ['terbaru', 'terpopuler'];
    tabs.forEach(function(t) {
      var btn = document.getElementById('tab-' + t);
      var panel = document.getElementById('panel-' + t);
      var active = (t === which);
      if (btn) {
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
        if (active) {
          btn.className = 'sidebar-pill-tab flex-1 py-2 px-4 rounded-full text-xs font-bold transition-all text-white bg-emerald-800 shadow-sm';
        } else {
          btn.className = 'sidebar-pill-tab flex-1 py-2 px-4 rounded-full text-xs font-bold transition-all text-slate-600 hover:text-emerald-800';
        }
      }
      if (panel) panel.classList.toggle('hidden', !active);
    });
  }
</script>
