---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import { fetchNewsArticles, formatIndonesianDate, estimateReadingTime } from '../../lib/news';

const articles = await fetchNewsArticles();
const heroArticle = articles.length > 0 ? articles[0] : null;
const feedArticles = articles.length > 1 ? articles.slice(1) : [];

const breadcrumbs = [{ label: "Berita", href: "/berita" }];
---

<PageLayout 
  title="Warta & Berita Madrasah" 
  description="Informasi, prestasi, dan dokumentasi agenda kegiatan terkini MA Margajaya Sukadana - Ciamis."
  breadcrumbs={breadcrumbs}
>
  <section class="py-8 md:py-14 bg-slate-50/50 min-h-screen relative overflow-hidden" data-motion-section>
    
    <!-- Ambient Background Lighting -->
    <div class="glow-blob w-[500px] h-[500px] bg-emerald-500/10 -top-32 -left-32"></div>
    <div class="glow-blob w-[600px] h-[600px] bg-gold/10 top-1/3 -right-40"></div>

    <Container>
      <div id="berita-page-root" class="space-y-10">
        
        <!-- Search & Filter Bar -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pb-2 border-b border-slate-200">
          <div>
            <h1 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight">
              Warta &amp; Publikasi Madrasah
            </h1>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">
              Dokumentasi resmi aktivitas, agenda, dan prestasi civitas akademika MA Margajaya Sukadana.
            </p>
          </div>

          <div class="relative w-full sm:w-72">
            <input 
              type="text" 
              id="news-search-input" 
              placeholder="Cari arsip warta..." 
              class="w-full text-xs bg-white border border-slate-200/90 rounded-xl px-4 py-2.5 pr-10 focus:outline-none focus:border-emerald-700 shadow-sm transition-all"
            />
            <svg class="w-4 h-4 text-slate-400 absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
        </div>

        {heroArticle && (
          <!-- Hero Headline Card (Apple News Spotlight Style) -->
          <a 
            href={`/berita/${heroArticle.slug}`}
            class="news-card block group rounded-3xl bg-white/95 backdrop-blur-xl border border-slate-200/80 hover:border-emerald-400 shadow-[0_15px_40px_-15px_rgba(0,0,0,0.05)] hover:shadow-[0_25px_50px_-12px_rgba(5,150,70,0.15)] transition-all duration-300 overflow-hidden"
            data-search-text={`${heroArticle.judul} ${heroArticle.isi}`.toLowerCase()}
          >
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-10 p-6 sm:p-8 lg:p-10 items-center">
              
              <!-- Clean Cover Image -->
              <div class="lg:col-span-7 relative overflow-hidden rounded-2xl aspect-[16/10] bg-slate-900 shadow-sm border border-slate-100">
                {heroArticle.url_foto ? (
                  <img 
                    src={heroArticle.url_foto} 
                    alt={heroArticle.judul} 
                    referrerpolicy="no-referrer" 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" 
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-emerald-950 to-slate-900 text-white font-serif text-2xl font-bold">
                    MA Margajaya
                  </div>
                )}
              </div>

              <!-- Content Typography & Metadata -->
              <div class="lg:col-span-5 space-y-4">
                
                <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500">
                  <span class="px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-[10px] font-bold uppercase tracking-wider border border-emerald-100/80">
                    Liputan Utama
                  </span>
                  <span class="text-slate-300">•</span>
                  <span class="font-medium text-slate-600">
                    {formatIndonesianDate(heroArticle.tanggal)}
                  </span>
                </div>

                <h2 class="font-serif text-2xl sm:text-3xl lg:text-[32px] font-bold text-slate-900 leading-[1.22] group-hover:text-emerald-800 transition-colors">
                  {heroArticle.judul}
                </h2>

                <p class="text-sm text-slate-600 leading-relaxed line-clamp-3 font-light">
                  {heroArticle.isi}
                </p>

                <div class="pt-3 flex items-center justify-between border-t border-slate-100 text-xs">
                  <div class="flex items-center gap-2 text-slate-500">
                    <span class="font-semibold text-slate-700">{heroArticle.penulis || 'Humas MA Margajaya'}</span>
                  </div>

                  <span class="inline-flex items-center gap-1.5 font-bold text-emerald-800 group-hover:text-emerald-950 uppercase tracking-wider text-[11px]">
                    Baca Selengkapnya &rarr;
                  </span>
                </div>

              </div>

            </div>
          </a>
        )}

        <!-- Section Divider & Heading -->
        <div class="pt-2">
          <div class="flex items-center justify-between pb-3 border-b border-slate-200/80 mb-6">
            <h2 class="text-lg sm:text-xl font-serif font-bold text-slate-900 tracking-tight flex items-center gap-2">
              <span>Semua Warta &amp; Publikasi</span>
            </h2>
            <span class="text-xs font-semibold text-slate-600 bg-white px-3 py-1 rounded-full border border-slate-200 shadow-sm">
              {articles.length} Warta Tersedia
            </span>
          </div>

          <!-- Feed Grid (Modern iOS Magazine Grid) -->
          <div id="page-feed-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
            {feedArticles.map(item => (
              <a 
                href={`/berita/${item.slug}`}
                class="news-card group rounded-3xl bg-white border border-slate-200/70 hover:border-emerald-400 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between overflow-hidden"
                data-search-text={`${item.judul} ${item.isi}`.toLowerCase()}
              >
                <div>
                  {item.url_foto ? (
                    <div class="aspect-[16/10] overflow-hidden bg-slate-900 relative">
                      <img 
                        src={item.url_foto} 
                        alt={item.judul} 
                        referrerpolicy="no-referrer" 
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                      />
                      <div class="absolute top-3 right-3 px-2.5 py-1 rounded-full text-[10px] font-bold text-white uppercase tracking-wider backdrop-blur-md bg-black/40 border border-white/20">
                        {formatIndonesianDate(item.tanggal)}
                      </div>
                    </div>
                  ) : (
                    <div class="aspect-[16/10] bg-gradient-to-br from-[#06281D] to-[#075B2A] flex items-center justify-center text-gold-soft p-6 text-center font-serif text-lg font-bold">
                      MA Margajaya
                    </div>
                  )}

                  <div class="p-6 space-y-3">
                    <div class="flex items-center justify-between gap-2 text-xs text-slate-400">
                      <span class="font-semibold text-emerald-800 uppercase tracking-wider text-[10px] bg-emerald-50 px-2 py-0.5 rounded">
                        Warta
                      </span>
                      <span class="flex items-center gap-1 text-slate-400 text-[11px]">
                        <svg class="w-3 h-3 text-slate-400 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <circle cx="12" cy="12" r="9"></circle>
                          <path stroke-linecap="round" d="M12 7v5l3 3"></path>
                        </svg>
                        <span>{estimateReadingTime(item.isi)}</span>
                      </span>
                    </div>
                    <h3 class="font-serif text-xl font-bold text-slate-900 group-hover:text-emerald-800 transition-colors line-clamp-2 leading-snug">
                      {item.judul}
                    </h3>
                    <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed font-light">
                      {item.isi}
                    </p>
                  </div>
                </div>

                <div class="px-6 pb-6 pt-2 flex items-center justify-between border-t border-slate-100 text-xs font-semibold text-emerald-800">
                  <span>Oleh {item.penulis || 'Humas'}</span>
                  <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
                </div>
              </a>
            ))}
          </div>

          <!-- Empty search result message -->
          <div id="no-search-results" class="hidden py-16 text-center text-slate-400 font-serif text-base">
            Tidak ada warta yang cocok dengan kata kunci pencarian.
          </div>
        </div>

      </div>
    </Container>
  </section>
</PageLayout>

<script is:inline>
  // Instant client-side search filtering (zero network latency, pure DOM filter)
  (function() {
    const searchInput = document.getElementById('news-search-input');
    const cards = document.querySelectorAll('.news-card');
    const noResults = document.getElementById('no-search-results');

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        let visibleCount = 0;

        cards.forEach(card => {
          const text = card.getAttribute('data-search-text') || '';
          const match = !query || text.includes(query);
          card.classList.toggle('hidden', !match);
          if (match) visibleCount++;
        });

        if (noResults) {
          noResults.classList.toggle('hidden', visibleCount > 0);
        }
      });
    }
  })();
</script>
