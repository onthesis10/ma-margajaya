---
import PageLayout from '../layouts/PageLayout.astro';
import Container from '../components/ui/Container.astro';

const breadcrumbs = [{ label: "Kesiswaan", href: "/kesiswaan" }];

// === DATA ORGANISASI & EKSKUL ===
const orgsEkskul = [
  {
    id: "osis",
    handle: "osis.margajaya",
    name: "OSIS",
    label: "Organisasi Resmi",
    fullName: "Organisasi Siswa Intra Sekolah",
    desc: "Wadah kepemimpinan dan koordinasi kegiatan santri dalam membentuk karakter pemimpin tangguh.",
    tag: "Kepemimpinan",
    color: "gold",
    heightClass: "h-[340px] sm:h-[370px] md:h-[390px]",
    image: "https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=900&q=80"
  },
  {
    id: "mpk",
    handle: "mpk.dewan",
    name: "MPK",
    label: "Organisasi Resmi",
    fullName: "Majelis Perwakilan Kelas",
    desc: "Lembaga legislatif santri penampung aspirasi kelas dan pengawas program kerja organisasi.",
    tag: "Parlemen",
    color: "emerald",
    heightClass: "h-[430px] sm:h-[470px] md:h-[500px]",
    image: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=900&q=80"
  },
  {
    id: "pmr",
    handle: "pmr.relawan",
    name: "PMR",
    label: "Sosial & Medis",
    fullName: "Palang Merah Remaja",
    desc: "Kesiapsiagaan pertolongan pertama (P3K), tanggap darurat, dan aksi kepedulian donor darah.",
    tag: "Kemanusiaan",
    color: "cyan",
    heightClass: "h-[540px] sm:h-[600px] md:h-[640px]",
    image: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=900&q=80"
  },
  {
    id: "pramuka",
    handle: "pramuka.scout",
    name: "Pramuka",
    label: "Ekskul Wajib",
    fullName: "Gerakan Pramuka Madrasah",
    desc: "Kemandirian, survival alam terbuka, dan kepedulian sosial melalui kepanduan berstandar nasional.",
    tag: "Kepanduan",
    color: "emerald",
    heightClass: "h-[380px] sm:h-[410px] md:h-[430px]",
    image: "https://images.unsplash.com/photo-1517841905240-472988babdf9?w=900&q=80"
  },
  {
    id: "paskibra",
    handle: "paskibra.garuda",
    name: "Paskibra",
    label: "Bela Negara",
    fullName: "Pasukan Pengibar Bendera",
    desc: "Ketegasan baris berbaris, kedisiplinan tinggi, dan pengabdian menjaga kehormatan sang saka.",
    tag: "Kebangsaan",
    color: "emerald",
    heightClass: "h-[500px] sm:h-[560px] md:h-[590px]",
    image: "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=900&q=80"
  },
  {
    id: "memanah",
    handle: "alramyi.archery",
    name: "Memanah",
    label: "Olahraga Sunnah",
    fullName: "Unit Memanah Al-Ramyi",
    desc: "Sunnah Nabi yang mengasah ketenangan batin, fokus konsentrasi, dan presisi akurasi busur.",
    tag: "Sunnah",
    color: "gold",
    heightClass: "h-[350px] sm:h-[380px] md:h-[400px]",
    image: "https://images.unsplash.com/photo-1547471080-7cc2caa01a7e?w=900&q=80"
  },
  {
    id: "futsal",
    handle: "futsal.champs",
    name: "Futsal",
    label: "Olahraga",
    fullName: "Tim Futsal MA Margajaya",
    desc: "Ketangkasan teknik kaki, strategi lapangan cepat, dan kekompakan squad juara antar madrasah.",
    tag: "Sport",
    color: "cyan",
    heightClass: "h-[490px] sm:h-[540px] md:h-[570px]",
    image: "https://images.unsplash.com/photo-1529900748604-07564a03e7a6?w=900&q=80"
  },
  {
    id: "voli",
    handle: "volleyball.spikers",
    name: "Bola Voli",
    label: "Olahraga",
    fullName: "Tim Voli Putra & Putri",
    desc: "Passing presisi, spike mematikan di atas net, dan soliditas kerjasama tim tanpa kenal lelah.",
    tag: "Sport",
    color: "cyan",
    heightClass: "h-[420px] sm:h-[450px] md:h-[470px]",
    image: "https://images.unsplash.com/photo-1612872087720-bb876e2e67d1?w=900&q=80"
  }
