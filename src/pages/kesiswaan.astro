<script>
  import '../scripts/beranda-motion';
  import { initPhotoCards } from '../scripts/photo-card';

  // Initialize Living Photo Card dialog & interactive panels
  initPhotoCards();

  // ── macOS / iOS Horizontal Slideshow Controller ──
  const track = document.getElementById('ios-showcase-track');
  const dotsContainer = document.getElementById('ios-showcase-dots');
  const dots = dotsContainer ? Array.from(dotsContainer.querySelectorAll<HTMLButtonElement>('[data-slide-index]')) : [];

  if (track) {
    const cards = Array.from(track.querySelectorAll<HTMLElement>('.ios-card-item'));
    const totalSlides = cards.length;

    // Helper: Get active index based on scroll position
    function getActiveIndex(): number {
      if (!cards.length) return 0;
      const scrollPos = track.scrollLeft;
      let closestIdx = 0;
      let minDiff = Infinity;
      cards.forEach((card, i) => {
        const diff = Math.abs(card.offsetLeft - track.offsetLeft - scrollPos);
        if (diff < minDiff) {
          minDiff = diff;
          closestIdx = i;
        }
      });
      return closestIdx;
    }

    // Update Dots
    function updateControls(): void {
      const activeIdx = getActiveIndex();
      dots.forEach((dot, idx) => {
        if (idx === activeIdx) {
          dot.classList.add('is-active');
        } else {
          dot.classList.remove('is-active');
        }
      });
    }

    // Scroll to specific index
    function scrollToIndex(idx: number): void {
      if (idx < 0 || idx >= cards.length) return;
      const targetCard = cards[idx];
      const targetPos = targetCard.offsetLeft - track.offsetLeft;
      track.scrollTo({ left: targetPos, behavior: 'smooth' });
    }

    // Dot indicators click
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        scrollToIndex(i);
      });
    });

    // Keyboard navigation when track is focused
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        const cur = getActiveIndex();
        scrollToIndex(Math.min(totalSlides - 1, cur + 1));
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        const cur = getActiveIndex();
        scrollToIndex(Math.max(0, cur - 1));
      }
    });

    // Update on scroll
    let isTicking = false;
    track.addEventListener('scroll', () => {
      if (!isTicking) {
        window.requestAnimationFrame(() => {
          updateControls();
          isTicking = false;
        });
        isTicking = true;
      }
    }, { passive: true });

    // Drag to scroll handling with drag distance threshold
    let isDown = false;
    let startX = 0;
    let startScrollLeft = 0;
    let hasDragged = false;

    track.addEventListener('mousedown', (e) => {
      isDown = true;
      hasDragged = false;
      startX = e.pageX;
      startScrollLeft = track.scrollLeft;
      track.classList.add('cursor-grabbing');
      track.classList.remove('cursor-grab', 'scroll-smooth');
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      const walk = (e.pageX - startX) * 1.3;
      if (Math.abs(e.pageX - startX) > 6) {
        hasDragged = true;
      }
      track.scrollLeft = startScrollLeft - walk;
    });

    window.addEventListener('mouseup', () => {
      if (!isDown) return;
      isDown = false;
      track.classList.remove('cursor-grabbing');
      track.classList.add('cursor-grab', 'scroll-smooth');
    });

    // Prevent card click to open dialog if user was dragging
    cards.forEach(card => {
      card.addEventListener('click', (e) => {
        if (hasDragged) {
          e.stopImmediatePropagation();
          e.preventDefault();
        }
      }, true);
    });

    // Initial sync
    updateControls();
  }
</script>
