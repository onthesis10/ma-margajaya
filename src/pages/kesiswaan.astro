<script>
  import '../scripts/beranda-motion';

  // Smooth Horizontal Gallery Drag & Controls
  const track = document.getElementById('ekskul-gallery-track');
  const btnPrev = document.getElementById('btn-ekskul-prev');
  const btnNext = document.getElementById('btn-ekskul-next');

  if (track) {
    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;

    track.addEventListener('mousedown', (e) => {
      isDown = true;
      track.classList.add('cursor-grabbing');
      track.classList.remove('cursor-grab', 'scroll-smooth');
      startX = e.pageX - track.offsetLeft;
      scrollLeft = track.scrollLeft;
    });

    window.addEventListener('mouseup', () => {
      if (!isDown) return;
      isDown = false;
      track.classList.remove('cursor-grabbing');
      track.classList.add('cursor-grab', 'scroll-smooth');
    });

    track.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - track.offsetLeft;
      const walk = (x - startX) * 1.5; // Drag sensitivity
      track.scrollLeft = scrollLeft - walk;
    });

    if (btnPrev) {
      btnPrev.addEventListener('click', () => {
        track.classList.add('scroll-smooth');
        track.scrollBy({ left: -360, behavior: 'smooth' });
      });
    }

    if (btnNext) {
      btnNext.addEventListener('click', () => {
        track.classList.add('scroll-smooth');
        track.scrollBy({ left: 360, behavior: 'smooth' });
      });
    }
  }
</script>
