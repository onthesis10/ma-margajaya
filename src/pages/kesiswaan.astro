---
import PageLayout from '../layouts/PageLayout.astro';
import Container from '../components/ui/Container.astro';
import PhotoCard from '../components/ui/PhotoCard.astro';
import '../styles/photo-card.css';

const breadcrumbs = [{ label: "Kesiswaan", href: "/kesiswaan" }];

// === DATA ORGANISASI & EKSKUL (Modern Closeup & macOS/iOS Showcase) ===
const orgsEkskul = [
  {
    id: "osis",
    name: "OSIS",
    titleAccent: "Kepemimpinan",
    label: "Organisasi Santri Resmi",
    fullName: "Organisasi Siswa Intra Sekolah",
    desc: "Wadah kepemimpinan resmi santri MA Margajaya: merancang program kerja kesiswaan, memimpin dinamika persidangan, serta membina keteladanan akhlak dan integritas kepemimpinan santri modern.",
    category: "Organisasi Resmi",
    specs: "MA Margajaya · Pembina Kesiswaan",
    image: "/images/organisasi-osis.jpeg"
  },
  {
    id: "mpk",
    name: "MPK",
    titleAccent: "Parlemen",
    label: "Lembaga Legislatif Santri",
    fullName: "Majelis Perwakilan Kelas",
    desc: "Lembaga parlemen dan musyawarah santri yang menghimpun aspirasi perwakilan tiap kelas, mengawal tata tertib madrasah, serta mengevaluasi program kerja kepengurusan OSIS secara objektif.",
    category: "Dewan Aspirasi",
    specs: "Lembaga Parlemen · Musyawarah Kelas",
    image: "https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=1000&auto=format&fit=crop&q=85"
  },
  {
    id: "pramuka",
    name: "PRAMUKA",
    titleAccent: "Kepanduan",
    label: "Kepanduan Ambalan Wajib",
    fullName: "Gerakan Pramuka Gugus Depan MA Margajaya",
    desc: "Gugus depan MA Margajaya menaungi Ambalan Ali bin Abi Thalib dan Ambalan Siti Maryam — membina jiwa kepanduan pramuka penegak, survival rimba, kepedulian sosial, dan kecintaan tanah air berstandar Kwarcab Ciamis.",
    category: "Gudep Kwarcab Ciamis",
    specs: "Ambalan Putra & Putri · Kwarcab Ciamis",
    image: "/images/organisasi-pramuka.jpeg"
  },
  {
    id: "paskibra",
    name: "PASKIBRA",
    titleAccent: "Bela Negara",
    label: "Unit Bela Negara & Formasi",
    fullName: "Pasukan Pengibar Bendera MA Margajaya",
    desc: "Unit bela negara madrasah yang melatih ketegasan baris-berbaris presisi, formasi langkah tegap, disiplin fisik-mental, serta kehormatan mengibarkan Sang Saka Merah Putih pada upacara kenegaraan.",
    category: "Protokoler Kenegaraan",
    specs: "Pleton Inti · Purna Paskibraka",
    image: "/images/organisasi-paskibra.jpeg"
  },
  {
    id: "pmr",
    name: "PMR WIRA",
    titleAccent: "Kemanusiaan",
    label: "Sosial, Medis & P3K",
    fullName: "Palang Merah Remaja Unit Wira",
    desc: "Korps sukarelawan medis santri dalam kesiapsiagaan tanggap darurat, simulasi evakuasi tandu, pertolongan pertama pada kecelakaan (P3K), aksi donor darah, dan sosialisasi sanitasi lingkungan sehat.",
    category: "Relawan Kemanusiaan",
    specs: "Unit PMR Wira · PMI Cabang Ciamis",
    image: "https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=1000&auto=format&fit=crop&q=85"
  },
  {
    id: "futsal",
    name: "FUTSAL",
    titleAccent: "Prestasi",
    label: "Olahraga Prestasi",
    fullName: "Tim Futsal Juara MA Margajaya",
    desc: "Skuad futsal madrasah dengan taktik strategi lapangan cepat, ketangkasan olah bola, akurasi tembakan gawang, dan kekompakan mental bertanding yang langganan menjuarai turnamen pelajar se-Kabupaten Ciamis.",
    category: "Skuad Juara Madrasah",
    specs: "Kompetisi Ciamis · Skuad Utama",
    image: "/images/organisasi-futsal.png"
  },
  {
    id: "voli",
    name: "BOLA VOLI",
    titleAccent: "Sportivitas",
    label: "Olahraga Prestasi",
    fullName: "Tim Bola Voli Putra & Putri",
    desc: "Passing presisi, spike mematikan di bibir net, dan soliditas pertahanan tim tanpa kenal lelah yang mengasah ketahanan fisik, ketangkasan refleks atletik, dan sportivitas tinggi antar santri.",
    category: "Skuad Voli Madya",
    specs: "Tim Putra & Putri · Lapangan Olahraga",
    image: "/images/organisasi-voli.jpeg"
  },
  {
    id: "memanah",
    name: "MEMANAH",
    titleAccent: "Sunnah Nabi",
    label: "Olahraga Sunnah Nabawiyah",
    fullName: "Unit Memanah Al-Ramyi",
    desc: "Menghidupkan olahraga sunnah Nabi Muhammad SAW — melatih stabilitas nafas, ketenangan konsentrasi batin, kekuatan kuda-kuda postur tubuh, serta akurasi lesatan anak panah tepat sasaran.",
    category: "Al-Ramyi Archery",
    specs: "Sunnah Rasulullah · Sasaran Bidik",
    image: "https://images.unsplash.com/photo-1511295742362-92c96b124e52?w=1000&auto=format&fit=crop&q=85"
  }
];

// === DATA TRADISI TAHUNAN ===
const traditions = [
  {
    num: "01",
    title: "Gebyar MA Margajaya",
    icon: "trophy",
    month: "November",
    desc: "Ajang kompetisi akademik & unjuk kreativitas tahunan antarsiswa SMP/MTs se-Eks Kewadanaan Rancah Ciamis, mempererat silaturahmi antargenerasi muda.",
    highlight: "Kompetisi Antar Madrasah"
  },
  {
    num: "02",
    title: "Pesantren Ramadhan & Santunan",
    icon: "mosque",
    month: "Ramadhan",
    desc: "Program intensif pengkajian fiqih, akhlak, dan tadarus Al-Qur'an bersama KUA Sukadana yang ditutup pembagian parcel untuk dhuafa & yatim.",
    highlight: "Program Sosial Keagamaan"
  },
  {
    num: "03",
    title: "Halal Bihalal & Kakaren Lebaran",
    icon: "handshake",
    month: "Syawal",
    desc: "Silaturahmi Syawal bersama Pengasuh Ponpes Darul Muawanah (Ustaz Ajidin), dewan guru, dan santri untuk memperkokoh ukhuwah islamiyah.",
    highlight: "Tradisi Ukhuwah Islamiyah"
  },
  {
    num: "04",
    title: "Lomba Orasi Hari Kartini",
    icon: "mic",
    month: "April",
    desc: "Wadah ekspresi pemikiran siswi berpakaian kebaya adat guna melatih keberanian berbicara di depan publik (public speaking).",
    highlight: "Pemberdayaan Siswi"
  },
  {
    num: "05",
    title: "Wisuda & Pelepasan Kelas XII",
    icon: "graduation",
    month: "Juni",
    desc: "Seremoni kelulusan penuh khidmat dihadiri Camat Sukadana, Kepala Desa Margajaya, perwakilan MUI, dan tokoh masyarakat.",
    highlight: "Seremonial Akademik"
  }
];
---

<PageLayout 
  title="Kesiswaan, Organisasi & Ekstrakurikuler" 
  description="Kegiatan santri MA Margajaya Sukadana: organisasi OSIS & MPK, kepanduan Pramuka, tradisi keagamaan santri, serta pembinaan akhlak dan kepemimpinan."
  breadcrumbs={breadcrumbs}
>
  <section class="py-16 md:py-24 bg-white relative overflow-hidden" data-motion-section>

    <!-- Ambient Background Blobs -->
    <div class="glow-blob w-[500px] h-[500px] bg-emerald-500/8 -top-32 -left-32"></div>
    <div class="glow-blob w-[600px] h-[600px] bg-gold/10 top-1/3 -right-40" style="animation-delay:-4s"></div>
    <div class="glow-blob w-[550px] h-[550px] bg-cyan-400/8 -bottom-40 left-1/4" style="animation-delay:-2s"></div>

    <Container>

      <!-- ══ INTRO EDITORIAL BANNER ══ -->
      <div class="mb-24" data-motion-visual>
        <div class="p-8 sm:p-14 lg:p-16 rounded-3xl bg-gradient-to-br from-[#06281D] via-[#075B2A] to-[#043317] text-white shadow-2xl pure-glow-card pure-glow-gold relative overflow-hidden text-center max-w-5xl mx-auto">
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(232,185,35,0.15),transparent_60%)] pointer-events-none"></div>
          
          <div class="relative z-10 space-y-6 max-w-3xl mx-auto">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md text-xs font-bold uppercase tracking-[0.25em] text-gold-soft">
              Kehidupan Santri & Siswa
            </div>

            <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-[52px] font-normal leading-[1.15] text-white">
              Tumbuh Bersama, <span class="text-gold font-bold text-shimmer-gold">Berprestasi Bermartabat</span>
            </h2>

            <p class="text-white/80 text-sm sm:text-base leading-relaxed font-light max-w-2xl mx-auto">
              MA Margajaya menghadirkan ekosistem kesiswaan yang kaya — dari organisasi kepemimpinan dan ekstra bela diri hingga seni Islam dan penelitian ilmiah — semua dalam nafas pendidikan pesantren modern.
            </p>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6 border-t border-white/15">
              <div class="brutal-glass-card p-5 text-center group cursor-default">
                <div class="font-serif text-3xl font-bold text-gold mb-1">12+</div>
                <div class="text-[11px] text-white/70 uppercase tracking-wider font-light">Unit Ekskul</div>
              </div>
              <div class="brutal-glass-card p-5 text-center group cursor-default">
                <div class="font-serif text-3xl font-bold text-emerald-300 mb-1">2</div>
                <div class="text-[11px] text-white/70 uppercase tracking-wider font-light">Organisasi Resmi</div>
              </div>
              <div class="brutal-glass-card p-5 text-center group cursor-default">
                <div class="font-serif text-3xl font-bold text-cyan-300 mb-1">6</div>
                <div class="text-[11px] text-white/70 uppercase tracking-wider font-light">Tradisi Tahunan</div>
              </div>
              <div class="brutal-glass-card p-5 text-center group cursor-default">
                <div class="font-serif text-3xl font-bold text-gold mb-1">∞</div>
                <div class="text-[11px] text-white/70 uppercase tracking-wider font-light">Potensi Santri</div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </Container>

    <!-- ══ SECTION 1: ORGANISASI & EKSTRAKURIKULER (Apple macOS/iOS Showcase) ══ -->
    <div class="mb-28 scroll-mt-28" id="ekskul" data-motion-section>
      
      <!-- Section Header -->
      <Container>
        <div class="text-center max-w-3xl mx-auto mb-10" data-motion-title>
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 border border-emerald-100 text-emerald-800 text-xs font-bold uppercase tracking-[0.25em] mb-4">
            <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
            Ekosistem Kesiswaan
          </div>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-blue-ink leading-[1.15] tracking-[-0.02em]">
            Organisasi &amp; <em class="italic text-gold text-shimmer-gold">Ekstrakurikuler.</em>
          </h2>
          <p class="text-ink-soft text-base mt-3 leading-relaxed">
            Profil visual unit kegiatan santri MA Margajaya. Geser kartu ke samping untuk menjelajahi unit, dan klik kartu mana pun untuk membuka warta editorial lengkap.
          </p>
        </div>
      </Container>

      <!-- ── APPLE MACOS / IOS HORIZONTAL SNAP SHOWCASE ── -->
      <div class="ios-showcase-container">
        
        <!-- Track Container (Snap x, Smooth Scroll, Drag Support) -->
        <div 
          id="ios-showcase-track" 
          class="ios-showcase-track select-none cursor-grab active:cursor-grabbing"
          role="region"
          aria-label="Slideshow Organisasi dan Ekstrakurikuler"
          tabindex="0"
        >
          {orgsEkskul.map((item, idx) => (
            <PhotoCard
              id={`org-${item.id}`}
              src={item.image}
              alt={`Foto closeup kegiatan ${item.fullName}`}
              title={item.name}
              titleAccent={item.titleAccent}
              category={item.category}
              meta={`${item.label} · ${item.specs}`}
              description={item.desc}
              width={900}
              height={600}
              variant="ios-slide"
              index={idx}
              total={orgsEkskul.length}
              priority={idx < 3}
              ctaLabel="Buka Eksplorasi"
            />
          ))}
        </div>

        <!-- Apple Capsule Indicator Dots -->
        <Container>
          <div class="flex items-center justify-center gap-2.5 pt-4 pb-2" id="ios-showcase-dots">
            {orgsEkskul.map((item, i) => (
              <button
                type="button"
                class={`ios-indicator-dot ${i === 0 ? 'is-active' : ''}`}
                data-slide-index={i}
                aria-label={`Lihat unit ${item.name}`}
              ></button>
            ))}
          </div>
        </Container>

      </div>

    </div>

    <Container>

      <!-- ══ SECTION 2: TRADISI KEGIATAN TAHUNAN ══ -->
      <div class="mb-24 scroll-mt-28" id="tradisi" data-motion-section>
        
        <div class="text-center max-w-3xl mx-auto mb-14" data-motion-title>
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue/10 border border-blue/20 text-blue text-xs font-bold uppercase tracking-[0.25em] mb-4">
            Kalender Kegiatan
          </div>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-blue-ink leading-[1.15] tracking-[-0.02em]">
            Tradisi &amp; <em class="italic text-gold text-shimmer-gold">Agenda Tahunan.</em>
          </h2>
          <p class="text-ink-soft text-base mt-3 leading-relaxed">
            Enam agenda besar yang menjadi penanda ritme kehidupan akademik, sosial, dan spiritual di MA Margajaya sepanjang tahun.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
          {traditions.map((item) => (
            <div 
              class="p-7 rounded-2xl bg-paper/90 border border-hair-strong hover:border-gold/60 hover:shadow-lg transition-all duration-300 flex flex-col justify-between group text-left pure-glow-card pure-glow-emerald cursor-default"
              data-motion-item
            >
              <div>
                <!-- Number + Month Header -->
                <div class="flex items-center justify-between mb-5">
                  <span class="font-serif text-4xl font-bold text-gold/50 group-hover:text-gold transition-colors duration-300 leading-none">
                    {item.num}
                  </span>
                  <div class="flex flex-col items-end">
                    <span class="text-[10px] font-bold uppercase tracking-widest text-ink-muted">{item.month}</span>
                    <span class="inline-block mt-1 px-2.5 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-emerald-50 text-emerald-800 border border-emerald-100">
                      {item.highlight}
                    </span>
                  </div>
                </div>

                <!-- SVG Icon -->
                <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-700 border border-emerald-100 flex items-center justify-center mb-4 group-hover:scale-110 group-hover:bg-emerald-100 transition-all duration-300">
                  {item.icon === 'trophy' && (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 21h8m-4-4v4m-7-9V5a1 1 0 011-1h14a1 1 0 011 1v7M3 8h1m16 0h1M7 8h10"/>
                    </svg>
                  )}
                  {item.icon === 'mosque' && (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 21h18M9 3h6M12 3v4M7 21V10M17 21V10M7 10a5 5 0 0110 0"/>
                    </svg>
                  )}
                  {item.icon === 'handshake' && (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0"/>
                    </svg>
                  )}
                  {item.icon === 'mic' && (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
                    </svg>
                  )}
                  {item.icon === 'leaf' && (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 2C6.477 2 2 6.477 2 12c0 3.314 1.686 6.236 4.264 7.965C7.382 17.65 9.513 16 12 16c2.487 0 4.618 1.65 5.736 3.965C20.314 18.236 22 15.314 22 12c0-5.523-4.477-10-10-10z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 2v14"/>
                    </svg>
                  )}
                  {item.icon === 'graduation' && (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>
                    </svg>
                  )}
                </div>

                <h3 class="font-serif text-xl font-bold text-blue-ink group-hover:text-blue transition-colors mb-2">
                  {item.title}
                </h3>
                <p class="text-xs sm:text-[13px] text-ink-muted leading-relaxed font-light">
                  {item.desc}
                </p>
              </div>
              <div class="pt-5 mt-5 border-t border-hair flex items-center justify-between text-[11px] text-ink-soft">
                <span>Agenda Tetap</span>
                <span class="text-gold font-semibold group-hover:translate-x-1 transition-transform">&rarr;</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- ══ SECTION 3: PRESTASI & PENGHARGAAN Highlight ══ -->
      <div class="mb-24 scroll-mt-28" id="prestasi" data-motion-section>
        <div class="p-8 sm:p-14 rounded-3xl bg-paper-warm/70 border border-hair-strong pure-glow-card pure-glow-gold shadow-sm max-w-6xl mx-auto" data-motion-visual>
          <div class="max-w-2xl mx-auto text-center mb-12">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gold/10 border border-gold/20 text-amber-800 text-xs font-bold uppercase tracking-wider mb-3">
              Jejak Prestasi
            </div>
            <h3 class="font-serif text-3xl sm:text-4xl font-bold text-blue-ink">
              Santri Berprestasi &amp; Kebanggaan Madrasah
            </h3>
            <p class="text-xs sm:text-sm text-ink-muted mt-2 leading-relaxed">
              Sebagian capaian gemilang santri MA Margajaya di berbagai ajang kompetisi akademik, seni, dan olahraga.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="p-6 rounded-2xl bg-white shadow-sm border border-hair hover:border-gold/60 hover:shadow-md transition-all duration-300 group text-center" data-motion-item>
              <div class="w-12 h-12 rounded-xl bg-gold/10 text-amber-700 border border-gold/20 flex items-center justify-center mb-4 mx-auto group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>
                </svg>
              </div>
              <h4 class="font-serif text-lg font-bold text-blue-ink mb-2 group-hover:text-blue transition-colors">Olimpiade Sains Madrasah</h4>
              <p class="text-xs text-ink-muted leading-relaxed">Meraih peringkat terbaik dalam OSM tingkat Kab. Ciamis pada rumpun Matematika dan IPS Terpadu.</p>
            </div>

            <div class="p-6 rounded-2xl bg-white shadow-sm border border-hair hover:border-gold/60 hover:shadow-md transition-all duration-300 group text-center" data-motion-item>
              <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-700 border border-emerald-100 flex items-center justify-center mb-4 mx-auto group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                </svg>
              </div>
              <h4 class="font-serif text-lg font-bold text-blue-ink mb-2 group-hover:text-blue transition-colors">Lomba OMI Tingkat Provinsi</h4>
              <p class="text-xs text-ink-muted leading-relaxed">Santri MA Margajaya meraih prestasi membanggakan dalam Olimpiade Mata pelajaran Islam (OMI) tingkat Provinsi Jawa Barat.</p>
            </div>

            <div class="p-6 rounded-2xl bg-white shadow-sm border border-hair hover:border-gold/60 hover:shadow-md transition-all duration-300 group text-center" data-motion-item>
              <div class="w-12 h-12 rounded-xl bg-cyan-50 text-cyan-700 border border-cyan-100 flex items-center justify-center mb-4 mx-auto group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
