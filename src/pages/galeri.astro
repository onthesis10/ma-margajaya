---

<PageLayout
  title="Galeri Foto & Dokumentasi Kegiatan"
  description="Dokumentasi visual aktivitas belajar, kegiatan keagamaan santri, kepanduan, dan momen silaturahmi keluarga besar MA Margajaya Sukadana, Ciamis."
  breadcrumbs={breadcrumbs}
>
  <section class="py-14 sm:py-20 bg-white relative overflow-hidden" data-motion-section>

    <!-- Ambient glow blobs -->
    <div class="glow-blob w-[500px] h-[500px] bg-emerald-500/8 -top-32 -left-32 pointer-events-none"></div>
    <div class="glow-blob w-[550px] h-[550px] bg-gold/10 top-1/2 -right-40 pointer-events-none" style="animation-delay:-3s"></div>

    <Container>

      <!-- ══ HEADER ══ -->
      <div class="text-center max-w-3xl mx-auto mb-10" data-motion-title>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 border border-emerald-100 text-emerald-800 text-xs font-bold uppercase tracking-[0.25em] mb-4">
          Dokumentasi
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-blue-ink leading-[1.15] tracking-[-0.02em]">
          Merekam Jejak, <em class="italic text-gold text-shimmer-gold">Merayakan Tradisi.</em>
        </h2>
      </div>

      <!-- ══ FILTER CHIPS ══ -->
      <div id="gallery-filters" class="pc-filter-bar" role="group" aria-label="Filter kategori galeri">
        {categories.map((cat) => (
          <button
            type="button"
            class={`pc-chip-filter${cat === 'Semua' ? ' is-active' : ''}`}
            data-filter={cat === 'Semua' ? 'all' : cat}
            aria-pressed={cat === 'Semua' ? 'true' : 'false'}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- ══ GALLERY BENTO CONTAINER (FRAMED MOSAIC) ══ -->
      <div class="gal-bento-frame">
        <div
          id="gallery-grid"
          class="gal-bento-grid"
        >
          {galleryItems.map((item, idx) => {
            const layout = bentoLayout[idx] ?? { col: 1, row: 1 };
            return (
              <div
                class="gal-bento-cell gallery-item"
                data-category={item.category}
                data-col={layout.col}
                data-row={layout.row}
              >
                <PhotoCard
                  id={item.id}
                  src={item.image}
                  alt={item.title}
                  title={item.title}
                  titleAccent={item.category}
                  category={item.category}
                  meta={`${item.date} · ${item.location}`}
                  description={item.description}
                  width={item.width}
                  height={item.height}
                  variant="lightbox"
                  priority={idx === 0}
                  index={idx}
                  total={total}
                />
              </div>
            );
          })}
        </div>
      </div>

      <!-- ══ CTA ══ -->
      <div class="mt-16 mb-4" data-motion-visual>
        <div class="p-8 sm:p-12 lg:p-14 rounded-3xl bg-gradient-to-r from-emerald-950 via-[#075B2A] to-slate-950 text-white shadow-2xl pure-glow-card pure-glow-gold flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8 max-w-6xl mx-auto border border-white/15 relative overflow-hidden">
          <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-gold/15 rounded-full blur-3xl pointer-events-none"></div>
          <div class="space-y-3 max-w-xl">
            <span class="inline-block px-3 py-1 rounded-full bg-gold/15 border border-gold/30 text-[10px] font-bold uppercase tracking-[0.2em] text-gold-soft">
              Bergabung Bersama Kami
            </span>
            <div class="font-serif text-2xl sm:text-3xl lg:text-4xl font-bold text-white tracking-tight leading-snug">
              Jadilah Bagian dari Cerita Gemilang MA Margajaya
            </div>
            <p class="text-white/80 text-sm sm:text-base leading-relaxed font-light">
              Daftarkan putra-putri Anda dalam lingkungan pendidikan islami yang unggul, beradab, dan berdaya saing.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 lg:ml-auto shrink-0 w-full sm:w-auto">
            <a href="/ppdb" class="glow-button inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl bg-gradient-to-r from-gold via-amber-400 to-gold text-blue-deep font-bold text-xs uppercase tracking-widest shadow-xl shadow-gold/25 hover:shadow-[0_0_30px_rgba(232,185,35,0.6)] hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 border border-gold-soft/60">
              <span>Daftar PPDB Sekarang</span>
              <span class="text-sm font-bold">&rarr;</span>
            </a>
            <a href="/kontak" class="brutal-glass-card inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl text-white hover:text-gold font-semibold text-xs uppercase tracking-widest transition-all duration-300">
              <span>Hubungi Kami</span>
            </a>
          </div>
        </div>
      </div>

    </Container>
  </section>
</PageLayout>

<script>
  import { initPhotoCards } from '../scripts/photo-card';
  import '../scripts/beranda-motion';

  document.addEventListener('DOMContentLoaded', () => {
    // ── Filter chips ─────────────────────────────────────────────
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('#gallery-filters .pc-chip-filter');
    const gridItems  = document.querySelectorAll<HTMLElement>('#gallery-grid .gallery-item');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter ?? 'all';

        // Update chip active state + aria-pressed
        filterBtns.forEach(b => {
          b.classList.toggle('is-active', b === btn);
          b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
        });

        // Show/hide items
        gridItems.forEach(item => {
          const cat = item.dataset.category ?? '';
          const show = filter === 'all' || cat === filter;
          if (show) {
            item.style.display = '';
            item.style.opacity = '0';
            requestAnimationFrame(() => {
              item.style.transition = 'opacity 0.35s ease';
              item.style.opacity = '1';
            });
          } else {
            item.style.display = 'none';
          }
        });
      });
    });

    // ── Photo Cards (panel state 3) ──────────────────────────────
    initPhotoCards();
  });
</script>
