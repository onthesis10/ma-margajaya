const categories = ["Semua", "Kampus", "Akademik", "Kesiswaan", "Tradisi", "Prestasi"];
const total = galleryItems.length;

// Bento 2D pattern for 20 items (4-column grid, seamless packing)
const bentoLayout = [
  { col: 2, row: 2 }, // 0: Gedung & Kampus (Hero Utama)
  { col: 1, row: 1 }, // 1: TIK Studio
  { col: 1, row: 1 }, // 2: Pengajian Kitab
  { col: 2, row: 1 }, // 3: Memanah
  { col: 2, row: 1 }, // 4: Marawis
  { col: 1, row: 2 }, // 5: Gebyar (Tall)
  { col: 1, row: 1 }, // 6: Kelas Interaktif
  { col: 2, row: 1 }, // 7: Wisuda
  { col: 1, row: 1 }, // 8: Pramuka
  { col: 1, row: 1 }, // 9: Kaligrafi
  { col: 1, row: 1 }, // 10: Perpustakaan
  { col: 2, row: 2 }, // 11: Prestasi Siswa (Hero Kedua)
  { col: 2, row: 1 }, // 12: Pencak Silat
  { col: 1, row: 2 }, // 13: Upacara Bendera (Tall)
  { col: 2, row: 1 }, // 14: Praktikum IPA
  { col: 1, row: 1 }, // 15: Hadrah Santriwati
  { col: 1, row: 1 }, // 16: Futsal
  { col: 2, row: 1 }, // 17: Voli
  { col: 2, row: 1 }, // 18: Shalat Berjamaah Masjid
  { col: 2, row: 1 }, // 19: Hari Kartini
