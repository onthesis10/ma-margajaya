            if (item.slots && item.slots.length > 0) {
              var slotInfo = getLiveSlotStatus(item.slots);

              if (slotInfo.statusState === 'active' && slotInfo.activeSlots.length > 0) {
                slotsToRender = slotInfo.activeSlots;
                badgeText = 'Sedang Berlangsung';
                badgeGrad = 'background: linear-gradient(135deg,#059245,#046635); color: #fff; box-shadow: 0 4px 14px rgba(5,150,70,0.35); border: 1px solid rgba(255,255,255,0.25);';
