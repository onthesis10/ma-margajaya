<PageLayout 
  title="Akademik & Kurikulum" 
  description="Struktur kurikulum nasional terpadu, pendalaman keagamaan madrasah, dan ekosistem belajar berakar nilai pesantren di MA Margajaya."
  breadcrumbs={breadcrumbs}
>
  <!-- Main Content Container with Ambient Color Blobs -->
  <section class="py-16 md:py-24 bg-white relative overflow-hidden" data-motion-section>
    
    <!-- Ambient Background Blobs -->
    <div class="glow-blob w-[500px] h-[500px] bg-emerald-500/10 -top-32 -left-32"></div>
    <div class="glow-blob w-[550px] h-[550px] bg-gold/12 top-1/3 -right-40" style="animation-delay: -5s;"></div>
    <div class="glow-blob w-[600px] h-[600px] bg-cyan-500/10 -bottom-40 left-1/4" style="animation-delay: -3s;"></div>

    <Container>
      
      <!-- 6. KALENDER AKADEMIK & JADWAL PELAJARAN REAL-TIME (macOS Glassmorphism + Live Guru & Jam Switcher) -->
      <div class="mb-24 scroll-mt-28 relative" id="kalender-akademik" data-motion-section>
        
        <!-- Ambient Glass Glows -->
        <div class="absolute -top-10 left-1/2 -translate-x-1/2 w-[600px] h-48 bg-gradient-to-r from-emerald-400/10 via-gold/15 to-teal-400/10 blur-3xl pointer-events-none rounded-full"></div>

        <!-- Section Header -->
        <div class="text-center max-w-3xl mx-auto mb-10 relative z-10" data-motion-title>
          <div class="inline-flex items-center px-4 py-1.5 rounded-full bg-emerald-500/10 text-emerald-800 text-xs font-bold uppercase tracking-[0.2em] mb-4 shadow-sm backdrop-blur-md">
            Jadwal Pelajaran &amp; Guru Real-time
          </div>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-blue-ink leading-[1.15] tracking-[-0.02em]">
            Kalender &amp; Guru <em class="italic text-gold text-shimmer-gold">Sedang Mengajar</em>
          </h2>
        </div>

        <!-- REALTIME MACOS LIVE TEACHER & SCHEDULE BANNER -->
        <div class="max-w-4xl mx-auto mb-8 px-4 relative z-10" id="kaldik-status-wrap">
          <!-- Injected dynamically by real-time JS engine with auto-switcher -->
        </div>

        <!-- SINGLE REAL-TIME TODAY HERO CARD (Auto-switches every day) -->
        <div class="max-w-lg mx-auto px-4 relative z-10 mb-8">
          
          <!-- Top Clock & Status -->
          <div class="flex items-center justify-between mb-3 px-2">
            <div class="flex items-center gap-2">
              <span class="relative flex h-2.5 w-2.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
              </span>
              <span id="live-clock-kaldik" class="font-mono text-xs font-bold text-emerald-900 tracking-wider">--:--:-- WIB</span>
            </div>
            <span class="text-[11px] text-slate-400 font-medium">Jadwal Real-Time Harian</span>
          </div>

          <!-- Centered Single Card Container -->
          <div id="kaldik-today-container">
            <!-- Rendered dynamically for today -->
          </div>

        </div>



      </div>

