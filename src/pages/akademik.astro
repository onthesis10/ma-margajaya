                for (var fi = 0; fi < item.slots.length; fi++) {
                  if (!item.slots[fi].subject.includes('Istirahat')) { fStart = item.slots[fi].start; break; }
                }
                slotsToRender = item.slots.filter(function(s) { return s.start === fStart; });
