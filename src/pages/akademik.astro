          // ─── 7. GOOGLE CALENDAR API PARSER & SYNC ─────────────────────────
          function syncGoogleCalendar() {
            generateDailyList();
            renderStatusBanner();
            renderTodayHeroCard();

            if (!googleCalId || !googleCalApiKey) return;

            var now = new Date();
            var pastYear = new Date(now.getFullYear() - 1, 0, 1).toISOString();
            var futureYear = new Date(now.getFullYear() + 2, 11, 31).toISOString();
            var url = 'https://www.googleapis.com/calendar/v3/calendars/' + encodeURIComponent(googleCalId) + 
                      '/events?key=' + encodeURIComponent(googleCalApiKey) + 
                      '&timeMin=' + pastYear + 
                      '&timeMax=' + futureYear + 
                      '&singleEvents=true&orderBy=startTime';

            fetch(url)
              .then(function(res) { 
                if (!res.ok) throw new Error('HTTP ' + res.status);
                return res.json(); 
              })
              .then(function(data) {
                if (data && data.items && data.items.length > 0) {
                  var gEvents = [];
                  var scheduleMap = {};

                  data.items.forEach(function(item, idx) {
                    var isTimed = item.start.dateTime && item.end.dateTime;
                    var startStr = item.start.date || (item.start.dateTime ? item.start.dateTime.split('T')[0] : '');
                    var endStr = item.end.date || (item.end.dateTime ? item.end.dateTime.split('T')[0] : null);

                    var summary = item.summary || 'Kegiatan Madrasah';
                    var isHoliday = /libur|hari raya|cuti|wafat|kenaikan|natal|nyepi|imlek|kemerdekaan/i.test(summary);

                    if (isTimed) {
                      var sTime = item.start.dateTime.split('T')[1].substring(0, 5);
                      var eTime = item.end.dateTime.split('T')[1].substring(0, 5);

                      var subject = summary;
                      var teacher = item.description || 'Dewan Guru MA';
                      if (summary.indexOf('-') > 0) {
                        var parts = summary.split('-');
                        subject = parts[0].trim();
                        teacher = parts.slice(1).join('-').trim();
                      } else if (summary.indexOf(':') > 0) {
                        var p2 = summary.split(':');
                        subject = p2[0].trim();
                        teacher = p2.slice(1).join(':').trim();
                      }

                      if (!scheduleMap[startStr]) scheduleMap[startStr] = [];
                      scheduleMap[startStr].push({
                        start: sTime,
                        end: eTime,
                        subject: subject,
                        teacher: teacher,
                        room: item.location || 'Kelas MA'
                      });
                    } else {
                      var sDate = parseDate(startStr);
                      var isGenap = sDate.getMonth() < 6;
                      gEvents.push({
                        id: item.id || String(idx),
                        start: startStr,
                        end: endStr,
                        title: summary,
                        desc: item.description || 'Agenda resmi kalender MA Margajaya',
                        semester: isGenap ? 'genap' : 'gasal',
                        isHoliday: isHoliday,
                        category: isHoliday ? 'Libur Nasional' : 'Agenda Google Calendar'
                      });
                    }
                  });

                  if (Object.keys(scheduleMap).length > 0) {
                    customGoogleScheduleMap = scheduleMap;
                  }

                  if (gEvents.length > 0) {
                    activeEvents = gEvents;
                  }

                  generateDailyList();
                  renderStatusBanner();
                  renderTodayHeroCard();
                }
              })
              .catch(function(err) {
                console.warn('Google Calendar sync notice (using standard timetable & Kaldik data):', err);
              });
          }

          // ─── 9. LIVE CLOCK & AUTO-SWITCHER TIMER ──────────────────────────
          function startLiveClockAndSwitcher() {
            function tick() {
              var clockEl = document.getElementById('live-clock-kaldik');
              var now = new Date();
              var h = String(now.getHours()).padStart(2, '0');
              var m = String(now.getMinutes()).padStart(2, '0');
              var s = String(now.getSeconds()).padStart(2, '0');
              if (clockEl) {
                clockEl.textContent = 'WIB ' + h + ':' + m + ':' + s;
              }

              // Re-check live active lesson every 10 seconds
              if (now.getSeconds() % 10 === 0) {
                renderStatusBanner();
                renderTodayHeroCard();
              }
            }

            tick();
            setInterval(tick, 1000);
          }

          // ─── 10. INITIALIZATION ───────────────────────────────────────────
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function() {
              syncGoogleCalendar();
              startLiveClockAndSwitcher();
            });
          } else {
            syncGoogleCalendar();
            startLiveClockAndSwitcher();
          }

        })();
      </script>

