          var activeEvents = defaultEvents;
          var dailyItems = [];
          var todayIndex = 0;
          var customGoogleScheduleMap = {}; // Key: 'YYYY-MM-DD' -> Array of slot objects

          var DAYS_ID = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
          var DAYS_SHORT = ['MIN', 'SEN', 'SEL', 'RAB', 'KAM', 'JUM', 'SAB'];
          var MONTHS_ID = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
          var MONTHS_SHORT = ['JAN', 'FEB', 'MAR', 'APR', 'MEI', 'JUN', 'JUL', 'AGS', 'SEP', 'OKT', 'NOV', 'DES'];

          function parseDate(str) {
            if (!str) return new Date();
            var p = str.split('-');
            return new Date(parseInt(p[0]), parseInt(p[1]) - 1, parseInt(p[2]));
          }

          function formatDateKey(d) {
            var y = d.getFullYear();
            var m = String(d.getMonth() + 1).padStart(2, '0');
            var day = String(d.getDate()).padStart(2, '0');
            return y + '-' + m + '-' + day;
          }

          function formatDateFull(d) {
            return DAYS_ID[d.getDay()] + ', ' + d.getDate() + ' ' + MONTHS_ID[d.getMonth()] + ' ' + d.getFullYear();
          }

          function timeToMinutes(tStr) {
            if (!tStr) return 0;
            var parts = tStr.split(':');
            return parseInt(parts[0], 10) * 60 + parseInt(parts[1], 10);
          }

          // ─── 2. EVALUATE DAY DATA & TIMETABLE ─────────────────────────────
          function evaluateDay(d, todayMidnight) {
            var dayOfWeek = d.getDay(); // 0: Min, 6: Sab
            var isToday = d.getTime() === todayMidnight.getTime();
            var isPast = d.getTime() < todayMidnight.getTime();
            var isFuture = d.getTime() > todayMidnight.getTime();
            var dateKey = formatDateKey(d);

            var matchedHoliday = null;
            var matchedEvent = null;

            for (var i = 0; i < activeEvents.length; i++) {
              var ev = activeEvents[i];
              var s = parseDate(ev.start);
              var e = ev.end ? parseDate(ev.end) : parseDate(ev.start);
              e = new Date(e.getFullYear(), e.getMonth(), e.getDate());

              if (d >= s && d <= e) {
                if (ev.isHoliday) {
                  matchedHoliday = ev;
                } else if (!matchedEvent) {
                  matchedEvent = ev;
                }
              }
            }

            var month = d.getMonth();
            var semester = (month >= 6) ? 'gasal' : 'genap';

            // Get day's schedule slots (from Google Calendar override or baseline weekly schedule)
            var daySlots = [];
            if (customGoogleScheduleMap[dateKey] && customGoogleScheduleMap[dateKey].length > 0) {
              daySlots = customGoogleScheduleMap[dateKey];
            } else if (weeklyBaseTimetable[dayOfWeek] && !matchedHoliday) {
              daySlots = weeklyBaseTimetable[dayOfWeek];
            }

            if (matchedHoliday) {
              return {
                date: d,
                isToday: isToday,
                isPast: isPast,
                isFuture: isFuture,
                type: 'holiday',
                title: matchedHoliday.title,
                desc: matchedHoliday.desc || 'Libur resmi madrasah / nasional.',
                tagText: 'Libur Resmi',
                tagClass: 'bg-rose-500/15 text-rose-900',
                badgeClass: 'bg-rose-500 text-white',
                timeText: 'Libur Seharian',
                semester: semester,
                pulseColor: 'bg-rose-500',
                slots: []
              };
            }

            if (dayOfWeek === 0 || dayOfWeek === 6) {
              var dayName = dayOfWeek === 0 ? 'Minggu' : 'Sabtu';
              return {
                date: d,
                isToday: isToday,
                isPast: isPast,
                isFuture: isFuture,
                type: 'weekend',
                title: 'Libur Akhir Pekan (' + dayName + ')',
                desc: 'Libur rutin akhir pekan santri & dewan guru (Sistem 5 Hari Sekolah / Full Day School).',
                tagText: 'Full Day School',
                tagClass: 'bg-rose-500/12 text-rose-800',
                badgeClass: 'bg-slate-700 text-white',
                timeText: 'Libur Akhir Pekan',
                semester: semester,
                pulseColor: 'bg-rose-500',
                slots: []
              };
            }

            if (matchedEvent) {
              return {
                date: d,
                isToday: isToday,
                isPast: isPast,
                isFuture: isFuture,
                type: 'event',
                title: matchedEvent.title,
                desc: matchedEvent.desc || 'Agenda khusus pembelajaran & evaluasi madrasah.',
                tagText: matchedEvent.category || 'Agenda Khusus',
                tagClass: 'bg-amber-500/15 text-amber-900',
                badgeClass: 'bg-amber-600 text-white',
                timeText: '07.00 – 15.00 WIB',
                semester: semester,
                pulseColor: 'bg-amber-500',
                slots: daySlots
              };
            }

            return {
              date: d,
              isToday: isToday,
              isPast: isPast,
              isFuture: isFuture,
              type: 'normal',
              title: 'Jadwal Pembelajaran Terpadu',
              desc: 'Shalat Dhuha berjamaah, tadarus Al-Qur\'an, dan KBM Kurikulum Merdeka bersama Dewan Guru.',
              tagText: 'KBM Aktif',
              tagClass: 'bg-emerald-500/15 text-emerald-900',
              badgeClass: 'bg-emerald-700 text-white',
              timeText: '07.00 – 15.00 WIB',
              semester: semester,
              pulseColor: 'bg-emerald-500',
              slots: daySlots
            };
          }

          // ─── 3. REALTIME ACTIVE SLOT FINDER (AUTO SWITCHER) ───────────────
          function getLiveSlotStatus(slots) {
            if (!slots || slots.length === 0) return { activeSlots: [], statusState: 'none' };

            var now = new Date();
            var currentMins = now.getHours() * 60 + now.getMinutes();

            var activeSlots = [];
            var firstSlotMins = 9999;
            var lastSlotMins = 0;

            for (var i = 0; i < slots.length; i++) {
              var sMins = timeToMinutes(slots[i].start);
              var eMins = timeToMinutes(slots[i].end);

              if (sMins < firstSlotMins) firstSlotMins = sMins;
              if (eMins > lastSlotMins) lastSlotMins = eMins;

              if (currentMins >= sMins && currentMins < eMins) {
                activeSlots.push(slots[i]);
              }
            }

            var statusState = 'active';
            if (activeSlots.length === 0) {
              if (currentMins < firstSlotMins) {
                statusState = 'before_school';
              } else if (currentMins >= lastSlotMins) {
                statusState = 'after_school';
              } else {
                statusState = 'break_period';
              }
            }

            return {
              activeSlots: activeSlots,
              statusState: statusState
            };
          }

          // ─── 4. GENERATE CONTINUOUS DAILY LIST ────────────────────────────
          function generateDailyList() {
            var now = new Date();
            var today = new Date(now.getFullYear(), now.getMonth(), now.getDate());

            var items = [];
            var daysBefore = 7;
            var daysAfter = 35;

            for (var offset = -daysBefore; offset <= daysAfter; offset++) {
              var d = new Date(today.getFullYear(), today.getMonth(), today.getDate() + offset);
              var dayData = evaluateDay(d, today);
              items.push(dayData);
            }

            dailyItems = items;
            todayIndex = daysBefore;
          }

          // Helper to extract clean class label and subject
          function parseSlotDetails(slot) {
            var rawSub = (slot.subject || '').replace(/[\r\n]+/g, ' ').trim();
            var rawTeacher = (slot.teacher || '').replace(/[\r\n]+/g, ' ').trim();
            var cls = '';
            var cleanSub = rawSub;

            // Prioritize XII, then XI, then X with word boundaries
            var match = rawSub.match(/\b(XII|XI|X)\b/i);
            if (!match && slot.room) {
              match = slot.room.match(/\b(XII|XI|X)\b/i);
            }
            if (match) {
              cls = match[1].toUpperCase();
            }

            cleanSub = rawSub.replace(/\s*\([^\)]*\)/g, '').trim();

            return {
              cls: cls,
              subject: cleanSub,
              teacher: rawTeacher,
              room: slot.room || 'Ruang Kelas',
              start: slot.start,
              end: slot.end
            };
          }

