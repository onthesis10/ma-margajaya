        <div id="pv-body" class="prose-article prose-article-dark text-sm sm:text-base leading-[2.1] pb-4"></div>
      </div>

    </div>
  </div>


  <!-- =========================================================================
       MODAL: DELETE CONFIRMATION (macOS Card)
       ========================================================================= -->
  <div id="delete-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md">
    <div class="ios-glass-card rounded-3xl w-full max-w-md p-6 sm:p-8 border border-rose-500/30 shadow-2xl text-center relative overflow-hidden">
      
      <!-- Normal State -->
      <div id="delete-normal-state">
