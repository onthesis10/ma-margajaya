<script is:inline>
  // =========================================================================
  // JAVASCRIPT CONTROLLER FOR ADMIN PORTAL
  // =========================================================================
  (function() {
    // DOM Elements
    const dashboardEl = document.getElementById('admin-dashboard');
    const loginScreen = document.getElementById('admin-login-screen');
    const DEFAULT_API_URL = dashboardEl ? dashboardEl.getAttribute('data-api-url') : "";

    const formLogin = document.getElementById('form-login');
    const adminPasswordInput = document.getElementById('admin-password');
    const loginError = document.getElementById('login-error');
    const btnTogglePw = document.getElementById('btn-toggle-pw');
    const eyeOpen = document.getElementById('eye-open');
    const eyeClosed = document.getElementById('eye-closed');
    const btnLogout = document.getElementById('btn-logout');

    // Settings Modal
    const btnOpenSettings = document.getElementById('btn-open-settings');
    const settingsModal = document.getElementById('settings-modal');
    const btnCloseSettings = document.getElementById('btn-close-settings');
    const btnCancelSettings = document.getElementById('btn-cancel-settings');
    const apiUrlInput = document.getElementById('api-url-input');
    const btnSaveApi = document.getElementById('btn-save-api');

    // Form News
    const formNews = document.getElementById('form-news');
    const tanggalHiddenInput = document.getElementById('tanggal');
    const penulisInput = document.getElementById('penulis');
    const fotoInput = document.getElementById('foto');
    const dropzoneArea = document.getElementById('dropzone-area');
    const previewContainer = document.getElementById('preview-container');
    const imgPreview = document.getElementById('img-preview');
    const btnRemovePhoto = document.getElementById('btn-remove-photo');
    const formAlert = document.getElementById('form-alert');
    const btnSubmit = document.getElementById('btn-submit');
    const btnSpinner = document.getElementById('btn-spinner');
    const btnIcon = document.getElementById('btn-icon');
    const btnText = document.getElementById('btn-text');

    // Custom Theme Calendar Elements
    const btnCustomDate = document.getElementById('btn-custom-date');
    const dateDisplayText = document.getElementById('date-display-text');
    const calPopover = document.getElementById('custom-calendar-popover');
    const calPrevMonth = document.getElementById('cal-prev-month');
    const calNextMonth = document.getElementById('cal-next-month');
    const calMonthYearTitle = document.getElementById('cal-month-year-title');
    const calDaysGrid = document.getElementById('cal-days-grid');
    const calBtnToday = document.getElementById('cal-btn-today');
    const calBtnClose = document.getElementById('cal-btn-close');

    // News List
    const newsListSkeleton = document.getElementById('news-list-skeleton');
    const newsListContainer = document.getElementById('news-list-container');
    const newsListEmpty = document.getElementById('news-list-empty');
    const btnRefreshList = document.getElementById('btn-refresh-list');

    // Preview Modal
    const previewModal = document.getElementById('preview-modal');
    const btnClosePreview = document.getElementById('btn-close-preview');
    const btnClosePreviewFooter = document.getElementById('btn-close-preview-footer');
    const pvTitle = document.getElementById('pv-title');
    const pvDate = document.getElementById('pv-date');
    const pvPenulis = document.getElementById('pv-penulis');
    const pvPhoto = document.getElementById('pv-photo');
    const pvBody = document.getElementById('pv-body');

    // Delete Modal
    const deleteModal = document.getElementById('delete-modal');
    const deleteConfirmTitle = document.getElementById('delete-confirm-title');
    const btnCancelDelete = document.getElementById('btn-cancel-delete');
    const btnConfirmDelete = document.getElementById('btn-confirm-delete');

    let currentBase64Image = null;
    let currentImageName = "";
    let currentImageType = "";
    let allNewsItems = [];
    let pendingDeleteId = null;

    // Helper: Date Formatter
    const monthNames = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];
    const dayNames = ["Minggu", "Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu"];
    
    function formatDate(raw) {
      if (!raw) return '—';
      const d = new Date(raw);
      if (isNaN(d.getTime())) return String(raw);
      return `${d.getDate()} ${monthNames[d.getMonth()]} ${d.getFullYear()}`;
    }

    function formatLongDate(d) {
      return `${dayNames[d.getDay()]}, ${d.getDate()} ${monthNames[d.getMonth()]} ${d.getFullYear()}`;
    }

    function formatDriveImageUrl(url) {
      if (!url) return '';
      const str = String(url).trim();
      const match = str.match(/\/d\/([a-zA-Z0-9_-]+)/) || str.match(/id=([a-zA-Z0-9_-]+)/) || str.match(/\/file\/d\/([a-zA-Z0-9_-]+)/);
      if (match && match[1]) {
        return `https://drive.google.com/thumbnail?id=${match[1]}&sz=w800`;
      }
      return str;
    }

    function getApiUrl() {
      return localStorage.getItem('margajaya_api_url') || DEFAULT_API_URL || '';
    }

    function showAlert(type, htmlContent) {
      formAlert.className = 'mb-8 p-4 sm:p-5 rounded-2xl text-xs sm:text-sm leading-relaxed font-medium transition-all ' + 
        (type === 'success' 
          ? 'bg-emerald-950/80 text-emerald-200 border border-emerald-500/40 shadow-lg shadow-emerald-950/40' 
          : 'bg-rose-950/80 text-rose-200 border border-rose-500/40 shadow-lg shadow-rose-950/40');
      formAlert.innerHTML = htmlContent;
      formAlert.classList.remove('hidden');
      formAlert.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function hideAlert() {
      formAlert.classList.add('hidden');
    }

    function setLoading(isLoading) {
      btnSubmit.disabled = isLoading;
      btnSpinner.classList.toggle('hidden', !isLoading);
      btnIcon.classList.toggle('hidden', isLoading);
      btnText.textContent = isLoading ? 'Mengunggah & Menyimpan...' : 'Kirim & Publikasikan Berita';
    }

    // Toggle Password Visibility
    if (btnTogglePw) {
      btnTogglePw.addEventListener('click', () => {
        const isText = adminPasswordInput.type === 'text';
        adminPasswordInput.type = isText ? 'password' : 'text';
        eyeOpen.classList.toggle('hidden', !isText);
        eyeClosed.classList.toggle('hidden', isText);
      });
    }

    // =========================================================================
    // CUSTOM EMERALD & GOLD THEME CALENDAR LOGIC
    // =========================================================================
    let selectedDate = new Date();
    let currentCalMonth = selectedDate.getMonth();
    let currentCalYear = selectedDate.getFullYear();

    function updateSelectedDate(d) {
      selectedDate = new Date(d);
      const year = selectedDate.getFullYear();
      const month = String(selectedDate.getMonth() + 1).padStart(2, '0');
      const day = String(selectedDate.getDate()).padStart(2, '0');
      const isoString = `${year}-${month}-${day}`;

      if (tanggalHiddenInput) tanggalHiddenInput.value = isoString;
      if (dateDisplayText) dateDisplayText.textContent = formatLongDate(selectedDate);
    }

    function renderCustomCalendar() {
      if (!calMonthYearTitle || !calDaysGrid) return;
      calMonthYearTitle.textContent = `${monthNames[currentCalMonth]} ${currentCalYear}`;

      calDaysGrid.innerHTML = '';

      const firstDay = new Date(currentCalYear, currentCalMonth, 1).getDay();
      const daysInMonth = new Date(currentCalYear, currentCalMonth + 1, 0).getDate();
      const today = new Date();

      // Empty padding cells before 1st of month
      for (let i = 0; i < firstDay; i++) {
        const emptyCell = document.createElement('div');
        emptyCell.className = 'h-8 w-8';
        calDaysGrid.appendChild(emptyCell);
      }

      // Day cells
      for (let day = 1; day <= daysInMonth; day++) {
        const cell = document.createElement('button');
        cell.type = 'button';
        cell.textContent = String(day);
        
        const isSelected = selectedDate.getDate() === day && 
                           selectedDate.getMonth() === currentCalMonth && 
                           selectedDate.getFullYear() === currentCalYear;

        const isToday = today.getDate() === day && 
                        today.getMonth() === currentCalMonth && 
                        today.getFullYear() === currentCalYear;

        if (isSelected) {
          cell.className = 'h-8 w-8 rounded-xl bg-gold text-slate-950 font-bold text-xs shadow-md shadow-gold/30 flex items-center justify-center transition-all scale-105';
        } else if (isToday) {
          cell.className = 'h-8 w-8 rounded-xl border border-gold text-gold font-bold text-xs flex items-center justify-center hover:bg-emerald-500/20 transition-all';
        } else {
          cell.className = 'h-8 w-8 rounded-xl text-slate-200 hover:bg-emerald-500/20 hover:text-white text-xs font-medium flex items-center justify-center transition-all';
        }

        cell.addEventListener('click', () => {
          updateSelectedDate(new Date(currentCalYear, currentCalMonth, day));
          renderCustomCalendar();
          if (calPopover) calPopover.classList.add('hidden');
        });

        calDaysGrid.appendChild(cell);
      }
    }

    if (btnCustomDate) {
      btnCustomDate.addEventListener('click', (e) => {
        e.stopPropagation();
        if (calPopover) {
          calPopover.classList.toggle('hidden');
          currentCalMonth = selectedDate.getMonth();
          currentCalYear = selectedDate.getFullYear();
          renderCustomCalendar();
        }
      });
    }

    if (calPrevMonth) {
      calPrevMonth.addEventListener('click', (e) => {
        e.stopPropagation();
        currentCalMonth--;
        if (currentCalMonth < 0) {
          currentCalMonth = 11;
          currentCalYear--;
        }
        renderCustomCalendar();
      });
    }

    if (calNextMonth) {
      calNextMonth.addEventListener('click', (e) => {
        e.stopPropagation();
        currentCalMonth++;
        if (currentCalMonth > 11) {
          currentCalMonth = 0;
          currentCalYear++;
        }
        renderCustomCalendar();
      });
    }

    if (calBtnToday) {
      calBtnToday.addEventListener('click', (e) => {
        e.stopPropagation();
        const now = new Date();
        currentCalMonth = now.getMonth();
        currentCalYear = now.getFullYear();
        updateSelectedDate(now);
        renderCustomCalendar();
        if (calPopover) calPopover.classList.add('hidden');
      });
    }

    if (calBtnClose) {
      calBtnClose.addEventListener('click', () => {
        if (calPopover) calPopover.classList.add('hidden');
      });
    }

    document.addEventListener('click', (e) => {
      if (calPopover && !calPopover.contains(e.target) && e.target !== btnCustomDate && !btnCustomDate?.contains(e.target)) {
        calPopover.classList.add('hidden');
      }
    });

    // Initialize date with today
    updateSelectedDate(new Date());


    // =========================================================================
    // SETTINGS MODAL LOGIC
    // =========================================================================
    function openSettings() {
      if (apiUrlInput) apiUrlInput.value = getApiUrl();
      if (settingsModal) settingsModal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeSettings() {
      if (settingsModal) settingsModal.classList.add('hidden');
      document.body.style.overflow = '';
    }

    if (btnOpenSettings) btnOpenSettings.addEventListener('click', openSettings);
    if (btnCloseSettings) btnCloseSettings.addEventListener('click', closeSettings);
    if (btnCancelSettings) btnCancelSettings.addEventListener('click', closeSettings);

    if (btnSaveApi) {
      btnSaveApi.addEventListener('click', () => {
        const val = apiUrlInput.value.trim();
        if (val) {
          localStorage.setItem('margajaya_api_url', val);
          closeSettings();
          showAlert('success', '✓ URL Google Apps Script Endpoint berhasil disimpan!');
          loadNewsList();
        }
      });
    }

    // =========================================================================
    // AUTHENTICATION CONTROLLER
    // =========================================================================
    function showDashboard() {
      loginScreen.classList.add('hidden');
      dashboardEl.classList.remove('hidden');
      initDashboard();
    }

    function showLogin() {
      loginScreen.classList.remove('hidden');
      dashboardEl.classList.add('hidden');
      adminPasswordInput.value = '';
    }

    if (sessionStorage.getItem('margajaya_admin_logged_in') === 'true') {
      showDashboard();
    }

    if (formLogin) {
      formLogin.addEventListener('submit', async (e) => {
        e.preventDefault();
        const pwd = adminPasswordInput.value.trim();
        if (!pwd) return;

        const apiUrl = getApiUrl();
        if (!apiUrl) {
          loginError.classList.remove('hidden');
          const errorMsgSpan = loginError.querySelector('span');
          if (errorMsgSpan) errorMsgSpan.textContent = 'URL Google Apps Script belum disetel.';
          return;
        }

        const btnLoginSubmit = formLogin.querySelector('button[type="submit"]');
        const originalBtnText = btnLoginSubmit ? btnLoginSubmit.innerHTML : '';
        if (btnLoginSubmit) {
          btnLoginSubmit.disabled = true;
          btnLoginSubmit.innerHTML = '<span>Memverifikasi Sandi...</span>';
        }

        try {
          const res = await fetch(apiUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify({ action: 'login', password: pwd })
          });
          const data = await res.json();
          if (data.status === 'success' && data.token) {
            sessionStorage.setItem('margajaya_admin_logged_in', 'true');
            sessionStorage.setItem('margajaya_admin_token', data.token);
            loginError.classList.add('hidden');
            showDashboard();
          } else {
            loginError.classList.remove('hidden');
            const errorMsgSpan = loginError.querySelector('span');
            if (errorMsgSpan) errorMsgSpan.textContent = data.message || 'Kata sandi tidak sesuai. Silakan periksa kembali.';
            adminPasswordInput.value = '';
            adminPasswordInput.focus();
          }
        } catch (err) {
          loginError.classList.remove('hidden');
          const errorMsgSpan = loginError.querySelector('span');
          if (errorMsgSpan) errorMsgSpan.textContent = 'Gagal menghubungi server Apps Script: ' + err.message;
        } finally {
          if (btnLoginSubmit) {
            btnLoginSubmit.disabled = false;
            btnLoginSubmit.innerHTML = originalBtnText;
          }
        }
      });
    }

    if (btnLogout) {
      btnLogout.addEventListener('click', () => {
        sessionStorage.removeItem('margajaya_admin_logged_in');
        sessionStorage.removeItem('margajaya_admin_token');
        showLogin();
      });
    }


    // Initialize Dashboard Data
    function initDashboard() {
      if (penulisInput && !penulisInput.value) penulisInput.value = 'Humas MA Margajaya';
      loadNewsList();
    }

    // Load News Feed
    function loadNewsList() {
      const apiUrl = getApiUrl();
      newsListSkeleton.classList.remove('hidden');
      newsListContainer.classList.add('hidden');
      newsListEmpty.classList.add('hidden');

      if (!apiUrl) {
        newsListSkeleton.classList.add('hidden');
        newsListEmpty.classList.remove('hidden');
        return;
      }

      fetch(apiUrl)
        .then(r => r.json())
        .then(res => {
          newsListSkeleton.classList.add('hidden');
          if (res.status === 'success' && Array.isArray(res.data) && res.data.length > 0) {
            allNewsItems = res.data.sort((a, b) => {
              const timeA = a.tanggal ? new Date(a.tanggal).getTime() : 0;
              const timeB = b.tanggal ? new Date(b.tanggal).getTime() : 0;
              if (timeB !== timeA) return timeB - timeA;
              const idA = parseInt((a.id || '').replace('news_', '')) || 0;
              const idB = parseInt((b.id || '').replace('news_', '')) || 0;
              return idB - idA;
            });

            renderNewsList(allNewsItems);
          } else {
            newsListEmpty.classList.remove('hidden');
          }
        })
        .catch(err => {
          console.warn("Gagal memuat berita:", err);
          newsListSkeleton.classList.add('hidden');
          newsListEmpty.classList.remove('hidden');
        });
    }

    function renderNewsList(items) {
      newsListContainer.innerHTML = '';
      newsListContainer.classList.remove('hidden');

      items.forEach((item, idx) => {
        const isFirst = idx === 0;
        const card = document.createElement('div');
        card.className = 'ios-glass-card rounded-2xl p-4 sm:p-5 border border-white/10 hover:border-emerald-500/40 transition-all flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 group';

        const photoUrl = formatDriveImageUrl(item.url_foto);
        const imgBlock = photoUrl
          ? `<img src="${photoUrl}" alt="${item.judul}" referrerpolicy="no-referrer" class="w-14 h-14 rounded-xl object-cover border border-white/10 shrink-0 bg-slate-900" />`
          : `<div class="w-14 h-14 rounded-xl bg-emerald-950/80 border border-emerald-500/30 flex items-center justify-center text-gold font-bold font-serif text-xs shrink-0">MA</div>`;

        card.innerHTML = `
          <div class="flex items-center gap-3.5 min-w-0 flex-1">
            ${imgBlock}
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2 mb-1">
                ${isFirst ? '<span class="px-2 py-0.5 rounded-md bg-gold/15 border border-gold/30 text-[10px] font-bold text-gold uppercase tracking-wider">Headline Utama</span>' : ''}
                <span class="text-[11px] text-slate-400 font-medium">${formatDate(item.tanggal)}</span>
                <span class="text-slate-500">&bull;</span>
                <span class="text-[11px] text-slate-400 truncate">${item.penulis || 'Humas'}</span>
              </div>
              <h3 class="text-sm sm:text-base font-serif font-bold text-white group-hover:text-emerald-300 transition-colors truncate">
                ${item.judul || '(Tanpa Judul)'}
              </h3>
            </div>
          </div>

          <div class="flex items-center gap-2 shrink-0 self-end sm:self-center">
            <button 
              type="button" 
              data-idx="${idx}" 
              class="btn-preview-item inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-semibold border border-white/15 transition-all"
            >
              <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
              </svg>
              <span>Pratinjau</span>
            </button>
            
            <button 
              type="button" 
              data-id="${item.id || ''}" 
              data-title="${(item.judul || '').replace(/"/g, '&quot;')}" 
              class="btn-delete-item inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-rose-500/20 hover:bg-rose-500/30 text-rose-200 text-xs font-semibold border border-rose-500/30 transition-all"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
              <span>Hapus</span>
            </button>
          </div>
        `;

        newsListContainer.appendChild(card);
      });

      // Bind Preview
      newsListContainer.querySelectorAll('.btn-preview-item').forEach(btn => {
        btn.addEventListener('click', () => {
          const idx = parseInt(btn.getAttribute('data-idx'));
          openPreview(allNewsItems[idx]);
        });
      });

      // Bind Delete
      newsListContainer.querySelectorAll('.btn-delete-item').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          const title = btn.getAttribute('data-title');
          openDeleteModal(id, title);
        });
      });
    }

    if (btnRefreshList) btnRefreshList.addEventListener('click', loadNewsList);

    // Preview Modal Logic
    const previewModalCard = previewModal?.querySelector('.preview-scrollbar');
    let previewScrollTimer = null;

    if (previewModalCard) {
      previewModalCard.addEventListener('scroll', () => {
        previewModalCard.classList.add('is-scrolling');
        clearTimeout(previewScrollTimer);
        previewScrollTimer = setTimeout(() => {
          previewModalCard.classList.remove('is-scrolling');
        }, 800);
      });
    }

    function openPreview(item) {
      if (!item) return;
      pvTitle.textContent = item.judul || '';
      pvDate.textContent = formatDate(item.tanggal);
      pvPenulis.textContent = item.penulis || 'Humas MA Margajaya';
      pvBody.textContent = item.isi || '';

      const photoUrl = formatDriveImageUrl(item.url_foto);
      if (photoUrl) {
        pvPhoto.src = photoUrl;
        pvPhoto.classList.remove('hidden');
      } else {
        pvPhoto.classList.add('hidden');
      }

      previewModal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      // Reset scroll position when opening
      if (previewModalCard) {
        previewModalCard.scrollTop = 0;
        previewModalCard.classList.remove('is-scrolling');
      }
    }

    function closePreview() {
      previewModal.classList.add('hidden');
      document.body.style.overflow = '';
    }

    if (btnClosePreview) btnClosePreview.addEventListener('click', closePreview);

    // Delete Modal Logic
    function openDeleteModal(id, title) {
      pendingDeleteId = id;
      if (deleteConfirmTitle) deleteConfirmTitle.textContent = `"${title}"`;
      deleteModal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeDeleteModal() {
      deleteModal.classList.add('hidden');
      document.body.style.overflow = '';
      pendingDeleteId = null;
    }

    if (btnCancelDelete) btnCancelDelete.addEventListener('click', closeDeleteModal);

    const deleteNormalState  = document.getElementById('delete-normal-state');
    const deleteLoadingState = document.getElementById('delete-loading-state');

    function showDeleteLoading(show) {
      if (show) {
        deleteNormalState?.classList.add('hidden');
        deleteLoadingState?.classList.remove('hidden');
        if (btnCancelDelete) btnCancelDelete.disabled = true;
      } else {
        deleteLoadingState?.classList.add('hidden');
        deleteNormalState?.classList.remove('hidden');
        if (btnCancelDelete) btnCancelDelete.disabled = false;
      }
    }

    if (btnConfirmDelete) {
      btnConfirmDelete.addEventListener('click', async () => {
        if (!pendingDeleteId) return;
        const apiUrl = getApiUrl();
        if (!apiUrl) {
          showAlert('error', 'URL Google Apps Script belum disetel.');
          closeDeleteModal();
          return;
        }

        // Show loading state
        showDeleteLoading(true);

        try {
          const token = sessionStorage.getItem('margajaya_admin_token') || '';
          const response = await fetch(apiUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify({ action: 'delete', id: pendingDeleteId, token: token })
          });

          const result = await response.json();
          if (result.status === 'success') {
            // Brief pause so user sees the loading state completed
            await new Promise(r => setTimeout(r, 400));
            showAlert('success', '✓ Warta berhasil dihapus dari database. Perubahan akan diterapkan di website dalam 1–2 menit.');
            loadNewsList();
          } else {
            if (result.message && result.message.includes('Token')) {
              showAlert('error', 'Sesi login telah kedaluwarsa. Silakan login kembali.');
              setTimeout(() => { if (btnLogout) btnLogout.click(); }, 1800);
            } else {
              showAlert('error', 'Gagal menghapus warta: ' + (result.message || 'Terjadi kendala pada server.'));
            }
          }
        } catch (err) {
          showAlert('error', 'Gagal terhubung ke API Apps Script: ' + err.message);
        } finally {
          showDeleteLoading(false);
          closeDeleteModal();
        }
      });
    }

    // Photo Upload and Base64 Handler
    if (fotoInput) {
      fotoInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;

        if (file.size > 10 * 1024 * 1024) {
          showAlert('error', 'Ukuran foto maksimal adalah 10 MB.');
          fotoInput.value = '';
          return;
        }

        currentImageName = file.name;
        currentImageType = file.type;

        const reader = new FileReader();
        reader.onload = (ev) => {
          currentBase64Image = ev.target.result;
          imgPreview.src = currentBase64Image;
          previewContainer.classList.remove('hidden');
          if (dropzoneArea) dropzoneArea.classList.add('hidden');
        };
        reader.readAsDataURL(file);
      });
    }

    if (btnRemovePhoto) {
      btnRemovePhoto.addEventListener('click', () => {
        fotoInput.value = '';
        currentBase64Image = null;
        currentImageName = "";
        currentImageType = "";
        previewContainer.classList.add('hidden');
        if (dropzoneArea) dropzoneArea.classList.remove('hidden');
        imgPreview.src = '';
      });
    }

    // News Form Submit Handler
    if (formNews) {
      formNews.addEventListener('submit', async (e) => {
        e.preventDefault();
        const apiUrl = getApiUrl();
        if (!apiUrl) {
          showAlert('error', 'URL Google Apps Script belum disetel. Klik tombol "⚙️ Pengaturan" di navigasi atas.');
          openSettings();
          return;
        }

        setLoading(true);
        hideAlert();

        const token = sessionStorage.getItem('margajaya_admin_token') || '';
        const payload = {
          token: token,
          judul: document.getElementById('judul').value.trim(),
          tanggal: tanggalHiddenInput.value.trim(),
          penulis: document.getElementById('penulis').value.trim(),
          isi: document.getElementById('isi').value.trim(),
          image_base64: currentBase64Image ? currentBase64Image.split(',')[1] : null,
          image_name: currentImageName,
          image_type: currentImageType
        };

        try {
          const response = await fetch(apiUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify(payload)
          });

          const result = await response.json();

          if (result.status === 'success') {
            showAlert('success', `
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div>
                  <div class="font-bold text-sm text-emerald-300">🎉 Warta Berhasil Disimpan ke Sistem!</div>
                  <p class="text-xs text-slate-300 mt-0.5">Warta telah tersimpan di database. Perubahan akan tayang di website dalam 1–2 menit setelah proses build selesai.</p>
                </div>
                <a href="/berita" target="_blank" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-gold hover:bg-gold-soft text-slate-950 font-bold text-xs uppercase tracking-wider transition-all shadow-md shrink-0">
                  <span>Lihat di Halaman Berita &rarr;</span>
                </a>
              </div>
            `);

            formNews.reset();
            updateSelectedDate(new Date());
            if (penulisInput) penulisInput.value = 'Humas MA Margajaya';
            if (btnRemovePhoto) btnRemovePhoto.click();
            setTimeout(loadNewsList, 1500);
          } else {
            if (result.message && result.message.includes('Token')) {
              showAlert('error', 'Sesi login telah kedaluwarsa. Silakan login kembali.');
              setTimeout(() => { if (btnLogout) btnLogout.click(); }, 1800);
            } else {
              showAlert('error', 'Gagal mempublikasikan berita: ' + (result.message || 'Terjadi kesalahan sistem.'));
            }
          }
        } catch (err) {
          showAlert('error', 'Gagal menghubungi API Google Apps Script: ' + err.message);
        } finally {
          setLoading(false);
        }
      });
    }

    // Keyboard Shortcuts
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (!previewModal.classList.contains('hidden')) closePreview();
        if (!deleteModal.classList.contains('hidden')) closeDeleteModal();
        if (!settingsModal.classList.contains('hidden')) closeSettings();
        if (calPopover && !calPopover.classList.contains('hidden')) calPopover.classList.add('hidden');
      }
    });

  })();
</script>
