---
import AdminLayout from '../layouts/AdminLayout.astro';
const newsApiUrl = import.meta.env.PUBLIC_NEWS_API_URL || '';
---

<AdminLayout title="Admin Portal — MA Margajaya Sukadana">

  <!-- =========================================================================
       1. LOGIN GATE SCREEN (2-COLUMN SPLIT SCREEN: BRANDING LEFT + IOS LOGIN RIGHT)
       ========================================================================= -->
  <div id="admin-login-screen" class="min-h-screen flex items-center justify-center p-4 sm:p-6 lg:p-12 z-10">
    <div class="w-full max-w-6xl grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center">
      
      <!-- SISI KIRI: Logo Besar Tanpa Border + Tagline & Identitas Madrasah -->
      <div class="lg:col-span-7 space-y-6 sm:space-y-8 text-left py-4 lg:py-8">
        
        <!-- Big Clean Logo (NO BORDER AT ALL) -->
        <div class="flex items-center gap-6">
          <img 
            src="/logo/logo-ma-margajaya.png" 
            alt="Logo MA Margajaya" 
            class="w-24 h-24 sm:w-32 sm:h-32 object-contain drop-shadow-[0_20px_40px_rgba(0,0,0,0.5)] transform hover:scale-105 transition-transform duration-500"
          />
          <div class="space-y-1">
            <span class="text-xs font-bold uppercase tracking-[0.25em] text-gold block drop-shadow">
              Kementerian Agama RI
            </span>
            <div class="text-sm font-semibold text-white/90">
              Yayasan MPP PUI Ciamis
            </div>
            <div class="text-xs text-emerald-300/80 font-medium">
              Kompleks Ponpes Darul Muawanah
            </div>
          </div>
        </div>

        <!-- Main Heading & Motto -->
        <div class="space-y-3">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif font-bold text-white tracking-tight leading-[1.08] drop-shadow-md">
            Portal Administrasi <br />
            <em class="italic text-gold not-italic">MA Margajaya.</em>
          </h1>
          <p class="text-base sm:text-lg text-slate-200/90 leading-relaxed font-normal max-w-xl">
            Pusat kendali terpadu untuk publikasi warta resmi madrasah, dokumentasi prestasi santri, dan pengelolaan arsip kegiatan civitas akademika.
          </p>
        </div>

      </div>

      <!-- SISI KANAN: Frosted Glass Login Window Card (Soft Ambient Glow on Hover) -->
      <div class="lg:col-span-5 w-full">
        <div class="group relative rounded-3xl p-8 sm:p-10 border border-white/15 hover:border-emerald-400/40 bg-[#06281D]/60 hover:bg-[#06281D]/80 backdrop-blur-3xl shadow-[0_20px_50px_-15px_rgba(0,0,0,0.7)] hover:shadow-[0_25px_60px_-10px_rgba(5,150,105,0.35),0_0_40px_rgba(232,185,35,0.18)] transition-all duration-500 overflow-hidden">
          
          <!-- Soft Interactive Ambient Glow Radial Flare -->
          <div class="pointer-events-none absolute -top-20 -right-20 w-56 h-56 bg-gradient-to-br from-gold/25 via-emerald-500/20 to-transparent rounded-full blur-3xl group-hover:scale-150 group-hover:opacity-100 opacity-40 transition-all duration-700"></div>
          <div class="pointer-events-none absolute -bottom-20 -left-20 w-56 h-56 bg-gradient-to-tr from-emerald-600/20 via-gold/10 to-transparent rounded-full blur-3xl group-hover:scale-125 group-hover:opacity-80 opacity-30 transition-all duration-700"></div>

          <div class="relative z-10 mb-6 space-y-1">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
              <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-emerald-300">Autentikasi Pengelola</span>
            </div>
            <h2 class="text-2xl font-serif font-bold text-white tracking-tight">
              Masuk Dashboard
            </h2>
            <p class="text-xs text-slate-300/80 leading-relaxed">
              Masukkan kunci sandi administrator untuk mengakses sistem pengelolaan warta.
            </p>
          </div>

          <form id="form-login" class="space-y-5">
            <div>
              <label for="admin-password" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
                Kata Sandi Administrator
              </label>
              <div class="relative">
                <input 
                  type="password" 
                  id="admin-password" 
                  required 
                  autocomplete="current-password"
                  placeholder="Masukkan kata sandi..."
                  class="ios-glass-input w-full px-4 py-3.5 pr-11 rounded-xl text-sm placeholder:text-slate-500 font-medium bg-white/10"
                />
                <button 
                  type="button" 
                  id="btn-toggle-pw" 
                  tabindex="-1"
                  aria-label="Tampilkan Password"
                  class="absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white transition-colors"
                >
                  <svg id="eye-open" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                  </svg>
                  <svg id="eye-closed" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path>
                  </svg>
                </button>
              </div>
            </div>

            <div id="login-error" class="hidden text-xs text-rose-300 bg-rose-950/80 p-3.5 rounded-xl border border-rose-500/40 flex items-center gap-2">
              <svg class="w-4 h-4 text-rose-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
              </svg>
              <span>Kata sandi tidak sesuai. Silakan periksa kembali.</span>
            </div>

            <button 
              type="submit" 
              class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-emerald-600 via-emerald-500 to-emerald-600 hover:from-emerald-500 hover:to-emerald-400 text-white text-xs font-bold uppercase tracking-widest transition-all shadow-[0_10px_25px_-5px_rgba(5,150,105,0.5)] hover:shadow-[0_15px_35px_-5px_rgba(5,150,105,0.7)] hover:scale-[1.01] active:scale-[0.99] flex items-center justify-center gap-2"
            >
              <span>Masuk ke Dashboard</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </button>
          </form>

          <div class="mt-6 pt-5 border-t border-white/10 text-center">
            <p class="text-[11px] text-slate-400 flex items-center justify-center gap-1.5 font-medium">
              <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
              </svg>
              <span>Akses Khusus Civitas MA Margajaya Sukadana</span>
            </p>
          </div>

        </div>
      </div>

    </div>
  </div>


  <!-- =========================================================================
       2. MAIN ADMIN DASHBOARD (SINGLE PAGE SCROLL: FORM + ARCHIVES)
       ========================================================================= -->
  <div id="admin-dashboard" class="hidden min-h-screen flex-1 flex flex-col" data-api-url={newsApiUrl}>
    
    <!-- macOS Floating Frosted Navbar Header (Ultra Clean & Minimal) -->
    <header class="ios-glass-nav sticky top-0 z-40">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between gap-4">
        
        <!-- Left Brand -->
        <div class="flex items-center gap-3.5">
          <img src="/logo/logo-ma-margajaya.png" alt="Logo" class="w-10 h-10 object-contain drop-shadow" />
          <div>
            <h1 class="font-serif text-base sm:text-lg font-bold text-white tracking-tight leading-tight">
              MA Margajaya
            </h1>
            <p class="text-[11px] text-slate-400 font-medium">
              Portal Pengelolaan Berita &amp; Warta
            </p>
          </div>
        </div>

        <!-- Right Clean Actions -->
        <div class="flex items-center gap-2 sm:gap-3">
          
          <!-- View Public Website -->
          <a 
            href="/" 
            target="_blank" 
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white/10 hover:bg-white/15 text-white text-xs font-semibold border border-white/15 transition-all shadow-sm"
            title="Lihat Website Utama"
          >
            <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
            </svg>
            <span class="hidden sm:inline">Lihat Web</span>
          </a>

          <!-- Settings Button (Opens macOS Settings Dialog) -->
          <button 
            id="btn-open-settings" 
            type="button" 
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white/10 hover:bg-white/15 text-white text-xs font-semibold border border-white/15 transition-all shadow-sm"
            title="Pengaturan Sistem & Integrasi API"
          >
            <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
            <span>Pengaturan</span>
          </button>

          <!-- Logout Button -->
          <button 
            id="btn-logout" 
            type="button" 
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-rose-500/20 hover:bg-rose-500/30 text-rose-200 text-xs font-semibold border border-rose-500/30 transition-all shadow-sm"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
            </svg>
            <span>Keluar</span>
          </button>

        </div>

      </div>
    </header>

    <!-- Main Container Content (Single Page Scroll Layout) -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-12 flex-1 w-full">

      <!-- =========================================================================
           SECTION 1: FORMULIR PUBLIKASI WARTA (Apple macOS Window Form)
           ========================================================================= -->
      <div class="ios-glass-card rounded-3xl p-6 sm:p-10 border border-white/15 shadow-2xl relative overflow-hidden">
        
        <!-- Header Strip -->
        <div class="border-b border-white/10 pb-6 mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 mb-1.5">
              <span class="w-4 h-[2px] bg-gold rounded-full"></span>
              <span class="text-[11px] font-bold uppercase tracking-[0.2em] text-gold">Editor Warta</span>
            </div>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-white tracking-tight">
              Tulis &amp; Publikasikan Warta Baru
            </h2>
            <p class="text-xs text-slate-300/80 mt-1">
              Data artikel dan foto dokumentasi otomatis disinkronkan ke Google Sheets &amp; Google Drive sekolah.
            </p>
          </div>

          <div class="flex items-center gap-2">
            <span class="px-3 py-1.5 rounded-full bg-emerald-500/10 text-emerald-300 border border-emerald-500/30 text-[11px] font-bold uppercase tracking-wider">
              Format Siap Tayang
            </span>
          </div>
        </div>

        <!-- Dynamic Form Alert Message -->
        <div id="form-alert" class="hidden mb-8 p-4 sm:p-5 rounded-2xl text-xs sm:text-sm leading-relaxed font-medium transition-all"></div>

        <!-- Form Element -->
        <form id="form-news" class="space-y-6">
          
          <!-- Judul Warta -->
          <div>
            <label for="judul" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
              Judul Berita / Prestasi <span class="text-rose-400">*</span>
            </label>
            <input 
              type="text" 
              id="judul" 
              name="judul" 
              required 
              placeholder="Contoh: Santri MA Margajaya Raih Juara 1 Olimpiade Sains Madrasah 2026"
              class="ios-glass-input w-full px-4 sm:px-5 py-3.5 rounded-xl text-sm placeholder:text-slate-500 font-medium"
            />
          </div>

          <!-- Grid: Tanggal (CUSTOM THEME CALENDAR) & Penulis -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            
            <!-- Custom Theme Calendar Datepicker -->
            <div class="relative">
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
                Tanggal Kegiatan <span class="text-rose-400">*</span>
              </label>
              
              <!-- Hidden input for standard YYYY-MM-DD storage -->
              <input type="hidden" id="tanggal" name="tanggal" required value="" />

              <!-- Custom Interactive Trigger Button -->
              <button 
                type="button" 
                id="btn-custom-date" 
                class="ios-glass-input w-full px-4 sm:px-5 py-3.5 rounded-xl text-sm font-medium flex items-center justify-between text-left hover:border-gold/50 transition-colors group"
              >
                <span id="date-display-text" class="text-white font-semibold">
                  Memuat tanggal...
                </span>
                <div class="w-7 h-7 rounded-lg bg-emerald-500/15 text-gold flex items-center justify-center group-hover:scale-110 transition-transform">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                </div>
              </button>

              <!-- Custom Emerald & Gold Theme Calendar Popup Popover -->
              <div 
                id="custom-calendar-popover" 
                class="hidden absolute top-full left-0 mt-2 z-50 w-80 p-5 rounded-3xl ios-glass-panel border border-gold/30 bg-[#062417]/95 shadow-2xl backdrop-blur-2xl"
              >
                <!-- Month & Year Navigation Header -->
                <div class="flex items-center justify-between pb-3 mb-3 border-b border-white/10">
                  <button 
                    type="button" 
                    id="cal-prev-month" 
                    class="w-8 h-8 rounded-xl bg-white/10 hover:bg-emerald-500/20 text-white flex items-center justify-center transition-colors"
                  >
                    &lsaquo;
                  </button>
                  <div id="cal-month-year-title" class="font-serif font-bold text-sm text-gold tracking-wide">
                    September 2026
                  </div>
                  <button 
                    type="button" 
                    id="cal-next-month" 
                    class="w-8 h-8 rounded-xl bg-white/10 hover:bg-emerald-500/20 text-white flex items-center justify-center transition-colors"
                  >
                    &rsaquo;
                  </button>
                </div>

                <!-- Weekday Headers -->
                <div class="grid grid-cols-7 gap-1 text-center text-[10px] font-bold uppercase text-slate-400 mb-2">
                  <span>Ahd</span>
                  <span>Sen</span>
                  <span>Sel</span>
                  <span>Rab</span>
                  <span>Kam</span>
                  <span>Jum</span>
                  <span>Sab</span>
                </div>

                <!-- Days Matrix Grid -->
                <div id="cal-days-grid" class="grid grid-cols-7 gap-1">
                  <!-- Rendered via JS -->
                </div>

                <!-- Quick Today Button -->
                <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between">
                  <button 
                    type="button" 
                    id="cal-btn-today" 
                    class="text-[11px] font-bold uppercase tracking-wider text-emerald-300 hover:text-white transition-colors"
                  >
                    Pilih Hari Ini
                  </button>
                  <button 
                    type="button" 
                    id="cal-btn-close" 
                    class="text-[11px] font-semibold text-slate-400 hover:text-white transition-colors"
                  >
                    Tutup
                  </button>
                </div>
              </div>
            </div>

            <!-- Penulis / Unit -->
            <div>
              <label for="penulis" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
                Penulis / Unit Peliput <span class="text-rose-400">*</span>
              </label>
              <input 
                type="text" 
                id="penulis" 
                name="penulis" 
                required 
                placeholder="Humas MA Margajaya"
                class="ios-glass-input w-full px-4 sm:px-5 py-3.5 rounded-xl text-sm placeholder:text-slate-500 font-medium"
              />
            </div>

          </div>

          <!-- Drag & Drop Photo Upload Zone -->
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
              Foto Dokumentasi Utama (Opsional)
            </label>
            
            <label 
              for="foto" 
              id="dropzone-area"
              class="flex flex-col items-center justify-center gap-3 p-8 rounded-2xl border-2 border-dashed border-white/20 hover:border-emerald-400/60 bg-white/[0.02] hover:bg-emerald-950/20 transition-all cursor-pointer group"
            >
              <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
              </div>
              <div class="text-center space-y-1">
                <div class="text-sm font-semibold text-white group-hover:text-emerald-300 transition-colors">
                  Klik untuk Memilih Foto atau Seret File ke Sini
                </div>
                <p class="text-xs text-slate-400">
                  Format: JPG, PNG, WEBP &bull; Maksimum Ukuran: 10 MB
                </p>
              </div>
              <input type="file" id="foto" name="foto" accept="image/*" class="hidden" />
            </label>

            <!-- Image Live Preview Container -->
            <div id="preview-container" class="hidden mt-4 p-4 rounded-2xl ios-glass-card border border-emerald-500/30">
              <div class="flex items-center justify-between mb-3 px-1">
                <span class="text-xs font-bold uppercase tracking-wider text-emerald-300 flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Pratinjau Foto Dokumentasi</span>
                </span>
                <button 
                  type="button" 
                  id="btn-remove-photo" 
                  class="text-xs text-rose-400 hover:text-rose-300 font-bold uppercase tracking-wider flex items-center gap-1 transition-colors"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                  </svg>
                  <span>Hapus Foto</span>
                </button>
              </div>
              <img 
                id="img-preview" 
                src="" 
                alt="Pratinjau" 
                class="max-h-72 w-full object-cover rounded-xl border border-white/10 shadow-lg mx-auto" 
              />
            </div>
          </div>

          <!-- Isi / Deskripsi Berita -->
          <div>
            <label for="isi" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
              Isi Narasi &amp; Detail Warta <span class="text-rose-400">*</span>
            </label>
            <textarea 
              id="isi" 
              name="isi" 
              rows="7" 
              required 
              placeholder="Tuliskan isi berita secara lengkap, fakta kegiatan, nama-nama santri berprestasi, dan pernyataan resmi..."
              class="ios-glass-input w-full px-4 sm:px-5 py-4 rounded-xl text-sm placeholder:text-slate-500 font-normal leading-relaxed"
            ></textarea>
          </div>

          <!-- Submit Bar -->
          <div class="pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
            <p class="text-xs text-slate-400">
              Pastikan data sudah valid sebelum mengirimkan ke sistem publikasi.
            </p>
            
            <button 
              type="submit" 
              id="btn-submit" 
              class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-emerald-600 via-emerald-500 to-emerald-600 hover:from-emerald-500 hover:to-emerald-400 text-white text-xs font-bold uppercase tracking-widest transition-all shadow-[0_10px_30px_-5px_rgba(5,150,105,0.4)] hover:shadow-[0_15px_35px_-5px_rgba(5,150,105,0.6)] hover:scale-[1.01] active:scale-[0.99] flex items-center justify-center gap-2.5 disabled:opacity-50 disabled:cursor-not-allowed"
            >
              <span id="btn-spinner" class="hidden w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
