      <!-- Floating Close Button -->
      <button 
        id="btn-close-preview" 
        type="button" 
        aria-label="Tutup pratinjau"
        class="absolute top-4 right-4 z-30 w-8 h-8 flex items-center justify-center text-slate-400 hover:text-white transition-colors rounded-full hover:bg-white/10"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>

      <!-- Article Reading Body -->
      <div class="p-6 sm:p-10 pt-12 space-y-6">
        <h2 id="pv-title" class="font-serif text-2xl sm:text-3xl lg:text-4xl font-bold text-white leading-tight pr-6"></h2>
        
        <div class="flex flex-wrap items-center gap-4 text-xs text-slate-400 pb-4 border-b border-white/10">
          <div class="flex items-center gap-2">
            <span class="text-slate-500">Tanggal:</span>
            <span id="pv-date" class="font-semibold text-gold"></span>
          </div>
          <span>&bull;</span>
          <div class="flex items-center gap-2">
            <span class="text-slate-500">Penulis:</span>
            <span id="pv-penulis" class="text-slate-300 font-medium"></span>
