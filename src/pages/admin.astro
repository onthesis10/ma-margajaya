</AdminLayout>

<script is:inline>
  // =========================================================================
  // JAVASCRIPT CONTROLLER FOR COMPACT CMS ADMIN PORTAL
  // =========================================================================
  (function() {
    // DOM Elements
    const dashboardEl = document.getElementById('admin-dashboard');
    const loginScreen = document.getElementById('admin-login-screen');
    
    // Backend API & Deploy Hook (Strictly pulled from data attributes / environment)
    const API_URL = dashboardEl ? dashboardEl.getAttribute('data-api-url') : "";
    const DEPLOY_HOOK = dashboardEl ? dashboardEl.getAttribute('data-deploy-hook') : "";

    // Auth Elements
    const formLogin = document.getElementById('form-login');
    const adminPasswordInput = document.getElementById('admin-password');
    const loginError = document.getElementById('login-error');
    const btnTogglePw = document.getElementById('btn-toggle-pw');
    const eyeOpen = document.getElementById('eye-open');
    const eyeClosed = document.getElementById('eye-closed');
    const btnLogout = document.getElementById('btn-logout');

    // Header Quick Rebuild Button
    const btnRebuildWeb = document.getElementById('btn-rebuild-web');
    const iconRebuild = document.getElementById('icon-rebuild');

    // Tab Navigation Elements
    const tabBtnEditor = document.getElementById('tab-btn-editor');
    const tabBtnArchives = document.getElementById('tab-btn-archives');
    const tabBtnEditorMobile = document.getElementById('tab-btn-editor-mobile');
    const tabBtnArchivesMobile = document.getElementById('tab-btn-archives-mobile');
    const sectionEditor = document.getElementById('section-editor');
    const sectionArchives = document.getElementById('section-archives');
    const badgeArchiveCount = document.getElementById('badge-archive-count');
    const badgeArchiveCountMobile = document.getElementById('badge-archive-count-mobile');
    const btnGotoEditor = document.getElementById('btn-goto-editor');

    // Form News Elements
    const formNews = document.getElementById('form-news');
    const judulInput = document.getElementById('judul');
    const isiInput = document.getElementById('isi');
    const editorCounter = document.getElementById('editor-counter');
    const tanggalHiddenInput = document.getElementById('tanggal');
    const penulisInput = document.getElementById('penulis');
    const fotoInput = document.getElementById('foto');
    const dropzoneArea = document.getElementById('dropzone-area');
    const previewContainer = document.getElementById('preview-container');
    const imgPreview = document.getElementById('img-preview');
    const btnRemovePhoto = document.getElementById('btn-remove-photo');
    const formAlert = document.getElementById('form-alert');
    const btnSubmit = document.getElementById('btn-submit');
    const btnSpinner = document.getElementById('btn-spinner');
    const btnIcon = document.getElementById('btn-icon');
    const btnText = document.getElementById('btn-text');
    const btnResetForm = document.getElementById('btn-reset-form');

    // Textarea Formatting Toolbar Buttons (now unused — toolbar uses data-command)
    const btnFmtClear = document.getElementById('btn-fmt-clear');

    // Author Preset Chips
    const authorPresetBtns = document.querySelectorAll('.btn-author-preset');

    // Custom Calendar Datepicker Elements
    const btnCustomDate = document.getElementById('btn-custom-date');
    const dateDisplayText = document.getElementById('date-display-text');
    const calPopover = document.getElementById('custom-calendar-popover');
    const calPrevMonth = document.getElementById('cal-prev-month');
    const calNextMonth = document.getElementById('cal-next-month');
    const calMonthYearTitle = document.getElementById('cal-month-year-title');
    const calDaysGrid = document.getElementById('cal-days-grid');
    const calBtnToday = document.getElementById('cal-btn-today');
    const calBtnClose = document.getElementById('cal-btn-close');

    // Archives Section Elements
    const newsListSkeleton = document.getElementById('news-list-skeleton');
    const newsListContainer = document.getElementById('news-list-container');
    const newsListEmpty = document.getElementById('news-list-empty');
    const btnRefreshList = document.getElementById('btn-refresh-list');
    const iconRefreshNews = document.getElementById('icon-refresh-news');
    const inputSearchNews = document.getElementById('input-search-news');

    // Preview Modal Elements
    const previewModal = document.getElementById('preview-modal');
    const btnClosePreview = document.getElementById('btn-close-preview');
    const pvTitle = document.getElementById('pv-title');
    const pvDate = document.getElementById('pv-date');
    const pvPenulis = document.getElementById('pv-penulis');
    const pvPhoto = document.getElementById('pv-photo');
    const pvBody = document.getElementById('pv-body');

    // Delete Modal Elements
    const deleteModal = document.getElementById('delete-modal');
    const deleteConfirmTitle = document.getElementById('delete-confirm-title');
    const btnCancelDelete = document.getElementById('btn-cancel-delete');
    const btnConfirmDelete = document.getElementById('btn-confirm-delete');
    const deleteNormalState  = document.getElementById('delete-normal-state');
    const deleteLoadingState = document.getElementById('delete-loading-state');

    // App State
    let currentBase64Image = null;
    let currentImageName = "";
    let currentImageType = "";
    let allNewsItems = [];
    let pendingDeleteId = null;

    // Helper: Date Formatter
    const monthNames = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];
    const dayNames = ["Minggu", "Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu"];
    
    function formatDate(raw) {
      if (!raw) return '—';
      const d = new Date(raw);
      if (isNaN(d.getTime())) return String(raw);
      return `${d.getDate()} ${monthNames[d.getMonth()]} ${d.getFullYear()}`;
    }

    function formatLongDate(d) {
      return `${dayNames[d.getDay()]}, ${d.getDate()} ${monthNames[d.getMonth()]} ${d.getFullYear()}`;
    }

    function formatDriveImageUrl(url) {
      if (!url) return '';
      const str = String(url).trim();
      const match = str.match(/\/d\/([a-zA-Z0-9_-]+)/) || str.match(/id=([a-zA-Z0-9_-]+)/) || str.match(/\/file\/d\/([a-zA-Z0-9_-]+)/);
      if (match && match[1]) {
        return `https://drive.google.com/thumbnail?id=${match[1]}&sz=w800`;
      }
      return str;
    }

    const FALLBACK_API_URL = "https://script.google.com/macros/s/AKfycbwboX_4labGuJ9412coI1JrXzpxb11B3xJOlmloGnEsTsRui-yIdssRFl8i2CGga1IF/exec";
    const FALLBACK_DEPLOY_HOOK = "https://api.vercel.com/v1/integrations/deploy/prj_umwjoNnXfJTjqzpiHS7qcLu3kVpH/rUwycrCtVI";

    function getApiUrl() {
      return (localStorage.getItem('margajaya_api_url') || '').trim() || API_URL || FALLBACK_API_URL;
    }

    function getDeployHookUrl() {
      return (localStorage.getItem('margajaya_deploy_hook') || '').trim() || DEPLOY_HOOK || FALLBACK_DEPLOY_HOOK;
    }

    // =========================================================================
    // TAB SWITCHER — Animated Sliding Pill (Framer-Motion-like via CSS)
    // =========================================================================
    const tabIndicator = document.getElementById('tab-indicator');
    const tabIndicatorMobile = document.getElementById('tab-indicator-mobile');
    const tabNav = document.getElementById('tab-nav');
    const tabNavMobile = document.getElementById('tab-nav-mobile');

    function positionIndicator(activeBtn, indicator, nav) {
      if (!indicator || !nav || !activeBtn) return;
      const navRect = nav.getBoundingClientRect();
      const btnRect = activeBtn.getBoundingClientRect();
      indicator.style.width = btnRect.width + 'px';
      indicator.style.left = (btnRect.left - navRect.left) + 'px';
    }

    function switchTab(tab) {
      const isEditor = tab === 'editor';

      // Show/hide sections
      sectionEditor.classList.toggle('hidden', !isEditor);
      sectionArchives.classList.toggle('hidden', isEditor);

      // Desktop: update indicator position
      positionIndicator(
        isEditor ? tabBtnEditor : tabBtnArchives,
        tabIndicator,
        tabNav
      );

      // Desktop: update button text colors
      tabBtnEditor?.setAttribute('aria-selected', isEditor ? 'true' : 'false');
      tabBtnArchives?.setAttribute('aria-selected', isEditor ? 'false' : 'true');
      tabBtnEditor?.classList.toggle('text-white', isEditor);
      tabBtnEditor?.classList.toggle('text-slate-400', !isEditor);
      tabBtnArchives?.classList.toggle('text-white', !isEditor);
      tabBtnArchives?.classList.toggle('text-slate-400', isEditor);

      // Mobile: update indicator position
      positionIndicator(
        isEditor ? tabBtnEditorMobile : tabBtnArchivesMobile,
        tabIndicatorMobile,
        tabNavMobile
      );

      // Mobile: update text colors
      tabBtnEditorMobile?.classList.toggle('text-white', isEditor);
      tabBtnEditorMobile?.classList.toggle('text-slate-400', !isEditor);
      tabBtnArchivesMobile?.classList.toggle('text-white', !isEditor);
      tabBtnArchivesMobile?.classList.toggle('text-slate-400', isEditor);

      // Auto load news list on first open
      if (!isEditor && allNewsItems.length === 0) {
        loadNewsList();
      }
    }

    // Init indicator after layout paint
    function initTabIndicator() {
      positionIndicator(tabBtnEditor, tabIndicator, tabNav);
      positionIndicator(tabBtnEditorMobile, tabIndicatorMobile, tabNavMobile);
    }
    // Use requestAnimationFrame to ensure layout is computed
    requestAnimationFrame(() => { requestAnimationFrame(initTabIndicator); });

    if (tabBtnEditor) tabBtnEditor.addEventListener('click', () => switchTab('editor'));
    if (tabBtnArchives) tabBtnArchives.addEventListener('click', () => switchTab('archives'));
    if (tabBtnEditorMobile) tabBtnEditorMobile.addEventListener('click', () => switchTab('editor'));
    if (tabBtnArchivesMobile) tabBtnArchivesMobile.addEventListener('click', () => switchTab('archives'));
    if (btnGotoEditor) btnGotoEditor.addEventListener('click', () => switchTab('editor'));

    // =========================================================================
    // WYSIWYG RICH TEXT EDITOR (contenteditable + execCommand)
    // =========================================================================
    const isiEditor = document.getElementById('isi');         // contenteditable div
    const isiHidden = document.getElementById('isi-hidden'); // hidden textarea

    // Re-alias isiInput to isiEditor for word count and other consumers
    const isiInput = isiEditor;

    function updateWordCount() {
      if (!isiEditor || !editorCounter) return;
      const text = (isiEditor.innerText || '').trim();
      const words = text ? text.split(/\s+/).filter(Boolean).length : 0;
      const chars = text.length;
      editorCounter.textContent = `${words} kata \u2022 ${chars} karakter`;
    }

    function syncHiddenTextarea() {
      if (isiHidden && isiEditor) {
        // Store the full innerHTML so rich formatting (bold, italic,
        // underline, lists, blockquotes, headings) is preserved in Sheets
        // and rendered correctly on the public article page.
        const html = isiEditor.innerHTML;
        isiHidden.value = html;
        // Validate required: check visible text only
        const hasText = (isiEditor.innerText || '').trim().length > 0;
        isiHidden.required = !hasText;
      }
    }

    // Toolbar execCommand dispatcher
    function execFormat(command, value) {
      isiEditor.focus();
      document.execCommand(command, false, value || null);
      updateWordCount();
      updateToolbarState();
    }

    // Highlight active toolbar buttons based on current selection
    function updateToolbarState() {
      document.querySelectorAll('.toolbar-btn[data-command]').forEach(btn => {
        const cmd = btn.getAttribute('data-command');
        try {
          const active = document.queryCommandState(cmd);
          btn.classList.toggle('is-active', active);
        } catch(e) {}
      });
    }

    if (isiEditor) {
      isiEditor.addEventListener('input', () => { updateWordCount(); syncHiddenTextarea(); });
      isiEditor.addEventListener('keyup', updateToolbarState);
      isiEditor.addEventListener('mouseup', updateToolbarState);
      isiEditor.addEventListener('selectionchange', updateToolbarState);

      // Keyboard shortcuts
      isiEditor.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey)) {
          const k = e.key.toLowerCase();
          if (k === 'b') { e.preventDefault(); execFormat('bold'); }
          if (k === 'i') { e.preventDefault(); execFormat('italic'); }
          if (k === 'u') { e.preventDefault(); execFormat('underline'); }
        }
      });
    }

    // Bind all toolbar buttons with data-command attribute
    document.querySelectorAll('.toolbar-btn[data-command]').forEach(btn => {
      btn.addEventListener('mousedown', (e) => {
        e.preventDefault(); // Prevent editor from losing focus
        const cmd = btn.getAttribute('data-command');
        const val = btn.getAttribute('data-value') || null;
        execFormat(cmd, val);
      });
    });

    // Clear formatting button
    if (btnFmtClear) {
      btnFmtClear.addEventListener('mousedown', (e) => {
        e.preventDefault();
        isiEditor.focus();
        document.execCommand('removeFormat', false, null);
        document.execCommand('formatBlock', false, 'p');
        updateWordCount();
        syncHiddenTextarea();
        updateToolbarState();
      });
    }

    // Author Preset ClickersClickers
    authorPresetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-value');
        if (penulisInput && val) {
          penulisInput.value = val;
          penulisInput.focus();
        }
      });
    });

    // Reset Form
    if (btnResetForm) {
      btnResetForm.addEventListener('click', () => {
        if (confirm('Apakah Anda yakin ingin mengosongkan draf editor warta?')) {
          formNews.reset();
          if (isiEditor) isiEditor.innerHTML = ''; // Clear contenteditable
          if (isiHidden) isiHidden.value = '';
          updateSelectedDate(new Date());
          if (penulisInput) penulisInput.value = 'Humas MA Margajaya';
          if (btnRemovePhoto) btnRemovePhoto.click();
          updateWordCount();
          hideAlert();
        }
      });
    }

    // =========================================================================
    // VERCEL REBUILD TRIGGER
    // =========================================================================
    async function triggerVercelDeploy(isManual = false) {
      const hookUrl = getDeployHookUrl();
      if (!hookUrl) return false;

      if (iconRebuild) iconRebuild.classList.add('animate-spin');
      try {
        await fetch(hookUrl, { method: 'POST' });
        if (isManual) {
          showAlert('success', `
            <div class="flex items-start sm:items-center gap-3.5">
              <div class="w-9 h-9 rounded-xl bg-emerald-500/20 text-emerald-300 flex items-center justify-center shrink-0 border border-emerald-500/30">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                </svg>
              </div>
              <div class="space-y-0.5">
                <div class="font-serif font-bold text-sm sm:text-base text-white tracking-wide">Sinkronisasi Portal Berhasil Diinisiasi</div>
                <p class="text-xs text-emerald-200/90 leading-relaxed font-normal">Sistem sedang memperbarui kompilasi data publik. Perubahan terkini akan terefleksi pada website madrasah dalam kurun waktu 40–60 detik.</p>
              </div>
            </div>
          `);
        }
        return true;
      } catch (err) {
        console.warn('Gagal memicu Vercel Deploy Hook:', err);
        if (isManual) {
          showAlert('error', `
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-xl bg-rose-500/20 text-rose-300 flex items-center justify-center shrink-0 border border-rose-500/30">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
              </div>
              <div class="space-y-0.5">
                <div class="font-bold text-sm text-white">Kendala Sinkronisasi Server</div>
                <p class="text-xs text-rose-200/90 leading-relaxed font-normal">Gagal menghubungi layanan sinkronisasi otomatis: ${err.message}. Silakan periksa jaringan.</p>
              </div>
            </div>
          `);
        }
        return false;
      } finally {
        if (iconRebuild) {
          setTimeout(() => iconRebuild.classList.remove('animate-spin'), 1500);
        }
      }
    }

    if (btnRebuildWeb) {
      btnRebuildWeb.addEventListener('click', () => {
        triggerVercelDeploy(true);
      });
    }

    function showAlert(type, htmlContent) {
      formAlert.className = 'mb-6 p-4 sm:p-5 rounded-2xl text-xs sm:text-sm leading-relaxed font-medium transition-all ' + 
        (type === 'success' 
          ? 'bg-emerald-950/80 text-emerald-200 border border-emerald-500/40 shadow-lg shadow-emerald-950/40' 
          : 'bg-rose-950/80 text-rose-200 border border-rose-500/40 shadow-lg shadow-rose-950/40');
      formAlert.innerHTML = htmlContent;
      formAlert.classList.remove('hidden');
      formAlert.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function hideAlert() {
      formAlert.classList.add('hidden');
    }

    function setLoading(isLoading) {
      btnSubmit.disabled = isLoading;
      btnSpinner.classList.toggle('hidden', !isLoading);
      btnIcon.classList.toggle('hidden', isLoading);
      btnText.textContent = isLoading ? 'Menyimpan...' : 'Publikasikan';
    }

    // Toggle Password Visibility
    if (btnTogglePw) {
      btnTogglePw.addEventListener('click', () => {
        const isText = adminPasswordInput.type === 'text';
        adminPasswordInput.type = isText ? 'password' : 'text';
        eyeOpen.classList.toggle('hidden', !isText);
        eyeClosed.classList.toggle('hidden', isText);
      });
    }

    // =========================================================================
    // CUSTOM EMERALD & GOLD THEME CALENDAR LOGIC
    // =========================================================================
    let selectedDate = new Date();
    let currentCalMonth = selectedDate.getMonth();
    let currentCalYear = selectedDate.getFullYear();

    function updateSelectedDate(d) {
      selectedDate = new Date(d);
      const year = selectedDate.getFullYear();
      const month = String(selectedDate.getMonth() + 1).padStart(2, '0');
      const day = String(selectedDate.getDate()).padStart(2, '0');
      const isoString = `${year}-${month}-${day}`;

      if (tanggalHiddenInput) tanggalHiddenInput.value = isoString;
      if (dateDisplayText) dateDisplayText.textContent = formatLongDate(selectedDate);
    }

    function renderCustomCalendar() {
      if (!calMonthYearTitle || !calDaysGrid) return;
      calMonthYearTitle.textContent = `${monthNames[currentCalMonth]} ${currentCalYear}`;

      calDaysGrid.innerHTML = '';

      const firstDay = new Date(currentCalYear, currentCalMonth, 1).getDay();
      const daysInMonth = new Date(currentCalYear, currentCalMonth + 1, 0).getDate();
      const today = new Date();

      for (let i = 0; i < firstDay; i++) {
        const emptyCell = document.createElement('div');
        emptyCell.className = 'h-7 w-7';
        calDaysGrid.appendChild(emptyCell);
      }

      for (let day = 1; day <= daysInMonth; day++) {
        const cell = document.createElement('button');
        cell.type = 'button';
        cell.textContent = String(day);
        
        const isSelected = selectedDate.getDate() === day && 
                           selectedDate.getMonth() === currentCalMonth && 
                           selectedDate.getFullYear() === currentCalYear;

        const isToday = today.getDate() === day && 
                        today.getMonth() === currentCalMonth && 
                        today.getFullYear() === currentCalYear;

        if (isSelected) {
          cell.className = 'h-7 w-7 rounded-lg bg-gold text-slate-950 font-bold text-[11px] shadow-md shadow-gold/30 flex items-center justify-center transition-all scale-105';
        } else if (isToday) {
          cell.className = 'h-7 w-7 rounded-lg border border-gold text-gold font-bold text-[11px] flex items-center justify-center hover:bg-emerald-500/20 transition-all';
        } else {
          cell.className = 'h-7 w-7 rounded-lg text-slate-200 hover:bg-emerald-500/20 hover:text-white text-[11px] font-medium flex items-center justify-center transition-all';
        }

        cell.addEventListener('click', () => {
          updateSelectedDate(new Date(currentCalYear, currentCalMonth, day));
          renderCustomCalendar();
          if (calPopover) calPopover.classList.add('hidden');
        });

        calDaysGrid.appendChild(cell);
      }
    }

    if (btnCustomDate) {
      btnCustomDate.addEventListener('click', (e) => {
        e.stopPropagation();
        if (calPopover) {
          calPopover.classList.toggle('hidden');
          currentCalMonth = selectedDate.getMonth();
          currentCalYear = selectedDate.getFullYear();
          renderCustomCalendar();
        }
      });
    }

    if (calPrevMonth) {
      calPrevMonth.addEventListener('click', (e) => {
        e.stopPropagation();
        currentCalMonth--;
        if (currentCalMonth < 0) {
          currentCalMonth = 11;
          currentCalYear--;
        }
        renderCustomCalendar();
      });
    }

    if (calNextMonth) {
      calNextMonth.addEventListener('click', (e) => {
        e.stopPropagation();
        currentCalMonth++;
        if (currentCalMonth > 11) {
          currentCalMonth = 0;
          currentCalYear++;
        }
        renderCustomCalendar();
      });
    }

    if (calBtnToday) {
      calBtnToday.addEventListener('click', (e) => {
        e.stopPropagation();
        const now = new Date();
        currentCalMonth = now.getMonth();
        currentCalYear = now.getFullYear();
        updateSelectedDate(now);
        renderCustomCalendar();
        if (calPopover) calPopover.classList.add('hidden');
      });
    }

    if (calBtnClose) {
      calBtnClose.addEventListener('click', () => {
        if (calPopover) calPopover.classList.add('hidden');
      });
    }

    document.addEventListener('click', (e) => {
      if (calPopover && !calPopover.contains(e.target) && e.target !== btnCustomDate && !btnCustomDate?.contains(e.target)) {
        calPopover.classList.add('hidden');
      }
    });

    // Initialize with today
    updateSelectedDate(new Date());

    // =========================================================================
    // AUTHENTICATION CONTROLLER
    // =========================================================================
    function showDashboard() {
      loginScreen.classList.add('hidden');
      dashboardEl.classList.remove('hidden');
      initDashboard();
    }

    function showLogin() {
      loginScreen.classList.remove('hidden');
      dashboardEl.classList.add('hidden');
      adminPasswordInput.value = '';
    }

    if (sessionStorage.getItem('margajaya_admin_logged_in') === 'true') {
      showDashboard();
    }

    if (formLogin) {
      formLogin.addEventListener('submit', async (e) => {
        e.preventDefault();
        const pwd = adminPasswordInput.value.trim();
        if (!pwd) return;

        const apiUrl = getApiUrl();
        if (!apiUrl) {
          loginError.classList.remove('hidden');
          const errorMsgSpan = loginError.querySelector('span');
          if (errorMsgSpan) errorMsgSpan.textContent = 'Konfigurasi Google Apps Script URL tidak ditemukan di environment.';
          return;
        }

        const btnLoginSubmit = formLogin.querySelector('button[type="submit"]');
        const originalBtnText = btnLoginSubmit ? btnLoginSubmit.innerHTML : '';
        if (btnLoginSubmit) {
          btnLoginSubmit.disabled = true;
          btnLoginSubmit.innerHTML = '<span>Memverifikasi Sandi...</span>';
        }

        try {
          const res = await fetch(apiUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify({ action: 'login', password: pwd })
          });
          const data = await res.json();
          if (data.status === 'success' && data.token) {
            sessionStorage.setItem('margajaya_admin_logged_in', 'true');
            sessionStorage.setItem('margajaya_admin_token', data.token);
            loginError.classList.add('hidden');
            showDashboard();
          } else {
            loginError.classList.remove('hidden');
            const errorMsgSpan = loginError.querySelector('span');
            if (errorMsgSpan) errorMsgSpan.textContent = data.message || 'Kata sandi tidak sesuai. Silakan periksa kembali.';
            adminPasswordInput.value = '';
            adminPasswordInput.focus();
          }
        } catch (err) {
          loginError.classList.remove('hidden');
          const errorMsgSpan = loginError.querySelector('span');
          if (errorMsgSpan) errorMsgSpan.textContent = 'Gagal menghubungi server database: ' + err.message;
        } finally {
          if (btnLoginSubmit) {
            btnLoginSubmit.disabled = false;
            btnLoginSubmit.innerHTML = originalBtnText;
          }
        }
      });
    }

    if (btnLogout) {
      btnLogout.addEventListener('click', () => {
        sessionStorage.removeItem('margajaya_admin_logged_in');
        sessionStorage.removeItem('margajaya_admin_token');
        showLogin();
      });
    }

    // Initialize Dashboard Data
    function initDashboard() {
      if (penulisInput && !penulisInput.value) penulisInput.value = 'Humas MA Margajaya';
      updateWordCount();
      loadNewsList();
    }

    // =========================================================================
    // NEWS ARCHIVES CONTROLLER (Fetch, Search, Render, Preview, Delete)
    // =========================================================================
    function loadNewsList() {
      const apiUrl = getApiUrl();
      newsListSkeleton.classList.remove('hidden');
      newsListContainer.classList.add('hidden');
      newsListEmpty.classList.add('hidden');
      if (iconRefreshNews) iconRefreshNews.classList.add('animate-spin');

      if (!apiUrl) {
        newsListSkeleton.classList.add('hidden');
        newsListEmpty.classList.remove('hidden');
        if (iconRefreshNews) iconRefreshNews.classList.remove('animate-spin');
        return;
      }

      fetch(apiUrl)
        .then(r => r.json())
        .then(res => {
          newsListSkeleton.classList.add('hidden');
          if (res.status === 'success' && Array.isArray(res.data) && res.data.length > 0) {
            allNewsItems = res.data.sort((a, b) => {
              const timeA = a.tanggal ? new Date(a.tanggal).getTime() : 0;
              const timeB = b.tanggal ? new Date(b.tanggal).getTime() : 0;
              if (timeB !== timeA) return timeB - timeA;
              const idA = parseInt((a.id || '').replace('news_', '')) || 0;
              const idB = parseInt((b.id || '').replace('news_', '')) || 0;
              return idB - idA;
            });

            // Update Archive Badge Counters
            const totalCount = allNewsItems.length;
            if (badgeArchiveCount) badgeArchiveCount.textContent = String(totalCount);
            if (badgeArchiveCountMobile) badgeArchiveCountMobile.textContent = String(totalCount);

            renderNewsList(allNewsItems);
          } else {
            newsListEmpty.classList.remove('hidden');
            if (badgeArchiveCount) badgeArchiveCount.textContent = '0';
            if (badgeArchiveCountMobile) badgeArchiveCountMobile.textContent = '0';
          }
        })
        .catch(err => {
          console.warn("Gagal memuat berita:", err);
          newsListSkeleton.classList.add('hidden');
          newsListEmpty.classList.remove('hidden');
        })
        .finally(() => {
          if (iconRefreshNews) {
            setTimeout(() => iconRefreshNews.classList.remove('animate-spin'), 600);
          }
        });
    }

    function renderNewsList(items) {
      newsListContainer.innerHTML = '';

      if (items.length === 0) {
        newsListContainer.classList.add('hidden');
        newsListEmpty.classList.remove('hidden');
        return;
      }

      newsListEmpty.classList.add('hidden');
      newsListContainer.classList.remove('hidden');

      items.forEach((item, idx) => {
        const isFirst = idx === 0;
        const card = document.createElement('div');
        card.className = 'ios-glass-card rounded-2xl p-4 sm:p-5 border border-white/10 hover:border-emerald-500/40 transition-all flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 group';

        const photoUrl = formatDriveImageUrl(item.url_foto);
        const imgBlock = photoUrl
          ? `<img src="${photoUrl}" alt="${item.judul}" referrerpolicy="no-referrer" class="w-12 h-12 sm:w-14 sm:h-14 rounded-xl object-cover border border-white/10 shrink-0 bg-slate-900" />`
          : `<div class="w-12 h-12 sm:w-14 sm:h-14 rounded-xl bg-emerald-950/80 border border-emerald-500/30 flex items-center justify-center text-gold font-bold font-serif text-xs shrink-0">MA</div>`;

        card.innerHTML = `
          <div class="flex items-center gap-3.5 min-w-0 flex-1">
            ${imgBlock}
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2 mb-1">
                ${isFirst ? '<span class="px-2 py-0.5 rounded-md bg-gold/15 border border-gold/30 text-[9px] font-bold text-gold uppercase tracking-wider">Headline</span>' : ''}
                <span class="text-[11px] text-slate-400 font-medium">${formatDate(item.tanggal)}</span>
                <span class="text-slate-500">&bull;</span>
                <span class="text-[11px] text-slate-400 truncate">${item.penulis || 'Humas'}</span>
              </div>
              <h3 class="text-sm sm:text-base font-serif font-bold text-white group-hover:text-emerald-300 transition-colors truncate">
                ${item.judul || '(Tanpa Judul)'}
              </h3>
            </div>
          </div>

          <div class="flex items-center gap-2 shrink-0 self-end sm:self-center">
            <button 
              type="button" 
              data-id="${item.id || ''}" 
              class="btn-preview-item inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-semibold border border-white/15 transition-all"
            >
              <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
              </svg>
              <span>Pratinjau</span>
            </button>
            
            <button 
              type="button" 
              data-id="${item.id || ''}" 
              data-title="${(item.judul || '').replace(/"/g, '&quot;')}" 
              class="btn-delete-item inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-rose-500/20 hover:bg-rose-500/30 text-rose-200 text-xs font-semibold border border-rose-500/30 transition-all"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
              <span>Hapus</span>
            </button>
          </div>
        `;

        newsListContainer.appendChild(card);
      });

      // Bind Preview Buttons
      newsListContainer.querySelectorAll('.btn-preview-item').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          const item = allNewsItems.find(x => x.id === id);
          if (item) openPreview(item);
        });
      });

      // Bind Delete Buttons
      newsListContainer.querySelectorAll('.btn-delete-item').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          const title = btn.getAttribute('data-title');
          openDeleteModal(id, title);
        });
      });
    }

    // Instant Search Filter for News
    if (inputSearchNews) {
      inputSearchNews.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        if (!query) {
          renderNewsList(allNewsItems);
          return;
        }
        const filtered = allNewsItems.filter(item => {
          const titleMatch = (item.judul || '').toLowerCase().includes(query);
          const authorMatch = (item.penulis || '').toLowerCase().includes(query);
          const contentMatch = (item.isi || '').toLowerCase().includes(query);
          return titleMatch || authorMatch || contentMatch;
        });
        renderNewsList(filtered);
      });
    }

    if (btnRefreshList) btnRefreshList.addEventListener('click', loadNewsList);

    // =========================================================================
    // PREVIEW MODAL LOGIC
    // =========================================================================
    function openPreview(item) {
      if (!item) return;
      pvTitle.textContent = item.judul || '';
      pvDate.textContent = formatDate(item.tanggal);
      pvPenulis.textContent = item.penulis || 'Humas MA Margajaya';
      // Render HTML if content looks like HTML, otherwise plain text
      const isiContent = item.isi || '';
      if (isiContent.trim().startsWith('<')) {
        pvBody.innerHTML = isiContent;
      } else {
        // Legacy plain text: convert newlines to <br> for display
        pvBody.innerHTML = isiContent.replace(/\n/g, '<br>');
      }

      const photoUrl = formatDriveImageUrl(item.url_foto);
      if (photoUrl) {
        pvPhoto.src = photoUrl;
        pvPhoto.classList.remove('hidden');
      } else {
        pvPhoto.classList.add('hidden');
      }

      previewModal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closePreview() {
      previewModal.classList.add('hidden');
      document.body.style.overflow = '';
    }

    if (btnClosePreview) btnClosePreview.addEventListener('click', closePreview);

    // =========================================================================
    // DELETE MODAL LOGIC
    // =========================================================================
    function openDeleteModal(id, title) {
      pendingDeleteId = id;
      if (deleteConfirmTitle) deleteConfirmTitle.textContent = `"${title}"`;
      deleteModal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeDeleteModal() {
      deleteModal.classList.add('hidden');
      document.body.style.overflow = '';
      pendingDeleteId = null;
    }

    if (btnCancelDelete) btnCancelDelete.addEventListener('click', closeDeleteModal);

    function showDeleteLoading(show) {
      if (show) {
        deleteNormalState?.classList.add('hidden');
        deleteLoadingState?.classList.remove('hidden');
        if (btnCancelDelete) btnCancelDelete.disabled = true;
      } else {
        deleteLoadingState?.classList.add('hidden');
        deleteNormalState?.classList.remove('hidden');
        if (btnCancelDelete) btnCancelDelete.disabled = false;
      }
    }

    if (btnConfirmDelete) {
      btnConfirmDelete.addEventListener('click', async () => {
        if (!pendingDeleteId) return;
        const apiUrl = getApiUrl();
        if (!apiUrl) {
          showAlert('error', 'URL database Google Apps Script belum disetel.');
          closeDeleteModal();
          return;
        }

        showDeleteLoading(true);

        try {
          const token = sessionStorage.getItem('margajaya_admin_token') || '';
          const response = await fetch(apiUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify({ action: 'delete', id: pendingDeleteId, token: token })
          });

          const result = await response.json();
          if (result.status === 'success') {
            await new Promise(r => setTimeout(r, 400));
            triggerVercelDeploy(false);
            showAlert('success', `
              <div class="flex items-start sm:items-center gap-3.5">
                <div class="w-9 h-9 rounded-xl bg-emerald-500/20 text-emerald-300 flex items-center justify-center shrink-0 border border-emerald-500/30">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                  </svg>
                </div>
                <div class="space-y-0.5">
                  <div class="font-serif font-bold text-sm sm:text-base text-white tracking-wide">Warta Berhasil Dihapus dari Arsip</div>
                  <p class="text-xs text-emerald-200/90 leading-relaxed font-normal">Data artikel telah dihapus dari pangkalan data. Pembaruan laman publik sedang berlangsung.</p>
                </div>
              </div>
            `);
            loadNewsList();
          } else {
            if (result.message && result.message.includes('Token')) {
              showAlert('error', 'Sesi login telah kedaluwarsa. Silakan login kembali.');
              setTimeout(() => { if (btnLogout) btnLogout.click(); }, 1800);
            } else {
              showAlert('error', 'Gagal menghapus warta: ' + (result.message || 'Terjadi kendala pada server.'));
            }
          }
        } catch (err) {
          showAlert('error', 'Gagal terhubung ke API database: ' + err.message);
        } finally {
          showDeleteLoading(false);
          closeDeleteModal();
        }
      });
    }

    // =========================================================================
    // COVER IMAGE UPLOAD HANDLER
    // =========================================================================
    if (fotoInput) {
      fotoInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;

        if (file.size > 10 * 1024 * 1024) {
          showAlert('error', 'Ukuran foto maksimal adalah 10 MB.');
          fotoInput.value = '';
          return;
        }

        currentImageName = file.name;
        currentImageType = file.type;

        const reader = new FileReader();
        reader.onload = (ev) => {
          currentBase64Image = ev.target.result;
          imgPreview.src = currentBase64Image;
          previewContainer.classList.remove('hidden');
          if (dropzoneArea) dropzoneArea.classList.add('hidden');
        };
        reader.readAsDataURL(file);
      });
    }

    if (btnRemovePhoto) {
      btnRemovePhoto.addEventListener('click', () => {
        fotoInput.value = '';
        currentBase64Image = null;
        currentImageName = "";
        currentImageType = "";
        previewContainer.classList.add('hidden');
        if (dropzoneArea) dropzoneArea.classList.remove('hidden');
        imgPreview.src = '';
      });
    }

    // =========================================================================
    // NEWS FORM SUBMISSION (Publish Article)
    // =========================================================================
    if (formNews) {
      formNews.addEventListener('submit', async (e) => {
        e.preventDefault();
        const apiUrl = getApiUrl();
        if (!apiUrl) {
          showAlert('error', 'URL Google Apps Script tidak terkonfigurasi pada environment.');
          return;
        }

        setLoading(true);
        hideAlert();

        const token = sessionStorage.getItem('margajaya_admin_token') || '';
        // Sync rich-text HTML before reading from hidden textarea
        syncHiddenTextarea();
        const payload = {
          token: token,
          judul: judulInput.value.trim(),
          tanggal: tanggalHiddenInput.value.trim(),
          penulis: penulisInput.value.trim(),
          isi: isiHidden.value,   // HTML content
          image_base64: currentBase64Image ? currentBase64Image.split(',')[1] : null,
          image_name: currentImageName,
          image_type: currentImageType
        };

        try {
          const response = await fetch(apiUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify(payload)
          });

          const result = await response.json();

          if (result.status === 'success') {
            triggerVercelDeploy(false);

            showAlert('success', `
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="flex items-start sm:items-center gap-3.5">
                  <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-300 flex items-center justify-center shrink-0 border border-emerald-500/30">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </div>
                  <div class="space-y-0.5">
                    <div class="font-serif font-bold text-base text-white tracking-wide">Warta Berhasil Diterbitkan</div>
                    <p class="text-xs text-emerald-200/90 leading-relaxed font-normal">Artikel telah tersimpan di pangkalan data resmi madrasah. Pembaruan laman publik sedang diproses (~45 detik).</p>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  <a href="/berita" target="_blank" class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-gold hover:bg-gold-soft text-slate-950 font-bold text-xs uppercase tracking-wider transition-all shadow-md shrink-0">
                    <span>Lihat di Halaman Berita &rarr;</span>
                  </a>
                </div>
              </div>
            `);

            formNews.reset();
            if (isiEditor) isiEditor.innerHTML = ''; // Clear rich-text editor
            if (isiHidden) isiHidden.value = '';
            updateSelectedDate(new Date());
            if (penulisInput) penulisInput.value = 'Humas MA Margajaya';
            if (btnRemovePhoto) btnRemovePhoto.click();
            updateWordCount();
            setTimeout(loadNewsList, 1500);
          } else {
            if (result.message && result.message.includes('Token')) {
              showAlert('error', 'Sesi login telah kedaluwarsa. Silakan login kembali.');
              setTimeout(() => { if (btnLogout) btnLogout.click(); }, 1800);
            } else {
              showAlert('error', 'Gagal mempublikasikan warta: ' + (result.message || 'Terjadi kesalahan sistem.'));
            }
          }
        } catch (err) {
          showAlert('error', 'Gagal menghubungi server database: ' + err.message);
        } finally {
          setLoading(false);
        }
      });
    }

    // Keyboard Shortcuts (Esc to close open popups)
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (!previewModal.classList.contains('hidden')) closePreview();
        if (!deleteModal.classList.contains('hidden')) closeDeleteModal();
        if (calPopover && !calPopover.classList.contains('hidden')) calPopover.classList.add('hidden');
      }
    });

  })();
</script>

