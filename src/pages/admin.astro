                        data-command="formatBlock"
                        data-value="H2"
                      >
                        <span class="text-[10px] font-black">H2</span>
                      </button>

                      <!-- Blockquote -->
                      <button 
                        type="button" 
                        id="btn-fmt-quote" 
                        class="toolbar-btn w-8 h-8 rounded-lg bg-white/5 hover:bg-white/15 text-slate-300 hover:text-white flex items-center justify-center transition-all active:scale-90"
                        title="Kutipan Pernyataan"
                        data-command="formatBlock"
                        data-value="BLOCKQUOTE"
                      >
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M3 10h4v4H3zm0-6h4v4H3zm6 6h4v4H9zm0-6h4v4H9z" opacity=".5"/>
                          <path d="M4.5 13.5L3 10h4l-2.5 3.5zm6 0L9 10h4l-2.5 3.5z"/>
                        </svg>
                      </button>

                      <!-- Bullet List -->
                      <button 
                        type="button" 
                        id="btn-fmt-ul" 
                        class="toolbar-btn w-8 h-8 rounded-lg bg-white/5 hover:bg-white/15 text-slate-300 hover:text-white flex items-center justify-center transition-all active:scale-90"
                        title="Daftar Poin"
                        data-command="insertUnorderedList"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"></path>
                        </svg>
                      </button>

                      <!-- Numbered List -->
                      <button 
                        type="button" 
                        id="btn-fmt-ol" 
                        class="toolbar-btn w-8 h-8 rounded-lg bg-white/5 hover:bg-white/15 text-slate-300 hover:text-white flex items-center justify-center transition-all active:scale-90"
                        title="Daftar Nomor"
                        data-command="insertOrderedList"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h1v4H4zm0 6h1v4H4zM3 4h2M3 10h2M3 16h2M8 6h13M8 12h13M8 18h13"></path>
                        </svg>
                      </button>

                      <div class="w-[1px] h-5 bg-white/15 mx-1"></div>

                      <!-- Align Left -->
                      <button 
                        type="button"
                        class="toolbar-btn w-8 h-8 rounded-lg bg-white/5 hover:bg-white/15 text-slate-300 hover:text-white flex items-center justify-center transition-all active:scale-90"
                        title="Rata Kiri"
                        data-command="justifyLeft"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M3 12h12M3 18h15"></path>
                        </svg>
                      </button>

                      <!-- Align Center -->
                      <button 
                        type="button"
                        class="toolbar-btn w-8 h-8 rounded-lg bg-white/5 hover:bg-white/15 text-slate-300 hover:text-white flex items-center justify-center transition-all active:scale-90"
                        title="Rata Tengah"
                        data-command="justifyCenter"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M6 12h12M4 18h16"></path>
                        </svg>
                      </button>

                    </div>

                    <!-- Right: Clear Formatting -->
                    <div class="flex items-center gap-1">
                      <button 
                        type="button" 
                        id="btn-fmt-clear" 
                        class="toolbar-btn px-2.5 py-1 rounded-lg bg-white/5 hover:bg-rose-500/15 text-slate-400 hover:text-rose-300 text-[11px] font-medium transition-all flex items-center gap-1.5 active:scale-95"
                        title="Hapus Semua Format"
                      >
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                        <span>Bersihkan</span>
                      </button>
                    </div>

                  </div>

                  <!-- WYSIWYG Contenteditable Area -->
                  <div
                    id="isi"
                    contenteditable="true"
                    data-placeholder="Tuliskan narasi warta secara lengkap. Gunakan toolbar di atas untuk memformat — klik Bold untuk tebal, Italic untuk miring, H2 untuk judul bagian, dan sebagainya..."
                    class="wysiwyg-editor ios-glass-input w-full min-h-[320px] px-4 sm:px-5 py-4 rounded-b-2xl rounded-t-none text-sm font-normal leading-[2] text-slate-100 border-t-0 focus:outline-none focus:border-gold/60 transition-all font-sans overflow-y-auto"
                    style="resize:vertical;"
                  ></div>
                  <!-- Hidden textarea used for form submit serialization -->
                  <textarea id="isi-hidden" name="isi" class="hidden" required></textarea>
                </div>

              </div>

              <!-- =========================================================
                   KOLOM KANAN (4-5 Kolom): Metadata Sidebar (Cover, Tanggal, Penulis)
                   ========================================================= -->
              <div class="lg:col-span-4 space-y-6">
                
                <!-- 1. Tanggal Kegiatan (Custom Calendar Popover) -->
                <div class="p-5 rounded-2xl bg-black/30 border border-white/10 space-y-3">
                  <label class="block text-xs font-bold uppercase tracking-wider text-slate-200">
                    Tanggal Kegiatan <span class="text-rose-400">*</span>
                  </label>
                  
                  <input type="hidden" id="tanggal" name="tanggal" required value="" />

                  <!-- Custom Interactive Trigger Button -->
                  <div class="relative">
                    <button 
                      type="button" 
                      id="btn-custom-date" 
                      class="ios-glass-input w-full px-4 py-3 rounded-xl text-xs font-medium flex items-center justify-between text-left hover:border-gold/50 transition-colors group"
                    >
                      <span id="date-display-text" class="text-white font-semibold truncate">
                        Memuat tanggal...
                      </span>
                      <div class="w-7 h-7 rounded-lg bg-emerald-500/15 text-gold flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                      </div>
                    </button>

                    <!-- Custom Emerald & Gold Theme Calendar Popup Popover -->
                    <div 
                      id="custom-calendar-popover" 
                      class="hidden absolute top-full left-0 mt-2 z-50 w-72 sm:w-80 p-4 rounded-2xl ios-glass-panel border border-gold/30 bg-[#062417]/95 shadow-2xl backdrop-blur-2xl"
                    >
                      <div class="flex items-center justify-between pb-2 mb-2 border-b border-white/10">
                        <button 
                          type="button" 
                          id="cal-prev-month" 
                          class="w-7 h-7 rounded-lg bg-white/10 hover:bg-emerald-500/20 text-white flex items-center justify-center transition-colors"
                        >
                          &lsaquo;
                        </button>
                        <div id="cal-month-year-title" class="font-serif font-bold text-xs text-gold tracking-wide">
                          September 2026
                        </div>
                        <button 
                          type="button" 
                          id="cal-next-month" 
                          class="w-7 h-7 rounded-lg bg-white/10 hover:bg-emerald-500/20 text-white flex items-center justify-center transition-colors"
                        >
                          &rsaquo;
                        </button>
                      </div>

                      <div class="grid grid-cols-7 gap-1 text-center text-[9px] font-bold uppercase text-slate-400 mb-2">
                        <span>Ahd</span>
                        <span>Sen</span>
                        <span>Sel</span>
                        <span>Rab</span>
                        <span>Kam</span>
                        <span>Jum</span>
                        <span>Sab</span>
                      </div>

                      <div id="cal-days-grid" class="grid grid-cols-7 gap-1"></div>

                      <div class="mt-3 pt-2 border-t border-white/10 flex items-center justify-between">
                        <button 
                          type="button" 
                          id="cal-btn-today" 
                          class="text-[10px] font-bold uppercase tracking-wider text-emerald-300 hover:text-white transition-colors"
                        >
                          Hari Ini
                        </button>
                        <button 
                          type="button" 
                          id="cal-btn-close" 
                          class="text-[10px] font-semibold text-slate-400 hover:text-white transition-colors"
                        >
                          Tutup
                        </button>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- 2. Penulis & Unit Peliput -->
                <div class="p-5 rounded-2xl bg-black/30 border border-white/10 space-y-3">
                  <div class="flex items-center justify-between">
                    <label for="penulis" class="block text-xs font-bold uppercase tracking-wider text-slate-200">
                      Penulis / Unit <span class="text-rose-400">*</span>
                    </label>
                    <span class="text-[10px] text-slate-400">Atribusi Warta</span>
                  </div>

                  <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                      <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                      </svg>
                    </div>
                    <input 
                      type="text" 
                      id="penulis" 
                      name="penulis" 
                      required 
                      placeholder="Humas MA Margajaya"
                      class="ios-glass-input w-full pl-10 pr-4 py-3 rounded-xl text-xs font-medium placeholder:text-slate-500"
                    />
                  </div>

                  <!-- Quick Author Preset Chips -->
                  <div class="flex flex-wrap gap-1.5 pt-1">
                    <button 
                      type="button" 
                      class="btn-author-preset px-2.5 py-1 rounded-lg bg-white/5 hover:bg-emerald-500/20 text-slate-300 hover:text-emerald-200 text-[10px] font-medium border border-white/10 transition-colors"
                      data-value="Humas MA Margajaya"
                    >
                      Humas MA
                    </button>
                    <button 
                      type="button" 
                      class="btn-author-preset px-2.5 py-1 rounded-lg bg-white/5 hover:bg-emerald-500/20 text-slate-300 hover:text-emerald-200 text-[10px] font-medium border border-white/10 transition-colors"
                      data-value="Tim Jurnalistik Santri"
                    >
                      Jurnalistik
                    </button>
                    <button 
                      type="button" 
                      class="btn-author-preset px-2.5 py-1 rounded-lg bg-white/5 hover:bg-emerald-500/20 text-slate-300 hover:text-emerald-200 text-[10px] font-medium border border-white/10 transition-colors"
                      data-value="Pengurus OSIS MA"
                    >
                      OSIS
                    </button>
                  </div>
                </div>

                <!-- 3. Foto Dokumentasi Utama (Cover Image Dropzone - Matching Reference Image) -->
                <div class="p-5 rounded-2xl bg-black/30 border border-white/10 space-y-3">
                  <div class="flex items-center justify-between">
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-200">
                      Foto Sampul (Cover Image)
                    </label>
                    <span class="text-[10px] text-slate-400">Opsional</span>
                  </div>

                  <!-- Dropzone Area -->
                  <label 
                    for="foto" 
                    id="dropzone-area"
                    class="flex flex-col items-center justify-center gap-2.5 p-6 rounded-xl border-2 border-dashed border-white/20 hover:border-emerald-400/60 bg-white/[0.02] hover:bg-emerald-950/20 transition-all cursor-pointer group text-center"
                  >
                    <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center group-hover:scale-110 transition-transform">
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                      </svg>
                    </div>
                    <div class="space-y-0.5">
                      <div class="text-xs font-semibold text-white group-hover:text-emerald-300 transition-colors">
                        Klik atau Tarik Foto ke Sini
                      </div>
                      <p class="text-[10px] text-slate-400">
                        JPG, PNG, WEBP &bull; Maks 10 MB
                      </p>
                    </div>
                    <input type="file" id="foto" name="foto" accept="image/*" class="hidden" />
                  </label>

                  <!-- Image Live Preview Container -->
                  <div id="preview-container" class="hidden space-y-2.5">
                    <div class="flex items-center justify-between">
                      <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-300 flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span>Foto Terpilih</span>
                      </span>
                      <button 
                        type="button" 
                        id="btn-remove-photo" 
                        class="text-[10px] text-rose-400 hover:text-rose-300 font-bold uppercase tracking-wider flex items-center gap-1 transition-colors"
                      >
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                        </svg>
                        <span>Hapus</span>
                      </button>
                    </div>
                    <div class="overflow-hidden rounded-xl border border-white/15 bg-black/40 shadow-inner">
                      <img 
                        id="img-preview" 
                        src="" 
                        alt="Pratinjau Foto" 
                        class="max-h-48 w-full object-cover" 
                      />
                    </div>
                  </div>
                </div>

                <!-- 4. Target Sinkronisasi Informasi -->
                <div class="p-4 rounded-2xl bg-emerald-950/40 border border-emerald-500/20 text-[11px] text-slate-300 space-y-1.5">
                  <div class="font-bold text-emerald-300 flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span>Penyimpanan Aman Terpadu</span>
                  </div>
                  <p class="text-slate-400 leading-relaxed">
                    Setiap warta yang diterbitkan langsung tersinkronisasi ke Google Sheets dan foto disimpan ke Google Drive madrasah.
                  </p>
                </div>

              </div>

            </div>

          </div>

        </form>

      </section>


      <!-- =========================================================================
           VIEW TAB 2: KELOLA ARSIP WARTA & PUBLIKASI AKTIF
           ========================================================================= -->
      <section id="section-archives" class="hidden space-y-6">
        
        <!-- Header Strip & Search Bar -->
        <div class="ios-glass-card rounded-3xl p-6 border border-white/15 shadow-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="w-2 h-2 rounded-full bg-gold"></span>
              <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-gold">Basis Data</span>
            </div>
            <h2 class="font-serif text-xl sm:text-2xl font-bold text-white tracking-tight">
              Daftar Arsip Warta Madrasah
            </h2>
            <p class="text-xs text-slate-400 mt-0.5">
              Kelola, pratinjau, atau hapus publikasi artikel yang telah terbit.
            </p>
          </div>

          <!-- Controls: Search Input + Refresh Button -->
          <div class="flex items-center gap-2.5">
            <div class="relative w-full sm:w-64">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
              </div>
              <input 
                type="text" 
                id="input-search-news" 
                placeholder="Cari judul atau penulis..."
                class="ios-glass-input w-full pl-9 pr-3 py-2 rounded-xl text-xs placeholder:text-slate-500 font-medium"
              />
            </div>

            <button 
              id="btn-refresh-list" 
              type="button" 
              class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white/10 hover:bg-white/15 text-white text-xs font-semibold border border-white/15 transition-all shadow-sm shrink-0"
              title="Segarkan daftar data dari server"
            >
              <svg id="icon-refresh-news" class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
              </svg>
              <span class="hidden sm:inline">Segarkan</span>
            </button>
          </div>
        </div>

        <!-- Skeleton Loading State -->
        <div id="news-list-skeleton" class="space-y-3">
          <div class="ios-glass-card rounded-2xl p-5 h-20 skeleton-shimmer bg-white/5 border border-white/10"></div>
          <div class="ios-glass-card rounded-2xl p-5 h-20 skeleton-shimmer bg-white/5 border border-white/10"></div>
          <div class="ios-glass-card rounded-2xl p-5 h-20 skeleton-shimmer bg-white/5 border border-white/10"></div>
        </div>

        <!-- Dynamic News Item List -->
        <div id="news-list-container" class="hidden space-y-3">
          <!-- Rendered via JavaScript -->
        </div>

        <!-- Empty State -->
        <div id="news-list-empty" class="hidden py-16 text-center ios-glass-card rounded-3xl border border-white/10">
          <div class="w-14 h-14 rounded-2xl bg-white/5 text-slate-400 flex items-center justify-center mx-auto mb-3 border border-white/10">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
            </svg>
          </div>
          <h3 class="font-serif text-base font-bold text-white mb-1">Belum Ada Warta Ditemukan</h3>
          <p class="text-xs text-slate-400 max-w-sm mx-auto mb-4">
            Belum ada publikasi yang cocok atau pangkalan data masih kosong. Silakan gunakan tab "Tulis Warta" untuk mulai menerbitkan artikel warta baru.
          </p>
          <button 
            type="button" 
            id="btn-goto-editor" 
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-gold hover:bg-gold-soft text-slate-950 font-bold text-xs uppercase tracking-wider transition-all shadow-md"
          >
            <span>Tulis Warta Baru &rarr;</span>
          </button>
        </div>

      </section>

    </main>
  </div>


  <!-- =========================================================================
       MODAL: FULLSCREEN ARTICLE PREVIEW (macOS Document Reader)
       ========================================================================= -->
