---
import AdminLayout from '../layouts/AdminLayout.astro';
const newsApiUrl = import.meta.env.PUBLIC_NEWS_API_URL || 'https://script.google.com/macros/s/AKfycbwboX_4labGuJ9412coI1JrXzpxb11B3xJOlmloGnEsTsRui-yIdssRFl8i2CGga1IF/exec';
const vercelDeployHook = import.meta.env.PUBLIC_VERCEL_DEPLOY_HOOK || 'https://api.vercel.com/v1/integrations/deploy/prj_umwjoNnXfJTjqzpiHS7qcLu3kVpH/rUwycrCtVI';
---

<AdminLayout title="Admin Portal — MA Margajaya Sukadana">

  <!-- =========================================================================
       1. LOGIN GATE SCREEN (2-COLUMN SPLIT SCREEN: BRANDING LEFT + IOS LOGIN RIGHT)
       ========================================================================= -->
  <div id="admin-login-screen" class="min-h-screen flex items-center justify-center p-4 sm:p-6 lg:p-12 z-10">
    <div class="w-full max-w-6xl grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center">
      
      <!-- SISI KIRI: Logo Besar Tanpa Border + Tagline & Identitas Madrasah -->
      <div class="lg:col-span-7 space-y-6 sm:space-y-8 text-left py-4 lg:py-8">
        
        <!-- Clean Logo -->
        <div class="flex items-center gap-6">
          <img 
            src="/logo/logo-ma-margajaya.png" 
            alt="Logo MA Margajaya" 
            class="w-24 h-24 sm:w-32 sm:h-32 object-contain drop-shadow-[0_20px_40px_rgba(0,0,0,0.5)] transform hover:scale-105 transition-transform duration-500"
          />
          <div class="space-y-1">
            <span class="text-xs font-bold uppercase tracking-[0.25em] text-gold block drop-shadow">
              Kementerian Agama RI
            </span>
            <div class="text-sm font-semibold text-white/90">
              Yayasan MPP PUI Ciamis
            </div>
            <div class="text-xs text-emerald-300/80 font-medium">
              Kompleks Ponpes Darul Muawanah
            </div>
          </div>
        </div>

        <!-- Main Heading & Motto -->
        <div class="space-y-3">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif font-bold text-white tracking-tight leading-[1.08] drop-shadow-md">
            Portal Administrasi <br />
            <em class="italic text-gold not-italic">MA Margajaya.</em>
          </h1>
          <p class="text-base sm:text-lg text-slate-200/90 leading-relaxed font-normal max-w-xl">
            Pusat kendali terpadu untuk publikasi warta resmi madrasah, dokumentasi prestasi santri, dan pengelolaan arsip kegiatan civitas akademika.
          </p>
        </div>

      </div>

      <!-- SISI KANAN: Frosted Glass Login Window Card -->
      <div class="lg:col-span-5 w-full">
        <div class="group relative rounded-3xl p-8 sm:p-10 border border-white/15 hover:border-emerald-400/40 bg-[#06281D]/60 hover:bg-[#06281D]/80 backdrop-blur-3xl shadow-[0_20px_50px_-15px_rgba(0,0,0,0.7)] hover:shadow-[0_25px_60px_-10px_rgba(5,150,105,0.35),0_0_40px_rgba(232,185,35,0.18)] transition-all duration-500 overflow-hidden">
          
          <!-- Soft Interactive Ambient Glow Radial Flare -->
          <div class="pointer-events-none absolute -top-20 -right-20 w-56 h-56 bg-gradient-to-br from-gold/25 via-emerald-500/20 to-transparent rounded-full blur-3xl group-hover:scale-150 group-hover:opacity-100 opacity-40 transition-all duration-700"></div>
          <div class="pointer-events-none absolute -bottom-20 -left-20 w-56 h-56 bg-gradient-to-tr from-emerald-600/20 via-gold/10 to-transparent rounded-full blur-3xl group-hover:scale-125 group-hover:opacity-80 opacity-30 transition-all duration-700"></div>

          <div class="relative z-10 mb-6 space-y-1">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
              <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-emerald-300">Autentikasi Pengelola</span>
            </div>
            <h2 class="text-2xl font-serif font-bold text-white tracking-tight">
              Masuk Dashboard
            </h2>
            <p class="text-xs text-slate-300/80 leading-relaxed">
              Masukkan kunci sandi administrator untuk mengakses sistem pengelolaan warta.
            </p>
          </div>

          <form id="form-login" class="space-y-5">
            <div>
              <label for="admin-password" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
                Kata Sandi Administrator
              </label>
              <div class="relative">
                <input 
                  type="password" 
                  id="admin-password" 
                  required 
                  autocomplete="current-password"
                  placeholder="Masukkan kata sandi..."
                  class="ios-glass-input w-full px-4 py-3.5 pr-11 rounded-xl text-sm placeholder:text-slate-500 font-medium bg-white/10"
                />
                <button 
                  type="button" 
                  id="btn-toggle-pw" 
                  tabindex="-1"
                  aria-label="Tampilkan Password"
                  class="absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white transition-colors"
                >
                  <svg id="eye-open" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                  </svg>
                  <svg id="eye-closed" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path>
                  </svg>
                </button>
              </div>
            </div>

            <div id="login-error" class="hidden text-xs text-rose-300 bg-rose-950/80 p-3.5 rounded-xl border border-rose-500/40 flex items-center gap-2">
              <svg class="w-4 h-4 text-rose-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
              </svg>
              <span>Kata sandi tidak sesuai. Silakan periksa kembali.</span>
            </div>

            <button 
              type="submit" 
              class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-emerald-600 via-emerald-500 to-emerald-600 hover:from-emerald-500 hover:to-emerald-400 text-white text-xs font-bold uppercase tracking-widest transition-all shadow-[0_10px_25px_-5px_rgba(5,150,105,0.5)] hover:shadow-[0_15px_35px_-5px_rgba(5,150,105,0.7)] hover:scale-[1.01] active:scale-[0.99] flex items-center justify-center gap-2"
            >
              <span>Masuk ke Dashboard</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </button>
          </form>

          <div class="mt-6 pt-5 border-t border-white/10 text-center">
            <p class="text-[11px] text-slate-400 flex items-center justify-center gap-1.5 font-medium">
              <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
              </svg>
              <span>Akses Khusus Civitas MA Margajaya Sukadana</span>
            </p>
          </div>

        </div>
      </div>

    </div>
  </div>


  <!-- =========================================================================
       2. MAIN ADMIN DASHBOARD (macOS / iOS COMPACT CMS LAYOUT)
       ========================================================================= -->
  <div id="admin-dashboard" class="hidden min-h-screen flex-1 flex flex-col" data-api-url={newsApiUrl} data-deploy-hook={vercelDeployHook}>
    
    <!-- macOS Floating Frosted Navbar Header -->
    <header class="ios-glass-nav sticky top-0 z-40 border-b border-white/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between gap-4">
        
        <!-- Left Brand -->
        <div class="flex items-center gap-3.5">
          <img src="/logo/logo-ma-margajaya.png" alt="Logo" class="w-10 h-10 object-contain drop-shadow" />
          <div>
            <h1 class="font-serif text-base sm:text-lg font-bold text-white tracking-tight leading-tight">
              MA Margajaya
            </h1>
            <p class="text-[11px] text-emerald-300/80 font-medium">
              Portal Warta &amp; CMS Publikasi
            </p>
          </div>
        </div>

        <!-- Center: macOS Sliding Pill Segmented Control -->
        <nav id="tab-nav" class="hidden md:flex items-center relative p-1 rounded-2xl bg-black/40 border border-white/10 backdrop-blur-xl shadow-inner gap-0.5" role="tablist">
          <!-- Animated sliding pill indicator -->
          <div id="tab-indicator" class="absolute top-1 bottom-1 rounded-xl bg-gradient-to-r from-emerald-600 to-emerald-500 shadow-[0_2px_12px_rgba(5,150,105,0.45)] border border-emerald-400/40 transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] pointer-events-none" style="width:0;left:4px;"></div>
          
          <button 
            type="button" 
            id="tab-btn-editor"
            role="tab"
            aria-selected="true"
            class="tab-btn relative z-10 inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold transition-colors duration-200 text-white"
          >
            <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
            <span>Tulis Warta</span>
          </button>
          
          <button 
            type="button" 
            id="tab-btn-archives"
            role="tab"
            aria-selected="false"
            class="tab-btn relative z-10 inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold transition-colors duration-200 text-slate-400"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
            <span>Kelola Arsip</span>
            <span id="badge-archive-count" class="px-1.5 py-0.5 rounded-full text-[10px] font-bold bg-white/10 text-slate-300 min-w-[18px] text-center">0</span>
          </button>
        </nav>

        <!-- Right Clean Actions -->
        <div class="flex items-center gap-2 sm:gap-2.5">
          
          <!-- View Public Website -->
          <a 
            href="/" 
            target="_blank" 
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white/10 hover:bg-white/15 text-white text-xs font-semibold border border-white/15 transition-all shadow-sm"
            title="Lihat Website Utama"
          >
            <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
            </svg>
            <span class="hidden sm:inline">Lihat Web</span>
          </a>

          <!-- Trigger Rebuild / Sync Web to Vercel -->
          <button 
            id="btn-rebuild-web" 
            type="button" 
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-200 text-xs font-semibold border border-emerald-500/30 transition-all shadow-sm"
            title="Sinkronkan pembaruan data terkini ke portal publik madrasah"
          >
            <svg id="icon-rebuild" class="w-3.5 h-3.5 text-emerald-400 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
            <span class="hidden sm:inline">Sinkronkan</span>
          </button>

          <!-- Logout Button -->
          <button 
            id="btn-logout" 
            type="button" 
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-rose-500/20 hover:bg-rose-500/30 text-rose-200 text-xs font-semibold border border-rose-500/30 transition-all shadow-sm"
            title="Keluar dari portal"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
            </svg>
            <span class="hidden sm:inline">Keluar</span>
          </button>

        </div>

      </div>

      <!-- Mobile Segmented Tabs Bar -->
      <div class="md:hidden px-4 pb-3 pt-2 border-t border-white/5">
        <div id="tab-nav-mobile" class="relative flex gap-0.5 p-1 rounded-xl bg-black/40 border border-white/10">
          <div id="tab-indicator-mobile" class="absolute top-1 bottom-1 rounded-lg bg-gradient-to-r from-emerald-600 to-emerald-500 shadow-[0_2px_8px_rgba(5,150,105,0.4)] border border-emerald-400/40 transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] pointer-events-none" style="width:0;left:4px;"></div>
          <button 
            type="button" 
            id="tab-btn-editor-mobile"
            class="flex-1 relative z-10 py-2 rounded-lg text-xs font-bold transition-colors duration-200 text-white flex items-center justify-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
            <span>Tulis Warta</span>
          </button>
          <button 
            type="button" 
            id="tab-btn-archives-mobile"
            class="flex-1 relative z-10 py-2 rounded-lg text-xs font-semibold transition-colors duration-200 text-slate-400 flex items-center justify-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
            <span>Arsip (<span id="badge-archive-count-mobile">0</span>)</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Container Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8 flex-1 w-full">

      <!-- Dynamic Global Alert Message -->
      <div id="form-alert" class="hidden mb-6 p-4 sm:p-5 rounded-2xl text-xs sm:text-sm leading-relaxed font-medium transition-all"></div>

      <!-- =========================================================================
           VIEW TAB 1: 2-COLUMN COMPACT CMS EDITOR (Matching User Reference Image)
           ========================================================================= -->
      <section id="section-editor" class="space-y-6">
        
        <form id="form-news" class="space-y-6">
          
          <!-- Outer Card Container with Sleek macOS Window Frame -->
          <div class="ios-glass-card rounded-3xl border border-white/15 shadow-2xl overflow-hidden">
            
            <!-- Window Header Bar (Clean breadcrumb left, Cancel & Publish right) -->
            <div class="px-6 py-4 border-b border-white/10 bg-black/20 flex flex-wrap items-center justify-between gap-4">
              
              <!-- Left: Document Context -->
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 flex items-center justify-center">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                  </svg>
                </div>
                <div>
                  <div class="flex items-center gap-2">
                    <h2 class="text-sm sm:text-base font-serif font-bold text-white tracking-tight">
                      Editor Artikel Warta
                    </h2>
                    <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 text-[10px] font-bold uppercase tracking-wider">
                      Siap Publikasi
                    </span>
                  </div>
                  <p class="text-[11px] text-slate-400">
                    Format compact 2-kolom terintegrasi pangkalan data madrasah
                  </p>
                </div>
              </div>

              <!-- Right Actions: Cancel / Reset & Publish Button (Matching Image Reference) -->
              <div class="flex items-center gap-2.5">
                <button 
                  type="button" 
                  id="btn-reset-form" 
                  class="px-4 py-2 rounded-xl bg-white/10 hover:bg-white/15 text-slate-200 hover:text-white text-xs font-semibold border border-white/15 transition-all flex items-center gap-1.5 shadow-sm"
                >
                  <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                  </svg>
                  <span>Batal / Reset</span>
                </button>

                <button 
                  type="submit" 
                  id="btn-submit" 
                  class="px-6 py-2 rounded-xl bg-gradient-to-r from-emerald-600 via-emerald-500 to-emerald-600 hover:from-emerald-500 hover:to-emerald-400 text-white text-xs font-bold uppercase tracking-wider transition-all shadow-[0_4px_16px_rgba(5,150,105,0.4)] hover:shadow-[0_6px_22px_rgba(5,150,105,0.6)] hover:scale-[1.02] active:scale-[0.98] flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
                >
                  <span id="btn-spinner" class="hidden w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                  <svg id="btn-icon" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                  </svg>
                  <span id="btn-text">Publikasikan</span>
                </button>
              </div>

            </div>

            <!-- Editor Body: 2-Column Responsive Layout -->
            <div class="p-6 sm:p-8 grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
              
              <!-- =========================================================
                   KOLOM KIRI (7-8 Kolom): Judul & Kanvas Penulisan Narasi
                   ========================================================= -->
              <div class="lg:col-span-8 space-y-6">
                
                <!-- Judul Berita -->
                <div class="space-y-2">
                  <div class="flex items-center justify-between">
                    <label for="judul" class="block text-xs font-bold uppercase tracking-wider text-slate-200">
                      Judul Warta / Prestasi <span class="text-rose-400">*</span>
                    </label>
                    <span class="text-[11px] text-slate-400 font-medium">Beri judul yang menarik &amp; informatif</span>
                  </div>
                  <input 
                    type="text" 
                    id="judul" 
                    name="judul" 
                    required 
                    placeholder="Masukkan judul warta madrasah..."
                    class="ios-glass-input w-full px-4 sm:px-5 py-3.5 rounded-xl text-base sm:text-lg font-serif font-bold placeholder:font-sans placeholder:text-sm placeholder:text-slate-500 focus:border-gold/60 transition-all text-white"
                  />
                </div>

                <!-- Konten Narasi: WYSIWYG Rich Editor -->
                <div class="space-y-2">
                  <div class="flex items-center justify-between">
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-200">
                      Isi Warta &amp; Narasi Lengkap <span class="text-rose-400">*</span>
                    </label>
                    <span id="editor-counter" class="text-[11px] text-emerald-300/80 font-mono font-medium">
                      0 kata &bull; 0 karakter
                    </span>
                  </div>

                  <!-- macOS Rich Formatting Toolbar -->
                  <div class="rounded-t-2xl bg-black/40 border border-white/15 border-b-0 p-2 sm:p-2.5 flex flex-wrap items-center justify-between gap-2 backdrop-blur-md">
                    
                    <!-- Left Toolbar Controls -->
                    <div class="flex items-center flex-wrap gap-1">
                      
                      <!-- Bold -->
                      <button 
                        type="button" 
                        id="btn-fmt-bold" 
                        class="toolbar-btn w-8 h-8 rounded-lg bg-white/5 hover:bg-white/15 text-slate-300 hover:text-white flex items-center justify-center transition-all active:scale-90"
                        title="Tebal (Ctrl+B)"
                        data-command="bold"
                      >
                        <span class="font-black font-serif text-sm leading-none">B</span>
                      </button>

                      <!-- Italic -->
                      <button 
                        type="button" 
                        id="btn-fmt-italic" 
                        class="toolbar-btn w-8 h-8 rounded-lg bg-white/5 hover:bg-white/15 text-slate-300 hover:text-white flex items-center justify-center transition-all active:scale-90"
                        title="Miring (Ctrl+I)"
                        data-command="italic"
                      >
                        <span class="italic font-serif text-sm leading-none font-semibold">I</span>
                      </button>

                      <!-- Underline -->
                      <button 
                        type="button" 
                        id="btn-fmt-underline" 
