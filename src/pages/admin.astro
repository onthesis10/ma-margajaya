                        data-command="strikeThrough"
                      >
                        <span class="line-through font-serif text-sm leading-none">S</span>
                      </button>

                      <div class="w-[1px] h-5 bg-white/15 mx-1"></div>

                      <!-- Heading H2 -->
                      <button 
                        type="button" 
                        id="btn-fmt-h2" 
