# Google Apps Script Web App Endpoint (deploy sebagai web app, akses Anyone)
# Salin dari: Apps Script → Deploy → Manage Deployments → URL
PUBLIC_NEWS_API_URL="https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec"

# Google Calendar ID untuk halaman Akademik (opsional)
# Salin dari: Google Calendar → Settings → Integrate calendar → Calendar ID
PUBLIC_GOOGLE_CALENDAR_ID="your-calendar-id@group.calendar.google.com"

# Google Calendar API Key (opsional, buat di Google Cloud Console → Credentials)
PUBLIC_GOOGLE_CALENDAR_API_KEY="YOUR_GOOGLE_API_KEY"
